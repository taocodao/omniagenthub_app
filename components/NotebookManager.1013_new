                        padding: '8px'
                      }}
                    >
                      ☰
                    </button>
                  </div>
                  
                  <select
                    value={sortBy}
                    onChange={(e) => setSortBy(e.target.value as any)}
                    style={{
                      backgroundColor: 'white',
                      border: '1px solid #ddd',
                      color: '#333',
                      padding: '8px 12px',
                      borderRadius: '8px',
                      fontSize: '14px'
                    }}
                  >
                    <option value="recent">Most recent</option>
                    <option value="title">Title</option>
                    <option value="sources">Sources</option>
                  </select>

                  <button
