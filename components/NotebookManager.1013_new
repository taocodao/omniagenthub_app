    }
  };
  
// ✅ NEW: Check if notebook can be deleted
const onDeleteNotebookWithCheck = (notebookId: string) => {
  const notebook = notebooks.find(n => n.id === notebookId);
  if (!notebook) {
    toast.error('Notebook not found');
    return;
  }

  // Non-empty: show guidance dialog
  if ((notebook.sourceCount ?? 0) > 0) {
    setOpenMenuNotebookId(null);
    setDeleteBlockDialog({ open: true, notebook });
    return;
  }

  // Empty: use existing delete routine
  handleDeleteNotebook(notebookId);
};


const handleDeleteNotebook = async (notebookId: string) => {
  if (!address) {
    toast.error('Please connect your wallet first');
    return;
  }

  const notebook = notebooks.find((n) => n.id === notebookId);
  if (!notebook) {
    toast.error('Notebook not found');
    return;
  }

  // ✅ ENHANCED: Better check with more visible error
  if ((notebook.sourceCount ?? 0) > 0) {
    // Use a more prominent warning
    const message = `⚠️ Cannot delete "${notebook.title}"\n\nThis notebook contains ${notebook.sourceCount} source${notebook.sourceCount !== 1 ? 's' : ''}.\n\nPlease open the notebook and remove all sources before deleting.`;
    
    alert(message); // Browser alert for maximum visibility
    
    toast.error(
      `Cannot delete "${notebook.title}" - it has ${notebook.sourceCount} source${notebook.sourceCount !== 1 ? 's' : ''}`,
      {
        position: 'top-center',
        autoClose: 5000,
        style: {
          background: '#fee',
          color: '#c00',
          fontWeight: 'bold'
        }
      }
    );
    
    setOpenMenuNotebookId(null);
    return;
  }

  // Only ask for confirmation if notebook is empty
  const confirmed = window.confirm(`Delete "${notebook.title}"? This action cannot be undone.`);
  if (!confirmed) {
    setOpenMenuNotebookId(null);
    return;
  }

  try {
    const response = await fetch('/api/notebooks/delete', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        userKey: HashUtil.hashTo(address),
        notebookId,
        userAddress: address,
      }),
    });

    const data = await response.json();

    if (data.success) {
      toast.success('✅ Notebook deleted successfully');
      
      // ✅ Refresh the notebooks list
      await fetchNotebooks();
      
      // ✅ Close the notebook view if we deleted the current one
      if (currentNotebook?.id === notebookId) {
        setCurrentNotebook(null);
        setShowNotebookDetail(false);
        setView('grid');
      }
    } else {
      toast.error(data.message || 'Failed to delete');
    }
  } catch (error) {
    console.error('Delete error:', error);
    toast.error('Failed to delete notebook');
  } finally {
    setOpenMenuNotebookId(null);
  }
};



  // Create new notebook - ✅ FIXED: Now passes userAddress
  const createNotebook = async () => {
    if (!newNotebookTitle.trim()) {
      toast.error('Please enter a notebook title');
      return;
    }

    if (!address) {
      toast.error('Please connect your wallet first');
