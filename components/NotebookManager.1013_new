  // ✅ ADD: Advanced scrape status checking with polling
const checkScrapeStatus = async (jobId: string, sourceId: string, websiteUrl: string): Promise<void> => {
  const statusCheckInterval = 20000; // Every 20 seconds
  let checkCount = 0;
  const maxChecks = 60; // Allow more checks for the multi-stage process

  const statusCheckId = setInterval(async () => {
    try {
      const statusResponse = await fetch(`/api/scrape-status?jobId=${jobId}`, {
        method: "GET",
        headers: {
          "Content-Type": "application/json",
          "accountid": address || '',
        }
      });

      if (statusResponse.ok) {
        const statusData = await statusResponse.json();

        // Map status to user-friendly messages
        let statusMessage = `Scraping of ${websiteUrl} is in progress`;

        if (statusData.status === 'CRAWLING') {
          statusMessage = `Crawling ${websiteUrl} sitemap to discover pages...`;
        } else if (statusData.status === 'CRAWLING_FALLBACK') {
          statusMessage = `Sitemap not found. Crawling ${websiteUrl} directly...`;
        } else if (statusData.status === 'PROCESSING') {
          statusMessage = `Found ${statusData.pageCount || 'multiple'} pages. Creating embeddings...`;
        }

        // Update source status based on scrape status
        if (statusData.status === "SUCCEEDED") {
          clearInterval(statusCheckId);
          
          const pageText = statusData.pageCount ?
            `Processed ${statusData.pageCount} pages from` :
            'Successfully processed';

          setWebsiteScrapeStatus(`${pageText} ${websiteUrl}. Content is now ready to use.`);
          
          // Update source to completed
          updateSourceStatus(sourceId, 'completed', 100);
          
          toast.success('Website scraping completed successfully!', {
            position: "top-right",
            autoClose: 5000,
            style: { zIndex: 9999 }
          });

          setIsWebsiteScrapingInProgress(false);
          setWebsiteScrapeJobId(null);

          // Update notebook embeddings
          if (currentNotebook) {
            await updateNotebookEmbeddings(currentNotebook.id);
          }

        } else if (statusData.status === "FAILED") {
          clearInterval(statusCheckId);
          
          setWebsiteScrapeStatus(`Scraping of ${websiteUrl} failed: ${statusData.error || 'Unknown error'}`);
          updateSourceStatus(sourceId, 'error', 0, statusData.error || 'Scraping failed');
          
          toast.error(`Website scraping failed: ${statusData.error || 'Unknown error'}`, {
            position: "top-right",
            autoClose: 8000,
            style: { zIndex: 9999 }
          });

          setIsWebsiteScrapingInProgress(false);
          setWebsiteScrapeJobId(null);

        } else {
          // Still in progress - update with detailed status
          setWebsiteScrapeStatus(statusMessage);
          updateSourceStatus(sourceId, 'processing', Math.min(50 + checkCount * 2, 90));
        }
      } else {
        console.warn("Status check returned error:", await statusResponse.text());
      }

      checkCount++;
      if (checkCount >= maxChecks) {
        clearInterval(statusCheckId);
        setWebsiteScrapeStatus(`Scraping of ${websiteUrl} is taking longer than expected. Check back later.`);
        updateSourceStatus(sourceId, 'processing', 95); // Keep as processing
        setIsWebsiteScrapingInProgress(false);
      }
    } catch (error) {
      console.error("Error checking scrape status:", error);
    }
  }, statusCheckInterval);
};

  // ✅ ADD: New helper function to call the add source API
const addSourceToNotebook = async (source: NotebookSource) => {
  if (!address || !currentNotebook) {
    throw new Error('Wallet not connected or no notebook selected');
  }

  try {
    const hashedUserKey = HashUtil.hashTo(address);
    const response = await fetch('/api/sources/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        userKey: hashedUserKey,
        notebookId: currentNotebook.id,
        source: source,
        userAddress: address
      })
    });

    const data = await response.json();
    
    if (!data.success) {
      throw new Error(data.message || 'Failed to add source');
    }

    console.log('✅ Source added via API:', data.source.id);
    return data;
  } catch (error) {
    console.error('❌ Error adding source via API:', error);
    throw error;
  }
};


  // Load notebooks on mount and when wallet connects - ✅ FIXED
  useEffect(() => {
