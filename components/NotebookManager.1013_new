            background: 'linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%)',
            color: 'white'
          }}>
            <div style={{ display: 'flex', alignItems: 'center' }}>
              <span style={{ fontSize: '28px', marginRight: '12px' }}>📚</span>
              <h1 style={{ margin: 0, color: 'white', fontSize: '24px', fontWeight: '600' }}>
