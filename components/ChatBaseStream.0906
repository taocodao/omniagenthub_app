    // the updated version to avoid timeout issue while call assistant.ts
    const handleSend = async (message: string) => {
        try {
            setIsLoading(true);
            setInput('');
            setIsRefining(false);

            let currentUser = user;
            let currentPrice = price;

            if (currentUser === null || currentPrice === null) {
                console.log('User or price information not available');
                return;
            }

            if (currentPrice) {
                const freeChatsUsed = await process_payment(String(userAddress), currentPrice, currentUser);
                if (!freeChatsUsed) {
                    const message = 'Insufficient balance. Unable to proceed with the request.';
                    alert(await getLocalizedString(message, language));
                    return;
                }
            }

            if (message && optionShortNames[message]) {
                console.log("click on the button, the message is ", message);
                try {
                    const localizedMessage = await getLocalizedString(message, language);
                    setMessages(prev => [...prev, { role: 'user', content: localizedMessage }]);
                } catch (error) {
                    console.error('Error localizing message:', error);
                    setMessages(prev => [...prev, { role: 'user', content: message, originalContent: message }]);
                }
            } else {
                setMessages(prev => [...prev, { role: 'user', content: message }]);
            }

            const userMessage = optionShortNames[message] ? optionShortNames[message] : message;

            // Start the assistant job
            const startResponse = await fetch('/api/assistant', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ assistantId, threadId: generatedThreadId, userMessage, isPolling: false }),
            });

            if (!startResponse.ok) {
                throw new Error('Failed to start assistant job');
            }

            const { jobId } = await startResponse.json();

            let retryCount = 0;
            const maxRetries = 40;
            const pollInterval = 3000; // 3 seconds between polls

            const pollJob = async () => {
                try {
                    const pollResponse = await fetch('/api/assistant', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ jobId, isPolling: true }),
                    });

                    if (!pollResponse.ok) {
                        if (pollResponse.status === 404) {
                            console.log(`Job not found, retrying... (${retryCount + 1}/${maxRetries})`);
                            retryCount++;
                            if (retryCount < maxRetries) {
                                setTimeout(pollJob, pollInterval);
                            } else {
                                throw new Error('Job not found after maximum retries');
                            }
                            return;
                        }
                        throw new Error('Failed to fetch assistant job response');
                    }

                    const { result } = await pollResponse.json();

                    // Job is done, update the assistant message
                    setMessages(prev => {
                        const newMessages = [...prev];
                        if (newMessages.length > 0 && newMessages[newMessages.length - 1].role === 'assistant') {
                            newMessages[newMessages.length - 1].content = result;
                        } else {
                            newMessages.push({ role: 'assistant', content: result });
                        }
                        return newMessages;
                    });
                    setIsLoading(false);

                } catch (error) {
                    console.error('Polling error:', error);
                    setIsLoading(false);
                }
            };

            // Start polling after a delay
            setTimeout(pollJob, pollInterval);

        } catch (error) {
            console.error('Error:', error);
            setIsLoading(false);
        }
    };






    const handleInputChange = (e: React.ChangeEvent<HTMLTextAreaElement>) => {
        setInput(e.target.value);
        if (inputRef.current) {
            inputRef.current.style.height = 'auto';
            inputRef.current.style.height = `${inputRef.current.scrollHeight}px`;
        }
    };

    const handleButtonClick = async (action: string) => {
        if (optionShortNames[action] === 'Refine') {
            setRenderKey(prevKey => prevKey + 1);
            setIsRefining(true);
            setInput("");
            try {
                const placeholder = await getLocalizedString('Please type in your feedback or leave it blank', language);
                if (inputRef.current)
                    inputRef.current.placeholder = placeholder;
            } catch (error) {
                console.error('Error setting localized placeholder:', error);
                // Fallback to default English text if localization fails
                if (inputRef.current)
                    inputRef.current.placeholder = 'Please type in your feedback or leave it blank';
            }

        } else {

            try {
                //await handleSend(optionShortNames[action]);
                await handleSend(action);
            } finally {
                setIsLoading(false);
            }
        }
    };


    const handleRefineSubmit = async () => {
        await handleSend('Refine ' + input);
    };

    const copyToClipboard = async (content: string) => {
        try {
            // Create a temporary element to render the markdown content
            const tempElement = document.createElement('div');
            tempElement.innerHTML = await renderMarkdownToHTML(content);

            // Copy both HTML and plain text to clipboard
            await navigator.clipboard.write([
                new ClipboardItem({
                    'text/html': new Blob([tempElement.innerHTML], { type: 'text/html' }),
                    'text/plain': new Blob([content], { type: 'text/plain' })
                })
            ]);
            //alert("Copied to clipboard with formatting");
            const message = 'Copied to clipboard with formatting';
            alert(await getLocalizedString(message, language));
        } catch (err) {
            console.error("Failed to copy: ", err);
            // Fallback to copying plain text
            navigator.clipboard.writeText(content);
            //alert("Copied plain text to clipboard");
            const message = 'Copied plain text to clipboard';
            alert(await getLocalizedString(message, language));

        }
    };

    const feedbackPlaceholder = useLocalizedString("Please type feedback or leave blank");
    const messagePlaceholder = useLocalizedString("Type your message");

    const renderMarkdownToHTML = async (markdown: string): Promise<string> => {
        return new Promise((resolve) => {
            const tempElement = document.createElement('div');

            // Create a root for React rendering
            const root = ReactDOM.createRoot(tempElement);

            const markdownElement = (
                <ReactMarkdown
                    rehypePlugins={[rehypeRaw]}
                    remarkPlugins={[remarkGfm]}
                    components={{
                        table: ({ children, ...props }) => (
                            <table style={{ borderCollapse: 'collapse', width: '100%' }} {...props}>
                                {children}
                            </table>
                        ),
                        th: ({ children, ...props }) => (
                            <th style={{ border: '1px solid black', padding: '8px', backgroundColor: '#f2f2f2' }} {...props}>
                                {children}
                            </th>
                        ),
                        td: ({ children, ...props }) => (
                            <td style={{ border: '1px solid black', padding: '8px' }} {...props}>
                                {children}
                            </td>
                        ),
                    }}
                >
                    {markdown}
                </ReactMarkdown>
            );

            // Render the element and then resolve the innerHTML
            root.render(markdownElement);
            resolve(tempElement.innerHTML);
        });
    };


    return (
        <div key={renderKey}>
            <div className={styles.container}>
                <div className={styles.chatContainer}>
                    {messages.map((message, index) => (
                        <div key={index} className={`${styles.message} ${message.role === 'user' ? styles.userMessage : styles.aiMessage}`}>
                            <div className={styles.messageRole}>
                                {message.role === 'user' ? <LocalizedText name={`User: ${task}`} /> : <LocalizedText name={role} />}
                            </div>
                            <ReactMarkdown
                                remarkPlugins={[remarkGfm]}
                                rehypePlugins={[rehypeRaw]}
                                components={{
                                    table: ({ children, ...props }) => (
                                        <table className={styles.customTable} {...props}>
                                            {children}
                                        </table>
                                    ),
                                    thead: ({ children, ...props }) => (
                                        <thead {...props}>{children}</thead>
                                    ),
                                    tbody: ({ children, ...props }) => (
                                        <tbody {...props}>{children}</tbody>
                                    ),
                                    tr: ({ children, ...props }) => (
                                        <tr {...props}>{children}</tr>
                                    ),
                                    th: ({ children, ...props }) => (
                                        <th {...props}>{children}</th>
                                    ),
                                    td: ({ children, ...props }) => (
                                        <td {...props}>{children}</td>
                                    ),
                                    code: ({ node, className, children, ...props }) => {
                                        const match = /language-(\w+)/.exec(className || '');
                                        if (match && match[1] === 'html') {
                                            return <div dangerouslySetInnerHTML={{ __html: String(children).replace(/\n$/, '') }} />;
                                        }
                                        return <code className={className} {...props}>{children}</code>;
                                    },
                                }}
                            >
                                {message.content}

                            </ReactMarkdown>

                            {message.role === 'assistant' && (
                                <button
                                    onClick={() => copyToClipboard(message.content)}
                                    className={styles.copyButton}
                                >
                                    <LocalizedText name="Copy" />
                                </button>
                            )}
                        </div>
                    ))}
                    {isLoading && <div className={styles.loadingIndicator}> <LocalizedText name="AI is thinking..." /></div>}
                </div>

                <div className={styles.buttonContainer}>
                    {options.map((option) => (
                        <div key={option} className={styles.buttonWrapper}>
                            <button
                                onClick={() => handleButtonClick(option)}
                                className={styles.cardButton}
                                disabled={isLoading || isRefining}
                            >
                                <LocalizedText name={optionShortNames[option]} />
                            </button>
                            <div className={styles.buttonTooltip}>
                                <LocalizedText name={option} />
                            </div>
                        </div>
                    ))}
                </div>

                <form onSubmit={(e) => { e.preventDefault(); isRefining ? handleRefineSubmit() : handleSend(input); }} className={styles.inputForm}>
                    <textarea
                        ref={inputRef}
                        className={`${styles.input} ${isRefining ? styles.refineInput : ''}`}
                        value={input}
                        onChange={handleInputChange}
                        placeholder={isRefining ? feedbackPlaceholder : messagePlaceholder}
                        rows={1}
                    />
                    <button type="submit" className={`${styles.cardButton} ${styles.fixedHeightButton}`}>
                        <LocalizedText name={isRefining ? 'refine' : 'send'} />
                    </button>
                </form>
            </div>
        </div>
    );
}
