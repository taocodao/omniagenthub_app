        console.error('Failed to fetch notebooks:', response.status);
        toast.error('Failed to load notebooks');
      }
    } catch (error) {
      console.error('Error fetching notebooks:', error);
      toast.error('Failed to load notebooks');
    }
  };
  
// ✅ NEW: Check if notebook can be deleted
const onDeleteNotebookWithCheck = (notebookId: string) => {
  const notebook = notebooks.find(n => n.id === notebookId);
  if (!notebook) {
    toast.error('Notebook not found');
    return;
  }

  // Non-empty: show guidance dialog
  if ((notebook.sourceCount ?? 0) > 0) {
    setOpenMenuNotebookId(null);
    setDeleteBlockDialog({ open: true, notebook });
    return;
  }

  // Empty: use existing delete routine
  handleDeleteNotebook(notebookId);
};


const handleDeleteNotebook = async (notebookId: string) => {
  if (!address) {
    toast.error('Please connect your wallet first');
    return;
  }

  const notebook = notebooks.find((n) => n.id === notebookId);
  if (!notebook) {
    toast.error('Notebook not found');
    return;
  }

  // ✅ ENHANCED: Better check with more visible error
  if ((notebook.sourceCount ?? 0) > 0) {
    // Use a more prominent warning
    const message = `⚠️ Cannot delete "${notebook.title}"\n\nThis notebook contains ${notebook.sourceCount} source${notebook.sourceCount !== 1 ? 's' : ''}.\n\nPlease open the notebook and remove all sources before deleting.`;
    
    alert(message); // Browser alert for maximum visibility
    
    toast.error(
      `Cannot delete "${notebook.title}" - it has ${notebook.sourceCount} source${notebook.sourceCount !== 1 ? 's' : ''}`,
      {
        position: 'top-center',
        autoClose: 5000,
        style: {
          background: '#fee',
          color: '#c00',
          fontWeight: 'bold'
        }
      }
    );
    
    setOpenMenuNotebookId(null);
    return;
  }

  // Only ask for confirmation if notebook is empty
  const confirmed = window.confirm(`Delete "${notebook.title}"? This action cannot be undone.`);
  if (!confirmed) {
    setOpenMenuNotebookId(null);
    return;
  }

  try {
    const response = await fetch('/api/notebooks/delete', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        userKey: HashUtil.hashTo(address),
        notebookId,
        userAddress: address,
      }),
    });

    const data = await response.json();

    if (data.success) {
      toast.success('✅ Notebook deleted successfully');
      
      // ✅ Refresh the notebooks list
      await fetchNotebooks();
      
      // ✅ Close the notebook view if we deleted the current one
      if (currentNotebook?.id === notebookId) {
        setCurrentNotebook(null);
        setShowNotebookDetail(false);
        setView('grid');
      }
    } else {
      toast.error(data.message || 'Failed to delete');
    }
  } catch (error) {
    console.error('Delete error:', error);
    toast.error('Failed to delete notebook');
  } finally {
    setOpenMenuNotebookId(null);
  }
};


  // Create new notebook - ✅ FIXED: Now passes userAddress
  const createNotebook = async () => {
    if (!newNotebookTitle.trim()) {
      toast.error('Please enter a notebook title');
      return;
    }

    if (!address) {
      toast.error('Please connect your wallet first');
      return;
    }

    try {
      const hashedUserKey = HashUtil.hashTo(address);
      console.log('Creating notebook with:', { 
        address, 
        hashedUserKey, 
        title: newNotebookTitle.trim() 
      });

      // ✅ CRITICAL FIX: Include userAddress in request body
      const requestBody = {
        userKey: hashedUserKey,
        title: newNotebookTitle.trim(),
        userAddress: address // ✅ This was missing!
      };

      console.log('Create notebook request body:', requestBody);

      const response = await fetch('/api/notebooks/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(requestBody)
      });

      const data = await response.json();
      console.log('Create notebook response:', data);

      if (data.success) {
        await fetchNotebooks();
        setNewNotebookTitle('');
        setShowCreateNotebook(false);
        toast.success('Notebook created successfully');

      // ✅ CRITICAL FIX: Add small delay to ensure KV sync
    setTimeout(() => {
      openNotebook(data.notebook);
    }, 500); // 500ms delay to ensure KV storage is synchronized
      } else {
        throw new Error(data.message || 'Failed to create notebook');
      }
    } catch (error) {
      console.error('Error creating notebook:', error);
      toast.error('Failed to create notebook');
    }
  };

// Open notebook and load its sources
const openNotebook = async (notebook: Notebook) => {
  setCurrentNotebook(notebook);
  setView('notebook');
  
  // Load sources from database
  if (address) {
    try {
      const hashedUserKey = HashUtil.hashTo(address);
      const response = await fetch(`/api/sources/list?userKey=${hashedUserKey}&notebookId=${notebook.id}`);
      
      if (response.ok) {
        const data = await response.json();
        if (data.success) {
          console.log('✅ Loaded', data.sources.length, 'sources from database');
          setSources(data.sources);
          setSelectedSources(new Set(data.sources?.filter((s: any) => s.selected).map((s: any) => s.id)));
        }
      }
    } catch (error) {
      console.error('Error loading sources:', error);
      // Fallback to notebook sources if API fails
      setSources(notebook.sources || []);
      setSelectedSources(new Set(notebook.sources?.filter((s: any) => s.selected).map((s: any) => s.id)));
    }
  } else {
    // Fallback to notebook sources
    setSources(notebook.sources || []);
    setSelectedSources(new Set(notebook.sources?.filter((s: any) => s.selected).map((s: any) => s.id)));
  }
};

// ✅ ADD: Load notebooks function
const loadNotebooks = async () => {
  if (!address) return;

  try {
    const response = await fetch('/api/notebooks/list', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        userKey: HashUtil.hashTo(address),
        userAddress: address
      })
    });

    const data = await response.json();

    if (data.success && data.notebooks) {
      setNotebooks(data.notebooks);
    }
  } catch (error) {
    console.error('Error loading notebooks:', error);
  }
};
 


  // Update notebook - ✅ FIXED: Now passes userAddress
  const updateNotebook = async (notebookId: string, updates: Partial<Notebook>) => {
    if (!address) {
      toast.error('Please connect your wallet first');
      return;
    }

    try {
      const hashedUserKey = HashUtil.hashTo(address);
      const response = await fetch('/api/notebooks/update', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          userKey: hashedUserKey,
          notebookId,
          updates,
          userAddress: address // ✅ Added userAddress
        })
      });

      const data = await response.json();
      if (data.success) {
        await fetchNotebooks();
        if (currentNotebook && currentNotebook.id === notebookId) {
          setCurrentNotebook(data.notebook);
        }
      }
    } catch (error) {
      console.error('Error updating notebook:', error);
    }
  };
  const [activeTab, setActiveTab] = useState<'website' | 'paste'>('website');

  // Delete notebook - ✅ FIXED: Now passes userAddress
  const deleteNotebook = async (notebookId: string) => {
    if (!confirm('Are you sure you want to delete this notebook? This action cannot be undone.')) {
      return;
    }

    if (!address) {
      toast.error('Please connect your wallet first');
      return;
    }

    try {
      const hashedUserKey = HashUtil.hashTo(address);
      const response = await fetch('/api/notebooks/delete', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          userKey: hashedUserKey,
          notebookId,
          userAddress: address // ✅ Added userAddress
        })
      });

      const data = await response.json();
      if (data.success) {
        await fetchNotebooks();
        if (currentNotebook && currentNotebook.id === notebookId) {
          setCurrentNotebook(null);
          setView('grid');
        }
        toast.success('Notebook deleted successfully');
      }
    } catch (error) {
      console.error('Error deleting notebook:', error);
      toast.error('Failed to delete notebook');
    }
  };

// ✅ ADD: Success notification useEffect
useEffect(() => {
  const allProcessed = uploadingFiles.every(f => f.status === 'completed' || f.status === 'error');
  const hasSuccessful = uploadingFiles.some(f => f.status === 'completed');
  
  if (allProcessed && uploadingFiles.length > 0 && hasSuccessful) {
    const successCount = uploadingFiles.filter(f => f.status === 'completed').length;
    toast.success(`Successfully uploaded ${successCount} file(s)`);
  }
}, [uploadingFiles]);

// ✅ ENHANCED: Handle file upload with progress modal - COMPLETELY FIXED VERSION
const handleFiles = async (files: FileList) => {
  if (!currentNotebook) {
    toast.error('Please open a notebook first');
    return;
  }

  if (!address) {
    toast.error('Please connect your wallet first');
    return;
  }

  const sourceLimit = 50;
  if (sources.length + files.length > sourceLimit) {
    toast.error(`Source limit exceeded. Maximum ${sourceLimit} sources allowed.`);
    return;
  }

  // ✅ CRITICAL FIX: Verify currentNotebook has valid ID before proceeding
  if (!currentNotebook?.id || currentNotebook.id === 'undefined' || currentNotebook.id === 'null') {
    console.error('❌ Invalid current notebook:', currentNotebook);
    toast.error('Invalid notebook selected. Please refresh and try again.');
    return;
  }

  // ✅ Initialize upload modal
  const fileList = Array.from(files).map(file => ({
    name: file.name,
    progress: 0,
    status: 'uploading' as const,
    error: undefined
  }));

  setUploadingFiles(fileList);
  setShowUploadModal(true);
  setUploading(true);

  // ✅ Close the "Add Sources" view
  setView('notebook');

  // ✅ Track successful uploads for final summary
  let successfulUploads = 0;
  let failedUploads = 0;

  // ✅ Process files sequentially to avoid overwhelming the system
  for (let i = 0; i < files.length; i++) {
    const file = files[i];

    // Validate file type - EXPANDED to support more formats
const allowedTypes = [
  '.pdf',
  '.docx', '.doc',
  '.pptx', '.ppt',  // ✅ Added PowerPoint
  '.xlsx', '.xls',  // ✅ Added Excel
  '.txt', '.md', '.rtf',
  '.odt',
  '.html', '.htm',
  '.csv', '.json', '.xml'
];
const fileExtension = file.name.toLowerCase().substring(file.name.lastIndexOf('.'));

if (!allowedTypes.includes(fileExtension)) {
  // Update file status to error
  setUploadingFiles(prev =>
    prev.map((f, idx) => idx === i ? { ...f, status: 'error', error: `Unsupported file type: ${fileExtension}` } : f)
  );
  failedUploads++;
  continue;
}


    const sourceId = `file_${Date.now()}_${i}`;

    try {
      console.log(`📁 Starting upload for: ${file.name}`);
      
      // ✅ Update progress: Starting
      setUploadingFiles(prev => prev.map((f, idx) => 
        idx === i ? { ...f, progress: 10 } : f
      ));

      // ✅ ENHANCED VALIDATION: Double-check notebook state before upload
      if (!currentNotebook?.id) {
        console.error('❌ No current notebook selected for upload');
        throw new Error('No notebook selected');
      }

      console.log('📋 Uploading to notebook:', {
        notebookId: currentNotebook.id,
        notebookTitle: currentNotebook.title,
        fileName: file.name,
        sourceId
      });

      // ✅ Upload file with progress tracking and enhanced error handling
      const uploadResult = await uploadFileToNotebook(file, sourceId, currentNotebook.id, (progress) => {
  // Update progress during upload
  setUploadingFiles(prev =>
    prev.map((f, idx) => idx === i ? { ...f, progress: Math.min(progress, 95) } : f)
  );
});

// ENHANCED: Check upload result thoroughly
if (!uploadResult) {
  throw new Error('Upload returned no result');
}
if (!uploadResult.success) {
  throw new Error(uploadResult.message || 'Upload failed');
}

// Update status to completed
setUploadingFiles(prev =>
  prev.map((f, idx) => idx === i ? { ...f, status: 'completed', progress: 100 } : f)
);

successfulUploads++;
console.log('✅ Upload completed for', file.name);

// ✅ FIXED: Immediately update UI with surfsenseDocId
if (uploadResult.success && uploadResult.source) {
 console.log('✅ Upload response data:', {
  surfsenseDocId: uploadResult.surfsenseDocId,
  searchSpaceId: uploadResult.searchSpaceId, // ✅ ADD THIS
  source: uploadResult.source
});

// ✅ ADD THIS DEBUG LOG
console.log('📋 Source details:', {
  id: uploadResult.source?.id,
  title: uploadResult.source?.title,
  status: uploadResult.source?.status,
  surfsenseDocId: uploadResult.source?.surfsenseDocId,
  surfsenseSearchSpaceId: uploadResult.source?.surfsenseSearchSpaceId, // ✅ KEY FIELD
});

  const completedSource: NotebookSource = {
    ...uploadResult.source,
    status: 'completed',
    progress: 100,
    selected: true,
    surfsenseDocId: uploadResult.surfsenseDocId || uploadResult.source.surfsenseDocId // ✅ Ensure surfsenseDocId is set
  };

  // NEW: Use the add source API to ensure persistence
  try {
    await addSourceToNotebook(completedSource);
    console.log('✅ Source persisted to database:', completedSource.id, 'Doc ID:', completedSource.surfsenseDocId);
  } catch (error) {
    console.warn('Failed to persist source, but upload succeeded:', error);
    // Don't fail the upload for persistence issues
  }

  // ✅ Update sources list immediately in UI with surfsenseDocId
  setSources(prev => {
    const existingIndex = prev.findIndex(s => s.id === sourceId);
    if (existingIndex !== -1) {
      const updated = [...prev];
      updated[existingIndex] = completedSource;
      console.log('✅ Updated existing source with Doc ID:', completedSource.surfsenseDocId);
      return updated;
    } else {
      console.log('✅ Added new source with Doc ID:', completedSource.surfsenseDocId);
      return [...prev, completedSource];
    }
  });

  // Add to selected sources
  setSelectedSources(prev => new Set([...prev, sourceId]));

  console.log('✅ Source added to UI immediately:', completedSource.title, 'Doc ID:', completedSource.surfsenseDocId);
}


      // ✅ ENHANCED: Force refresh with better error handling
      try {
        const hashedUserKey = HashUtil.hashTo(address);
        const response = await fetch(`/api/notebooks/get?userKey=${hashedUserKey}&notebookId=${currentNotebook.id}`);
        
        if (response.ok) {
          const data = await response.json();
          if (data.success && data.notebook) {
            // ✅ Only update if we have more sources than currently displayed
            if (data.notebook.sources && data.notebook.sources.length > sources.length) {
              setSources(data.notebook.sources);
              setCurrentNotebook(data.notebook);
              console.log(`✅ Refreshed notebook with ${data.notebook.sources.length} sources`);
            }
          }
        } else {
          console.warn(`⚠️ Refresh failed with status: ${response.status}`);
        }
      } catch (error) {
        console.warn('⚠️ Error refreshing notebook:', error);
        // Don't fail the whole upload process for refresh errors
      }

      // ✅ NEW: Create/update chat assistant after successful upload
      try {
        console.log('🤖 Creating chat assistant after source upload...');
        await updateNotebookEmbeddings(currentNotebook.id);
        console.log('✅ Chat assistant updated successfully');
      } catch (error) {
        console.warn('⚠️ Failed to create chat assistant:', error);
        // Don't fail upload for this
      }

    } catch (error) {
      console.error(`❌ Upload failed for ${file.name}:`, error);
      failedUploads++;
      
      const errorMessage = error instanceof Error ? error.message : 'Upload failed';
      
      // ✅ Update file status to error
      setUploadingFiles(prev => prev.map((f, idx) => 
        idx === i ? { ...f, status: 'error', error: errorMessage, progress: 0 } : f
      ));
      

      // ✅ ENHANCED ERROR LOGGING
      console.error('Upload error details:', {
        fileName: file.name,
        sourceId,
        notebookId: currentNotebook.id,
        error: errorMessage,
        stack: error instanceof Error ? error.stack : undefined
      });
    }

    // ✅ Small delay between files to prevent overwhelming the server
    if (i < files.length - 1) {
      await new Promise(resolve => setTimeout(resolve, 500));
    }
  }

  setUploading(false);

  // ✅ ENHANCED: Show summary toast based on results
  if (successfulUploads === files.length) {
    toast.success(`Successfully uploaded ${successfulUploads} file${successfulUploads === 1 ? '' : 's'}`);
  } else if (successfulUploads > 0) {
    toast.warn(`Uploaded ${successfulUploads} of ${files.length} files. ${failedUploads} failed.`);
  } else if (failedUploads > 0) {
    toast.error(`Failed to upload ${failedUploads} file${failedUploads === 1 ? '' : 's'}`);
  }

  // ✅ FIXED - Close modal with better timing and state management
  setTimeout(() => {
    setUploadingFiles(current => {
      const allProcessed = current.every(f => f.status === 'completed' || f.status === 'error');
      
      if (allProcessed) {
        setShowUploadModal(false);
        
        // ✅ FINAL REFRESH: Get the latest notebook state after all uploads
        if (successfulUploads > 0) {
          setTimeout(async () => {
            try {
              const hashedUserKey = HashUtil.hashTo(address!);
              const response = await fetch(`/api/notebooks/get?userKey=${hashedUserKey}&notebookId=${currentNotebook!.id}`);
              
              if (response.ok) {
                const data = await response.json();
                if (data.success && data.notebook) {
                  setSources(data.notebook.sources || []);
                  setCurrentNotebook(data.notebook);
                  
                  // ✅ Update selected sources to include all completed sources
                  const completedSourceIds = data.notebook.sources
                    ?.filter((s: NotebookSource) => s.status === 'completed')
                    .map((s: NotebookSource) => s.id) || [];
                  
                  setSelectedSources(new Set(completedSourceIds));
                  console.log(`🎯 Final refresh: ${data.notebook.sources?.length || 0} sources loaded`);
                }
              }
            } catch (error) {
              console.warn('⚠️ Final refresh failed:', error);
            }
          }, 1000);
        }
        
        return [];
      }
      
      return current;
    });
  }, 3000);

  console.log(`📊 Upload summary: ${successfulUploads} successful, ${failedUploads} failed`);
};




// AFTER - Fixed with proper validation and retry logic
const uploadFileToNotebook = async (
  file: File,
  sourceId: string,
  notebookId: string,
  onProgress?: (progress: number) => void
): Promise<{ 
  success: boolean; 
  source?: NotebookSource; 
  surfsenseDocId?: number;  // ✅ ADD THIS
  searchSpaceId?: number;   // ✅ ADD THIS
  message?: string;
} | null> => {
  
  if (!address) throw new Error('Wallet not connected');

  // ✅ ENHANCED VALIDATION
  if (!notebookId || notebookId === 'undefined' || notebookId === 'null') {
    console.error('❌ Invalid notebook ID:', notebookId);
    throw new Error('Invalid notebook ID provided');
  }

  if (!currentNotebook?.id) {
    console.error('❌ No current notebook selected');
    throw new Error('No current notebook selected');
  }

  // ✅ CRITICAL FIX: Verify notebookId matches current notebook
  if (notebookId !== currentNotebook.id) {
    console.error('❌ Notebook ID mismatch:', { provided: notebookId, current: currentNotebook.id });
    throw new Error('Notebook ID mismatch - please refresh and try again');
  }

  console.log('📁 Starting upload with validated IDs:', {
    notebookId,
    currentNotebookId: currentNotebook.id,
    userKey: HashUtil.hashTo(address),
    fileName: file.name
  });

  const formData = new FormData();
  formData.append('file', file);
  formData.append('userKey', HashUtil.hashTo(address));
  formData.append('sourceId', sourceId);
  formData.append('notebookId', notebookId);
  formData.append('userAddress', address);

  // ✅ RETRY LOGIC for race conditions
  let retryCount = 0;
  const maxRetries = 3;
  
  while (retryCount <= maxRetries) {
    try {
      updateSourceStatus(sourceId, 'uploading', 25);
      onProgress?.(25);

      const response = await fetch('/api/sources/upload-file', {
        method: 'POST',
        body: formData
      });

      const data = await response.json();

      if (data.success) {
        updateSourceStatus(sourceId, 'processing', 75);
        onProgress?.(75);
        return { success: true, source: data.source, message: data.message };
      } else if (data.error?.includes('Notebook not found') && retryCount < maxRetries) {
        // ✅ RETRY LOGIC: Wait and retry for race conditions
        console.warn(`⏳ Retry ${retryCount + 1}/${maxRetries}: ${data.error}`);
        await new Promise(resolve => setTimeout(resolve, 1000 * (retryCount + 1))); // Exponential backoff
        retryCount++;
        continue;
      } else {
        throw new Error(data.error || 'Upload failed');
      }
    } catch (error) {
      if (retryCount < maxRetries && error instanceof Error && error.message.includes('Notebook not found')) {
        console.warn(`⏳ Retry ${retryCount + 1}/${maxRetries} due to error:`, error.message);
        await new Promise(resolve => setTimeout(resolve, 1000 * (retryCount + 1)));
        retryCount++;
        continue;
      }
      
      updateSourceStatus(sourceId, 'error', 0, error instanceof Error ? error.message : 'Upload failed');
      throw error;
    }
  }

  throw new Error('Upload failed after maximum retries');
};



 // ✅ REPLACE: Enhanced website upload with advanced scraping
const handleWebsiteUpload = async () => {
  if (!websiteUrl.trim()) {
    toast.error('Please enter a valid website URL');
    return;
  }

  if (!address || !currentNotebook) {
    toast.error('Please connect wallet and select a notebook');
    return;
  }

  // Prevent multiple concurrent scraping operations
  if (isWebsiteScrapingInProgress) {
    toast.warning('Website scraping is already in progress');
    return;
  }

  setIsWebsiteScrapingInProgress(true);
  setWebsiteScrapeStatus("Initiating website scraping...");

  const sourceItem: NotebookSource = {
    id: `website_${Date.now()}`,
    title: websiteUrl,
    type: 'website',
    status: 'uploading',
    progress: 0,
    dateCreated: new Date().toLocaleDateString(),
    url: websiteUrl,
    selected: true
  };

  // Add source to UI immediately
  setSources(prev => [...prev, sourceItem]);
  setSelectedSources(prev => new Set([...prev, sourceItem.id]));

  try {
    console.log('🌐 Starting advanced website scraping for:', websiteUrl);

    // Process payment first
    toast.info('Processing payment for website scraping...', {
      position: "top-right",
      autoClose: 3000,
      style: { zIndex: 9999 }
    });

    const paymentSuccessful = await processPaymentForScraping(address);
    if (!paymentSuccessful) {
