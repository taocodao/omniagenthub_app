  backgroundColor: 'white',
  borderRadius: '24px',
  width: view === 'notebook' ? '95vw' : '90vw',
  height: view === 'notebook' ? '95vh' : '90vh',
  maxWidth: view === 'notebook' ? '1400px' : '1200px',
  display: 'flex',
  flexDirection: 'column',
  overflow: 'hidden',
  boxShadow: '0 25px 80px rgba(0, 0, 0, 0.4)',
  border: '1px solid rgba(255, 255, 255, 0.1)'
}}>

