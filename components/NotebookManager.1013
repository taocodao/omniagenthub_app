  // ✅ MOVE THESE TWO FUNCTIONS HERE - Right after useEffect, before fetchNotebooks

const handleRenameNotebook = async (notebookId: string, currentTitle: string) => {
  if (!address) {
    toast.error('Please connect your wallet first');
    return;
  }

  const newTitle = prompt('Enter new notebook name:', currentTitle);
  if (!newTitle || !newTitle.trim() || newTitle === currentTitle) {
    setOpenMenuNotebookId(null);
    return;
  }

  try {
    const response = await fetch('/api/notebooks/edit', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        userKey: HashUtil.hashTo(address),
        notebookId,
        title: newTitle.trim()
      })
    });

    const data = await response.json();
    if (data.success) {
      toast.success(`Renamed to "${newTitle}"`);
      await fetchNotebooks(); // Use fetchNotebooks instead of loadNotebooks
      if (currentNotebook?.id === notebookId) {
        setCurrentNotebook({ ...currentNotebook, title: newTitle.trim() });
      }
    } else {
      toast.error(data.message || 'Failed to rename');
    }
  } catch (error) {
    console.error('Rename error:', error);
    toast.error('Failed to rename notebook');
  } finally {
    setOpenMenuNotebookId(null);
  }
};



// ✅ Then keep the rest of your functions (fetchNotebooks, etc.)


  // Fetch user's notebooks - ✅ FIXED: Better error handling and logging
