{/* Status indicator - FIXED FOR QUIVR RAG API */}
{(() => {
  const completedSources = sources.filter(s => s.status === 'completed');
  const selectedCompleted = sources.filter(s => 
    s.status === 'completed' && s.selected
  );
  const processingSources = sources.filter(s => 
    s.status === 'processing' || s.status === 'uploading'
  );
  
  // Only show button when NO files uploaded
  if (sources.length === 0) {
    return (
      <span style={{
        backgroundColor: '#f59e0b',
        color: 'white',
        padding: '4px 12px',
        borderRadius: '12px',
        fontSize: '12px',
        fontWeight: '500',
        marginTop: '8px',
        display: 'inline-block'
      }}>
        📤 Upload sources to enable chat
      </span>
    );
  }
  
  // Show processing status
  if (processingSources.length > 0) {
    return (
      <span style={{
        backgroundColor: '#ff9800',
        color: 'white',
        padding: '4px 12px',
        borderRadius: '12px',
        fontSize: '12px',
        fontWeight: '500',
        marginTop: '8px',
        display: 'inline-block'
      }}>
        ⏳ Processing ({processingSources.length} sources...)
      </span>
    );
  }
  
  // Show ready when files completed
  if (completedSources.length > 0) {
    if (selectedCompleted.length > 0) {
      return (
        <span style={{
          backgroundColor: '#4CAF50',
          color: 'white',
          padding: '4px 12px',
          borderRadius: '12px',
          fontSize: '12px',
          fontWeight: '500',
          marginTop: '8px',
          display: 'inline-block'
        }}>
          💬 Ready to Chat ({selectedCompleted.length} selected)
        </span>
      );
    } else {
      return (
        <span style={{
          backgroundColor: '#10b981',
          color: 'white',
          padding: '4px 12px',
          borderRadius: '12px',
          fontSize: '12px',
          fontWeight: '500',
          marginTop: '8px',
          display: 'inline-block'
        }}>
          ✅ Select sources to chat ({completedSources.length} available)
        </span>
      );
    }
  }
  
  return null;
})()}


  </div>

