      },
      body: JSON.stringify({
        url: websiteUrl,
        sharedUserIds: [], // Optional: Add users to share access with
      }),
    });

    if (!response.ok) {
      const errorData = await response.json();
      throw new Error(errorData.details || "Failed to initiate website scraping");
    }

    const data = await response.json();
    const scrapeTime = new Date().toLocaleString();

    // Store job ID for status tracking
    setWebsiteScrapeJobId(data.jobId);
    
    updateSourceStatus(sourceItem.id, 'processing', 25);
    setWebsiteScrapeStatus(`Scraping of ${websiteUrl} initiated at ${scrapeTime}. This process will continue in the background.`);

    toast.success('Website scraping job started successfully. You\'ll be notified when it completes.', {
      position: "top-right",
      autoClose: 5000,
      style: { zIndex: 9999 }
    });

    // ✅ NEW: Add the source to the notebook via API immediately
    try {
      const processingSource = { ...sourceItem, status: 'processing' as const, progress: 25 };
      await addSourceToNotebook(processingSource);
      console.log('✅ Website source added to database:', sourceItem.id);
    } catch (error) {
      console.warn('⚠️ Failed to persist website source to database:', error);
    }

    // Start advanced status checking with polling
    await checkScrapeStatus(data.jobId, sourceItem.id, websiteUrl);

    // Clear the input field
    setWebsiteUrl('');

  } catch (error) {
    console.error('❌ Error in advanced website scraping:', error);
    const errorMessage = error instanceof Error ? error.message : 'Unknown error occurred';
    
    updateSourceStatus(sourceItem.id, 'error', 0, errorMessage);
    setWebsiteScrapeStatus(`Website scraping failed: ${errorMessage}`);
    
    toast.error(`Website scraping failed: ${errorMessage}`, {
      position: "top-right",
      autoClose: 8000,
      style: { zIndex: 9999 }
    });

    setIsWebsiteScrapingInProgress(false);
    setWebsiteScrapeJobId(null);
  }
};

  // Handle pasted text - ✅ FIXED: Now passes userAddress
