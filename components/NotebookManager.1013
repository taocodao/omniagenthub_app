  // ✅ ADD: Payment processing function similar to your handleLoadData
const processPaymentForScraping = async (address: string): Promise<boolean> => {
  try {
    // You may need to import or define these if not already available
    const PLATFORM_NAME = "Web3AIstore"; // Define this constant
    
