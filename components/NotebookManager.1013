{/* Enhanced Chat Interface - COMPLETELY FIXED WITH SCROLL */}
<div style={{
  flex: 1,
  display: 'flex',
  flexDirection: 'column',
  width: '100%',
  minHeight: 0, // Important for flex child to shrink
  overflow: 'hidden'
}}>


<ChatInterface
  notebookId={currentNotebook.id}
  userKey={HashUtil.hashTo(address!)}
  userAddress={address!}
