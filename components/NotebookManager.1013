    } catch (error) {
      updateSourceStatus(sourceItem.id, 'error', 0, error instanceof Error ? error.message : 'Text upload failed');
    }
  };

// ✅ FIXED: Update notebook embeddings and CREATE PINECONE ASSISTANT
const updateNotebookEmbeddings = async (notebookId: string) => {
  if (!address) {
    console.warn('No wallet address for updating embeddings');
    return;
  }

  try {
    console.log('🔄 Updating notebook embeddings and creating Pinecone assistant...');
    
    const response = await fetch('/api/notebooks/update-embeddings', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        userKey: HashUtil.hashTo(address),
        notebookId,
        userAddress: address,
        createAssistant: true // ✅ NEW: Tell API to create assistant
      })
    });

    const data = await response.json();
    console.log('📋 Update embeddings response:', data);

    if (data.success) {
      console.log('✅ Notebook embeddings updated:', {
        assistantId: data.assistantId,
        assistantName: data.assistantName,
        sourceCount: data.sourceCount
      });

      // ✅ CRITICAL: Update the current notebook with assistant info
      if (currentNotebook && data.assistantName) {
        const updatedNotebook = {
          ...currentNotebook,
          pineconeAssistantId: data.assistantId,
          pineconeAssistantName: data.assistantName,
          lastUpdated: new Date().toISOString()
        };
        setCurrentNotebook(updatedNotebook);
        console.log('🔄 Updated notebook with assistant info');
      }

      toast.success('Chat assistant created successfully!', {
        position: 'top-right',
        autoClose: 3000
      });
    } else {
      throw new Error(data.message || 'Failed to update embeddings');
    }
  } catch (error) {
    console.error('❌ Error updating embeddings:', error);
    toast.error('Failed to create chat assistant');
  }
};


// ✅ ENHANCED: Chat with notebook with better error handling
const handleChatQuery = async () => {
  if (!chatQuery.trim() || !currentNotebook || chatLoading) {
    return;
  }

  if (!address) {
    toast.error('Please connect your wallet first');
    return;
  }

  setChatLoading(true);

  try {
    const selectedSourceIds = Array.from(selectedSources);
    
    const response = await fetch('/api/notebooks/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        userKey: HashUtil.hashTo(address),
        notebookId: currentNotebook.id,
        query: chatQuery.trim(),
        selectedSources: selectedSourceIds,
        userAddress: address,
        searchScope: 'current' // ✅ NEW: Search scope for direct embedding
      })
    });

    const data = await response.json();

    if (data.success) {
      setChatResponse(data.response);
      // ✅ NEW: Optional - show which sources were used
      if (data.sourcesUsed && data.sourcesUsed.length > 0) {
        console.log('Sources used:', data.sourcesUsed);
      }
    } else {
      toast.error(data.message || 'Chat failed');
    }
  } catch (error) {
    console.error('Chat error:', error);
    toast.error('Failed to get response');
  } finally {
    setChatLoading(false);
  }
};


// ✅ COMPLETELY FIXED: Delete source function
const deleteSource = async (sourceId: string) => {
  if (!currentNotebook) {
    console.warn('No current notebook for deletion');
    return;
  }
  
  if (!address) {
    toast.error('Please connect your wallet first');
    return;
  }

  // Add confirmation dialog
  const confirmed = confirm('Are you sure you want to delete this source? This action cannot be undone.');
  if (!confirmed) return;

  try {
    console.log('🗑️ Starting deletion process for source:', sourceId);
    
    // Find the source to get its pineconeFileId
    const sourceToDelete = sources.find(s => s.id === sourceId);
    if (!sourceToDelete) {
      console.error('Source not found in local state:', sourceId);
      toast.error('Source not found');
      return;
    }

    console.log('📋 Source details:', {
      id: sourceToDelete.id,
      title: sourceToDelete.title,
      type: sourceToDelete.type,
      pineconeFileId: sourceToDelete.pineconeFileId
    });

    // ✅ FIXED: Include pineconeFileId in the request
    const requestBody = {
      sourceId,
      notebookId: currentNotebook.id,
      userKey: HashUtil.hashTo(address),
      pineconeFileId: sourceToDelete.pineconeFileId || null // Include this!
    };

    console.log('📤 Delete request:', requestBody);
    
    const response = await fetch('/api/sources/delete', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(requestBody)
    });

    console.log('📥 Delete response status:', response.status);

    // ✅ FIXED: Better response handling
    if (response.ok) {
      const data = await response.json();
      console.log('📋 Delete response data:', data);

      if (data.success) {
        // Update UI immediately
        console.log('🔄 Updating UI - removing source from list');
        setSources(prev => {
          const filtered = prev.filter(source => source.id !== sourceId);
          console.log('📊 Sources before:', prev.length, 'after:', filtered.length);
          return filtered;
        });

        // Update selected sources
        const newSelected = new Set(selectedSources);
        newSelected.delete(sourceId);
        setSelectedSources(newSelected);
        console.log('✅ Updated selected sources');
        
        // Update notebook embeddings in background
        try {
          await updateNotebookEmbeddings(currentNotebook.id);
          console.log('✅ Updated notebook embeddings');
        } catch (embedError) {
          console.warn('⚠️ Failed to update embeddings:', embedError);
          // Don't fail the delete for this
        }

        toast.success(`Source "${sourceToDelete.title}" deleted successfully`);
        console.log('✅ Source deletion completed successfully:', sourceId);
      } else {
        throw new Error(data.error || data.message || 'Delete operation failed');
      }
    } else {
      // Handle HTTP error status
      const errorText = await response.text();
      console.error('❌ Delete request failed:', {
        status: response.status,
        statusText: response.statusText,
        body: errorText
      });
      throw new Error(`Delete request failed: ${response.status} ${response.statusText}`);
    }
  } catch (error) {
    console.error('❌ Delete source error:', error);
    const errorMessage = error instanceof Error ? error.message : 'Failed to delete source';
    toast.error(`Failed to delete source: ${errorMessage}`);
  }
};



// Poll processing status - ✅ FIXED VERSION
const pollProcessingStatus = async (sourceId: string, fileId: string) => {
  const maxAttempts = 30;
  let attempts = 0;

  const poll = async () => {
    try {
      // ✅ FIXED: Include required parameters for assistant name lookup
     // ✅ FIXED: Handle potentially undefined address
const hashedUserKey = address ? HashUtil.hashTo(address) : '';
if (!hashedUserKey || !currentNotebook?.id) {
  console.warn('⚠️ Missing address or notebook ID for status check');
  return;
}

      const response = await fetch(`/api/sources/processing-status?fileId=${fileId}&notebookId=${currentNotebook?.id}&userKey=${hashedUserKey}`);
      
      const data = await response.json();

      if (data.status === 'completed') {
        updateSourceStatus(sourceId, 'completed', 100);
        
        // Refresh notebook data
        if (currentNotebook) {
          const updatedNotebook = await fetchNotebookDetails(currentNotebook.id);
          if (updatedNotebook) {
            setCurrentNotebook(updatedNotebook);
            setSources(updatedNotebook.sources || []);
          }
        }
        return;
      } else if (data.status === 'error') {
        updateSourceStatus(sourceId, 'error', 0, data.error);
        return;
      }

      // Continue polling if still processing
      attempts++;
      if (attempts < maxAttempts) {
        setTimeout(poll, 2000);
      } else {
        updateSourceStatus(sourceId, 'error', 0, 'Processing timeout');
      }
    } catch (error) {
      console.error('❌ Processing status check error:', error);
      updateSourceStatus(sourceId, 'error', 0, 'Status check failed');
    }
  };

  poll();
};

// ✅ ADD: Handle add note function
const handleAddNote = () => {
  if (!currentNotebook) {
    toast.error('Please open a notebook first');
    return;
  }

  const noteTitle = prompt('Enter note title:');
  if (!noteTitle?.trim()) return;

  const noteContent = prompt('Enter note content:');
  if (!noteContent?.trim()) return;

  // Create note source
  const noteSource: NotebookSource = {
    id: `note_${Date.now()}`,
    title: noteTitle.trim(),
    type: 'text',
    status: 'completed',
    progress: 100,
    dateCreated: new Date().toLocaleDateString(),
    content: noteContent.trim(),
    selected: true
  };

 // ✅ NEW: Add to database first, then update UI
try {
   addSourceToNotebook(noteSource);
  
  // Add to sources
  setSources(prev => [...prev, noteSource]);
  setSelectedSources(prev => new Set([...prev, noteSource.id]));
  toast.success('Note added successfully');
  console.log('✅ Note persisted to database:', noteSource.id);
} catch (error) {
  console.error('❌ Failed to add note:', error);
  toast.error('Failed to add note');
}

};


  // Fetch notebook details - ✅ FIXED: Better error handling
  const fetchNotebookDetails = async (notebookId: string): Promise<Notebook | null> => {
    if (!address) {
      return null;
    }

    try {
      const hashedUserKey = HashUtil.hashTo(address);
      const response = await fetch(`/api/notebooks/get?userKey=${hashedUserKey}&notebookId=${notebookId}`);

      if (response.ok) {
        const data = await response.json();
        return data.notebook;
      }
    } catch (error) {
      console.error('Error fetching notebook details:', error);
    }
    return null;
  };

  // Update source status
  const updateSourceStatus = (sourceId: string, status: NotebookSource['status'], progress: number, error?: string) => {
    setSources(prev => prev.map(source => 
      source.id === sourceId 
        ? { ...source, status, progress, error }
        : source
    ));
  };

  // Toggle source selection
  const toggleSourceSelection = (sourceId: string) => {
    const newSelected = new Set(selectedSources);
    if (newSelected.has(sourceId)) {
      newSelected.delete(sourceId);
    } else {
      newSelected.add(sourceId);
    }
    setSelectedSources(newSelected);
  };

  // Select all sources
  const selectAllSources = () => {
    if (selectedSources.size === sources.filter(s => s.status === 'completed').length) {
      setSelectedSources(new Set());
    } else {
      setSelectedSources(new Set(sources.filter(s => s.status === 'completed').map(s => s.id)));
    }
  };

  // Utility functions
  const formatFileSize = (bytes: number): string => {
    if (bytes === 0) return '0 Bytes';
    const k = 1024;
    const sizes = ['Bytes', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
  };

  // Drag and drop handlers
  const handleDragOver = (e: DragEvent) => {
    e.preventDefault();
    setDragActive(true);
  };

  const handleDragLeave = (e: DragEvent) => {
    e.preventDefault();
    setDragActive(false);
  };

  const handleDrop = (e: DragEvent) => {
    e.preventDefault();
    setDragActive(false);

    const files = e.dataTransfer.files;
    if (files.length > 0) {
      handleFiles(files);
    }
  };

  const handleFileInputChange = (e: ChangeEvent<HTMLInputElement>) => {
    const files = e.target.files;
    if (files && files.length > 0) {
      handleFiles(files);
    }
  };

  if (!isOpen) return null;

  return (
  <div style={{
    position: 'fixed',
    top: 0,
    left: 0,
    right: 0,
    bottom: 0,
    background: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
    display: 'flex',
    alignItems: 'center',
    justifyContent: 'center',
    zIndex: 10000
  }}>

      {/* ✅ FIXED: Show Web3SignIn when wallet not connected */}
      {!address ? (
        <div style={{
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          backgroundColor: 'rgba(0, 0, 0, 0.9)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          zIndex: 10000
        }}>
          <div style={{
            backgroundColor: '#f8f9fa',
            borderRadius: '16px',
            padding: '40px',
            maxWidth: '500px',
            width: '90%',
            position: 'relative'
          }}>
            <Web3SignIn 
              showCloseButton={true}
              onClose={onClose}
              title="Connect Your Wallet"
              subtitle="Connect your Web3 wallet to access your notebooks and manage your knowledge base."
            />
          </div>
        </div>
      ) : (
        <div style={{
          position: 'fixed',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          backgroundColor: 'rgba(0, 0, 0, 0.9)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'center',
          zIndex: 10000
        }}>
