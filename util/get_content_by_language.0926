// util/get_content_by_language.ts

import { createClient } from '@vercel/kv';
import OpenAI from 'openai';
import { acquireLock, releaseLock } from './lock';


const kv = createClient({
    url: process.env.KV_REST_API_URL!,
    token: process.env.KV_REST_API_TOKEN!,
});

const openai = new OpenAI({
    apiKey: process.env.OPENAI_API_KEY!,
});

/**
 * Translates the given description to the specified language using OpenAI.
 * @param description - The text to translate.
 * @param language - The target language.
 * @returns The translated text.
 */
async function translateDescription(description: string, language: string): Promise<string> {
    if (language.toLowerCase() === 'english' || language.toLowerCase() === 'en') {
        return description;
    }

    const prompt = `Translate the following text to ${language}. Preserve any placeholders like \${...} and formatting elements such as \\n or \\t exactly as they are. Only output the translated text without any additional comments or explanations.

"${description}"`;

    const maxRetries = 5;
    let attempt = 0;

    while (attempt < maxRetries) {
        try {
            const response = await openai.chat.completions.create({
                model: process.env.GPT_MODEL || 'gpt-3.5-turbo',
                messages: [{ role: 'user', content: prompt }],
            });

            const translatedText = response.choices[0]?.message?.content?.trim();

            if (translatedText) {
                // Successfully obtained the translated text
                return translatedText;
            } else {
                // Log and retry after waiting for 1 second
                console.warn(
                    `Attempt ${attempt + 1}: Received empty translation for ${language}. Retrying...`
                );
                attempt++;
                await new Promise((resolve) => setTimeout(resolve, 1000));
            }
        } catch (error) {
            console.error(
                `Error translating to ${language} on attempt ${attempt + 1}:`,
                error
            );
            attempt++;
            // Wait for 1 second before retrying
            await new Promise((resolve) => setTimeout(resolve, 1000));
        }
    }

    // After max retries, throw an error
    throw new Error(`Failed to translate to ${language} after ${maxRetries} attempts.`);
}

/**
 * Fetches and translates content based on the provided name and language.
 * Implements concurrency control to prevent redundant translations.
 * @param name - The key name for the content.
 * @param language - The target language.
 * @param defaultContent - Optional default content if not found in KV.
 * @returns An object containing the translated content or null.
 */
export default async function getContentByLanguage(
    name: string,
    language: string,
    defaultContent?: string
): Promise<{ content: string | null }> {
    if (!name || !language || typeof name !== 'string' || typeof language !== 'string') {
        throw new Error('Invalid parameters');
    }

    const normalizedLanguage = language;
    const contentKey = `content:${name}:${normalizedLanguage}`;

    console.log(`Fetching content for key: ${contentKey}`);

    try {
        let content = (await kv.get(contentKey)) as string | null;

        if (content) {
            console.log(`Content found in cache for key: ${contentKey}`);
        } else {
            console.log(`Content not found in cache for key: ${contentKey}`);
        }

        // Check if content is missing, empty, or previously failed
        if (
            !content ||
            content.trim() === '' ||
            content.startsWith('Failed to translate to')
        ) {
            // Define a unique lock key for this content
            const lockKey = `lock:${contentKey}`;
            const lockAcquired = await acquireLock(lockKey, 300); // 5 minutes TTL

            if (!lockAcquired) {
                console.warn(`Translation already in progress for key ${contentKey}. Waiting...`);
                // Wait for the existing translation to complete
                const maxWaitTime = 10000; // 10 seconds
                const pollInterval = 500; // 0.5 seconds
                let waited = 0;

                while (waited < maxWaitTime) {
                    await new Promise((resolve) => setTimeout(resolve, pollInterval));
                    content = (await kv.get(contentKey)) as string | null;
                    if (content && !content.startsWith('Failed to translate to')) {
                        console.log(`Content retrieved after waiting for key: ${contentKey}`);
                        return { content };
                    }
                    waited += pollInterval;
                }

                throw new Error(`Timeout waiting for translation of key ${contentKey}.`);
            }

            try {
                // Use the defaultContent or fetch from KV
                const defaultContentToTranslate = defaultContent || (await kv.get(name)) as string | null;

                if (!defaultContentToTranslate) {
                    throw new Error('Default content not found');
                }

                // Translate the content
                const translatedContent = await translateDescription(
                    defaultContentToTranslate,
                    normalizedLanguage
                );

                // Store the translated content
                await kv.set(contentKey, translatedContent);
                console.log(`Set translated content for key ${contentKey}.`);

                return { content: translatedContent };
            } catch (error) {
                console.error('Error during translation:', error);
                // Store the error message to prevent repeated attempts
                await kv.set(contentKey, `Failed to translate to ${normalizedLanguage}`);
                throw error;
            } finally {
                // Release the lock
                await releaseLock(lockKey);
                console.log(`Lock released for key ${lockKey}.`);
            }
        }

        return { content: content || null };
    } catch (error) {
        console.error('Error fetching content:', error);
        throw error;
    }
}
