    }

    .chatSelectors {
        flex-direction: column;
        align-items: flex-start;
        padding-right: 0;
        /* Remove padding on very small screens */
    }

    .selectorLabel {
        margin-right: 0;
        margin-bottom: 10px;
        font-size: 12px;
        color: black;
        /* Ensure label remains black on very small screens */
    }

    .chatDropdown {
        max-width: 100%;
        font-size: 12px;
    }

    .chatInput {
        font-size: 12px;
        padding: 8px;
        background-color: #0070f3;
        /* Ensure background remains blue */
        color: white;
        /* Ensure text is visible on blue background */
    }

    .sendButton {
        padding: 8px 16px;
        font-size: 12px;
    }

    .userMessage,
    .assistantMessage {
        max-width: 90%;
        font-size: 12px;
    }
}

