.tooltip {
    position: absolute;
    /*bottom: -200px;*/
    top: 50px;
    /* Adjust as needed */
    left: 50%;
    transform: translateX(-50%);
    background-color: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 8px 12px;
    border-radius: 4px;
    white-space: nowrap;
    font-size: 23px;
    z-index: 1000;
    /* Optional: Add transition for smooth appearance */
    opacity: 0;
    animation: fadeIn 0.3s forwards;
}

@keyframes fadeIn {
    to {
        opacity: 1;
    }
}