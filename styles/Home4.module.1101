.modalContent {
    background-color: white;
    width: 700px;
    /* Increased width for chatbot modal */
    max-width: 700px;
    height: auto;
    padding: 20px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    position: relative;
}

.closeButton {
    position: absolute;
    top: 10px;
    /* Positioned at the top */
    right: 10px;
    /* Positioned at the right */
    padding: 8px 16px;
    cursor: pointer;
    background-color: #007bff;
    color: white;
    border: none;
    border-radius: 4px;
}

/* ----------------- Chat Modal Responsive Adjustments ----------------- */
@media (max-width: 600px) {
    .modalContent {
        width: 90%;
        /* Adjust width for smaller screens */
    }

    .chatSelectors {
        flex-direction: column;
        align-items: flex-start;
        padding-right: 0;
        /* Remove padding on smaller screens */
    }

    .selectorLabel {
        margin-right: 0;
        margin-bottom: 10px;
        font-size: 14px;
        color: black;
        /* Ensure label remains black on smaller screens */
    }

    .chatDropdown {
        max-width: 100%;
        padding: 5px;
        font-size: 12px;
    }
}

@media (max-width: 480px) {
    .modalContent {
        width: 95%;
        /* Further adjust width for very small screens */
    }

    .chatSelectors {
        flex-direction: column;
        align-items: flex-start;
        padding-right: 0;
        /* Remove padding on very small screens */
    }

    .selectorLabel {
        margin-right: 0;
        margin-bottom: 10px;
        font-size: 12px;
        color: black;
        /* Ensure label remains black on very small screens */
    }

    .chatDropdown {
        max-width: 100%;
        font-size: 12px;
    }

    .chatInput {
        font-size: 12px;
        padding: 8px;
        background-color: #0070f3;
        /* Ensure background remains blue */
        color: white;
        /* Ensure text is visible on blue background */
    }

    .sendButton {
        padding: 8px 16px;
        font-size: 12px;
    }

    .userMessage,
    .assistantMessage {
        max-width: 90%;
        font-size: 12px;
    }
}

/* ----------------- Additional Utility Classes ----------------- */
.selected {
    border: 10px solid #032902;
    transform: scale(1.05);
}

/* Rating Component Styles */
.ratingAndCount {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 6px;
}

.countValue {
    margin-left: auto;
}

.stars {
    display: flex;
    justify-content: center;
    margin: 1rem 0;
}

.filledStar,
.emptyStar {
    font-size: 2rem;
    cursor: pointer;
}

.filledStar {
    color: gold;
}

.emptyStar {
    color: lightgray;
}

.submitButton {
    background-color: blue;
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    cursor: pointer;
    border-radius: 8px;
    margin: 0.5rem;
    transition: background-color 0.3s ease;
}

.submitButton:hover {
    background-color: darkblue;
}

/* Share Block */
.shareBlock {
    display: flex;
    justify-content: space-around;
    align-items: center;
    margin: 10px 0;
}

/* Ensure modal content is scrollable on small devices */
.modalContent,
.modalContent1 {
    overflow-y: auto;
}

/* ----------------- Modal Description ----------------- */
.modalDescription {
    text-align: left;
    color: #f9f5f5;
    /* Ensure text is readable */
    word-wrap: break-word;
}

/* Optional: Adjust the AutoFitText component's container */
.autoFitTextContainer {
    width: 100%;
    max-width: 250px;
    /* Adjust based on your image width */
}

/* ----------------- Checkbox Styles ----------------- */
.roleCheckbox {
    position: absolute;
    top: 1px;
    right: 1px;
    transform: scale(1.5);
    z-index: 200;
    box-shadow: 2px 1px 1px rgb(138, 2, 2);
    width: 18px;
    height: 18px;
    border: 1px solid black;
    /* Added missing semicolon */
    /* Additional styling as needed */
}

.roleCheckbox:checked {
    background-color: #4c4caf;
    border: 1px solid black;
}

.roleCheckbox:focus {
    outline: none;
    border: 1px solid black;
    /* Focus ring for accessibility */
}


.buttonTooltip {
    position: absolute;
    z-index: 10;
    padding: 0.5rem;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: bolder;
    color: #010b1b;
    background-color: rgb(215, 241, 18);
    border: 1px solid #000c1b;
    border-radius: 0.375rem;
    box-shadow: 0 1px 3px rgba(251, 95, 4, 0.913), 0 1px 2px rgba(3, 228, 248, 0.946);
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: 700%;
    display: none;
}

.buttonWrapper:hover .buttonTooltip {
    display: block;
}

