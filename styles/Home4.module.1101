.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
}

.main {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5rem 0;
}

.linkContainer {
    display: flex;
    justify-content: space-between;
    width: 100%;
}

.setupUserLink,
.uploadNFTLink {
    color: #0070f3;
    text-decoration: none;
    margin-right: 1rem;
}

.setupUserLink:hover,
.uploadNFTLink:hover {
    text-decoration: underline;
}

.navLink {
    margin: 0 1rem;
    text-decoration: none;
    color: #0070f3;
    font-size: 24px;
}

.navLink:hover {
    color: whitesmoke;

}

.hoverLogo {
    transition: transform 0.2s;
}

.hoverLogo:hover {
    transform: scale(1.1);
}

.shareButton {
    background-color: blue;
    color: white;
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 18px;
}

.freeChats {
    margin-top: 10px;
    font-size: 18px;
    color: white;
}




.shareButton:hover {
    background-color: darkblue;
}

.modal {
    background: white;
    border-radius: 8px;
    padding: 2rem;
    width: 90%;
    max-width: 500px;
    margin: 0 auto;
    position: relative;
}

.overlay {
    background: rgba(0, 0, 0, 0.75);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.modalTitle {
    margin-bottom: 1rem;
    text-align: center;
    font-size: 24px;
    color: blue;
}

.socialIcons {
    display: flex;
    justify-content: space-around;
    margin-bottom: 1rem;
}

.iconx,
.iconf,
.iconl,
.iconr {
    color: blue;
    transition: color 0.2s;
}

.iconx:hover,
.iconf:hover,
.iconl:hover,
.iconr:hover {
    color: darkblue;
}

.textarea {
    width: 100%;
    height: 100px;
    border: 2px solid #444;
    border-radius: 8px;
    padding: 0.5rem;
    margin-bottom: 1rem;
    font-size: 16px;
    resize: none;
}

.buttonContainer {
    display: flex;
    justify-content: space-between;
}

.copyButton,
.closeButton1 {
    background-color: blue;
    color: white;
    padding: 0.5rem 1rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 18px;
}

.copyButton:hover,
.closeButton1:hover {
    background-color: darkblue;
}

.hoverEffect:hover {
    color: white;
}

.modalOverlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(33, 2, 106, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
}

.modalContent {
    background: rgb(4, 2, 101);
    padding: 20px;
    border-radius: 5px;
    box-shadow: 0 2px 10px rgba(136, 2, 2, 0.3);
    width: 80%;
    height: auto;
    min-width: 200px;
    /* Example minimum width */
    min-height: 100px;
    /* Example minimum height */
    max-height: 80vh;
    /* Example: Limit the height to 80% of the viewport height */
    overflow-y: auto;
    /* Allows scrolling within the modal content if needed */
    padding-bottom: 60px;
    /* Provide enough padding at the bottom for the close button */
    position: relative;
    overflow-y: auto;
}

.closeButton {
    /* Example styles, adjust as necessary */
    position: absolute;
    bottom: 15px;
    /* Ensure this value doesn't place the button outside of the modal */
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    cursor: pointer;
    background-color: #007bff;
    /* Example background color */
    color: white;
    /* Text color */
    border: none;
    border-radius: 4px;
}

/* Add this to your Home.module.css or wherever your modal styles are defined */
.modalTitle {
    color: white;
    /* Ensuring the title color matches the modal text color */
    text-align: center;
    /* Optional: Center-align the title */
    margin-bottom: 16px;
    /* Adds some space between the title and the content */
}

.tooltip {
    position: absolute;
    background-color: black;
    color: white;
    padding: 5px;
    border-radius: 5px;
    /* Adjust positioning as needed */
    top: 90%;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    /* Additional styling */
    z-index: 1;
    /* Ensure it appears above other content */
}

.hoverMessage {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, -50%);
    background-color: rgba(0, 0, 0, 0.75);
    color: white;
    padding: 8px;
    border-radius: 5px;
    text-align: center;
    display: none;
    white-space: nowrap;
    /* Initially hidden */
}

.nftImageWrapper:hover .hoverMessage {
    display: block;
    /* Show on hover */
}



.shareBlock {
    display: flex;
    justify-content: space-around;
    /* Distributes space evenly around items */
    align-items: center;
    margin: 10px 0;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

.textarea {
    width: 100%;
    /* Full width of its container */
    height: 400px;
    /* Sufficient height */
    background-color: #fff;
    /* White background for contrast */
    color: #0a0a0a;
    /* Darker black color for text */
    border: 1px solid #ccc;
    /* Light grey border */
    padding: 10px;
    font-size: 18px;
    /* Larger font size */
    font-weight: bolder;
    /* Bolder font */
    line-height: 1.2;
    /* Adjust line height for better readability */
    /* Padding inside the textarea */
    box-sizing: border-box;
    /* Includes padding and border in the width and height */
    resize: vertical;
    /* Allow vertical resizing only */

}


.modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80%;
    /* Make modal width 80% of the viewport width */
    max-width: 1000px;
    padding: 20px;
    background: rgb(29, 238, 238);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
}

.buttonContainer {
    display: flex;
    justify-content: center;
    /* Center buttons horizontally */
    align-items: center;
    /* Align buttons vertically */
    gap: 100px;
    /* Adjust the gap to a moderate value */
    margin-top: 20px;
}


.copyButton,
.closeButton1 {
    background-color: #2806e8;
    /* Blue background */
    color: white;
    /* White text */
    border: 2px;
    padding: 10px 30px;
    /* Sufficient padding around text */
    cursor: pointer;
    border-radius: 5px;
    width: auto;
    /* Auto width based on content or minimum width */
    min-width: 40px;
    /* Ensure minimum visibility width */
}



.socialIcons {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin-top: 10px;
}

.iconx {
    color: #f4580a;
    /* Default icon color */
    transition: color 0.3s ease;
}

.iconx:hover {
    color: #c1f909;
    /* Color changes on hover */
}

.iconf {
    color: #1e0af3;
    /* Default icon color */
    transition: color 0.3s ease;
}

.iconf:hover {
    color: #f007e5;
    /* Color changes on hover */
}

.iconl {
    color: #edcc0f;
    /* Default icon color */
    transition: color 0.3s ease;
}

.iconl:hover {
    color: #f94b0c;
    /* Color changes on hover */
}

.iconr {
    color: #ed0fde;
    /* Default icon color */
    transition: color 0.3s ease;
}

.iconr:hover {
    color: #f96b0c;
    /* Color changes on hover */
}

.shareButton {
    margin-left: 10px;

    background-color: rgb(5, 22, 156);
    color: white;
    border: none;
    cursor: pointer;
    transition: background-color 0.3s;
    border: 2px;
    padding: 10px 30px;
    /* Sufficient padding around text */
    cursor: pointer;
    border-radius: 5px;
    width: auto;
    /* Auto width based on content or minimum width */
    min-width: 40px;
    /* Ensure minimum visibility width */
    box-shadow: 0px 3px 6px rgb(126, 1, 1);
    /* Adds a red shadow on hover */
}

.shareButton:hover {
    transform: scale(0.8);
    /* Shrinks the button to 80% of its size */
}

.hoverLogo {
    position: relative;
    display: inline-block;
    /* or block depending on your layout */
    transition: transform 0.3s, box-shadow 0.3s;
    cursor: pointer;
}

.hoverLogo:hover {
    transform: scale(0.9);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
}

.logoTooltip {
    visibility: visible;
    position: absolute;
    width: 220px;
    background-color: rgb(10, 167, 16);
    color: white;
    text-align: center;
    border-radius: 6px;
    padding: 5px;
    bottom: 50%;
    /* Adjust this as needed */
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    transition: visibility 0s linear 0.3s, opacity 0.3s linear;
}

.hoverLogo:hover .logoTooltip {
    visibility: visible;
    opacity: 1;
    transition-delay: 0s;
}

.modalTitle {
    text-align: center;
    font-weight: bold;
    color: rgb(8, 8, 238);
    margin-bottom: 20px;
    /* Adjust as needed */
}

/* styles/Home.module.css */
.modelItem {
    font-size: 15px;
    padding: 0.25rem 0.5rem;
    cursor: pointer;
    border-bottom: 1px solid #eee;
    transition: background-color 0.3s ease;
    /* Smooth transition for background color */
}

.modelItem:hover {
    background-color: #e40593;
    /* Change background color on hover */
}

.modelItem:last-child {
    border-bottom: none;
}

/* Container for the dropdown to ensure it is centered with space below */
.dropdownContainer {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 20px auto 40px;
    /* Adjusted bottom margin for spacing */
    width: 100%;
    min-Width: "250px";
    /* Full width to center dropdown */
}

.categoryLabel {
    margin-right: 10px;
    font-size: 16px;
    font-weight: bold;
    color: white;
    /* Ensure label is visible */
}

.dropdown {
    width: auto;
    /* Auto width based on content */
    padding: 8px 16px;
    background-color: blue;
    color: white;
    border: 1px solid #ccc;
    /* Subtle border */
    border-radius: 4px;
    /* Rounded corners for modern look */
    cursor: pointer;
    appearance: none;
    /* Removes default styling */
    outline: none;
    /* Removes focus outline */
}

.dropdown option {
    padding: 10px;
    /* Padding for better readability */
    background-color: rgb(33, 9, 251);
    /* Default background for options */
    color: rgb(246, 239, 239);
    /* Text color for readability */
}

.dropdown option:hover {
    background-color: red;
    /* Background for hover and focus on options */
    color: white;
}

.shrinking {
    transform: scale(0.7);
    transition: transform 0.3s ease;
}

.overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    font-size: 24px;
    z-index: 1000;
    /* Make sure this is above all other content */
}

/* Styles.css (or wherever your CSS is defined) */
.optionHover:hover {
    background-color: red;
}

.centeredSendAmount {
    text-align: center;
    display: block;
    margin: auto;
    font-size: 16px;
    color: white;
}

.ratingAndAmount {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
}

.ratingValue {
    margin-right: 5px;
    font-size: 14px;
    color: white;
}

.sendAmount {
    margin-left: 10px;
    font-size: 16px;
    color: white;
}

.navLink {
    margin-right: 1rem;
    color: blue;
    text-decoration: none;
}

.navLink:hover {
    color: white;
}

/* Home4.module.css */

/* Existing styles... */

/* Add this new class for hover scale effect */
.hoverScale {
    display: inline-block;
    /* Ensure the span respects the transform */
    transition: transform 0.2s ease;
}

.hoverScale:hover {
    transform: scale(0.8);
}

/* styles/Home4.module.css */

/* Existing styles... */

/* New Styles for the "Ask AI" Button */
.askAiButton {
    background-color: red;
    /* Red background */
    color: white;
    /* White text */
    box-shadow: 0px 6px 10px rgba(247, 215, 3, 0.5);
    /* Blue shadow */
    border: none;
    /* Remove default border */
    border-radius: 4px;
    /* Slightly rounded corners */
    padding: 4px 20px;
    /* Padding for size */
    cursor: pointer;
    /* Pointer cursor on hover */
    transition: transform 0.2s ease, background-color 0.2s ease;
    /* Smooth transitions */
    margin-right: 10px;
    /* Space between button and language dropdown */
    font-size: 20px;
    /* Adjust font size as needed */
    font-weight: bold;
}

.askAiButton:hover {
    transform: scale(0.7);
    /* Shrink to 70% */
    background-color: #ff6666;
    /* Light red background on hover */
}

/* ----------------- Chat Input Form Styles ----------------- */
.chatInputForm {
    display: flex;
    margin-top: 15px;
}

.chatInput {
    flex: 1;
    padding: 10px;
    border: 1px solid #010216;
    border-radius: 4px;
    font-size: 17px;
    font-weight: bolder;
    background-color: #f0f3f6;
    /* Set background to blue */

    color: rgb(21, 1, 1);
    /* Set text color to white for readability */
}

.sendButton {
    padding: 10px 20px;
    margin-left: 10px;
    background-color: #0070f3;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
    transition: background-color 0.3s ease;
}

.sendButton:hover {
    background-color: #005bb5;
}

/* ----------------- Responsive Adjustments for Chatbot ----------------- */
@media (max-width: 600px) {
    .modalContent {
        width: 90%;
        /* Adjust width for smaller screens */
    }

    .chatSelectors {
        flex-direction: column;
        align-items: flex-start;
        padding-right: 0;
        /* Remove padding on smaller screens */
    }

    .selectorLabel {
        margin-right: 0;
        margin-bottom: 10px;
        font-size: 14px;
        color: black;
        /* Ensure label remains black on smaller screens */
    }

    .chatDropdown {
        max-width: 100%;
        padding: 5px;
        font-size: 12px;
    }
}

@media (max-width: 480px) {
    .modalContent {
        width: 95%;
        /* Further adjust width for very small screens */
    }

    .chatSelectors {
        flex-direction: column;
        align-items: flex-start;
        padding-right: 0;
        /* Remove padding on very small screens */
    }

    .selectorLabel {
        margin-right: 0;
        margin-bottom: 10px;
        font-size: 12px;
        color: black;
        /* Ensure label remains black on very small screens */
    }

    .chatDropdown {
        max-width: 100%;
        font-size: 12px;
    }

    .chatInput {
        font-size: 12px;
        padding: 8px;
    }

    .sendButton {
        padding: 8px 16px;
        font-size: 12px;
    }

    .userMessage,
    .assistantMessage {
        max-width: 90%;
        font-size: 12px;
    }
}

/* ----------------- Additional Utility Classes ----------------- */
.selected {
    border: 10px solid #032902;
    transform: scale(1.05);
}

/* Rating Component Styles */
.ratingAndCount {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 6px;
}

.countValue {
    margin-left: auto;
}

.stars {
    display: flex;
    justify-content: center;
    margin: 1rem 0;
}

.filledStar,
.emptyStar {
    font-size: 2rem;
    cursor: pointer;
}

.filledStar {
    color: gold;
}

.emptyStar {
    color: lightgray;
}

.submitButton {
    background-color: blue;
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    cursor: pointer;
    border-radius: 8px;
    margin: 0.5rem;
    transition: background-color 0.3s ease;
}

.submitButton:hover {
    background-color: darkblue;
}

/* Share Block */
.shareBlock {
    display: flex;
    justify-content: space-around;
    align-items: center;
    margin: 10px 0;
}

/* Ensure modal content is scrollable on small devices */
.modalContent,
.modalContent1 {
    overflow-y: auto;
}

/* ----------------- Modal Description ----------------- */
.modalDescription {
    text-align: left;
    color: #f9f5f5;
    /* Ensure text is readable */
    word-wrap: break-word;
}

/* Optional: Adjust the AutoFitText component's container */
.autoFitTextContainer {
    width: 100%;
    max-width: 250px;
    /* Adjust based on your image width */
}

/* ----------------- Checkbox Styles ----------------- */
.roleCheckbox {
    position: absolute;
    top: 1px;
    right: 1px;
    transform: scale(1.5);
    z-index: 200;
    box-shadow: 2px 1px 1px rgb(138, 2, 2);
    width: 18px;
    height: 18px;
    border: 1px solid black;
    /* Added missing semicolon */
    /* Additional styling as needed */
}

.roleCheckbox:checked {
    background-color: #4c4caf;
    border: 1px solid black;
}

.roleCheckbox:focus {
    outline: none;
    border: 1px solid black;
    /* Focus ring for accessibility */
}

/* ----------------- Ask AI Button Styles ----------------- */


.buttonTooltip {
    position: absolute;
    z-index: 10;
    padding: 0.5rem;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: bolder;
    color: #010b1b;
    background-color: rgb(215, 241, 18);
    border: 1px solid #000c1b;
    border-radius: 0.375rem;
    box-shadow: 0 1px 3px rgba(251, 95, 4, 0.913), 0 1px 2px rgba(3, 228, 248, 0.946);
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: 700%;
    display: none;
}

.buttonWrapper:hover .buttonTooltip {
    display: block;
}

/* ----------------- Additional Modal Styles ----------------- */
.modalContent {
    background-color: white;
    width: 700px;
    /* Increased width for chatbot modal */
    max-width: 700px;
    height: auto;
    padding: 20px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    position: relative;
}

.closeButton {
    position: absolute;
    top: 10px;
    /* Positioned at the top */
    right: 10px;
    /* Positioned at the right */
    padding: 8px 16px;
    cursor: pointer;
    background-color: #007bff;
    color: white;
    border: none;
    border-radius: 4px;
}

/* ----------------- Chat Modal Responsive Adjustments ----------------- */
@media (max-width: 600px) {
    .modalContent {
        width: 90%;
