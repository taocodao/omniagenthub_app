(class{static getCanvasFingerprint(){try{var canvas=document.createElement("canvas");canvas.getContext("2d").fillText("canvas fingerprint",50,50);return canvas.toDataURL()}catch(error){console.error("Error generating canvas fingerprint:",error);return null}}static getScreenType(){try{return window.matchMedia("(pointer: coarse)").matches?"touch":window.matchMedia("(pointer: fine)").matches?"mouse":"unknown"}catch(error){console.error("Error detecting screen type:",error);return"unknown"}}static getReducedTransparency(){try{return window.matchMedia("(prefers-reduced-transparency: reduce)").matches}catch(error){console.error("Error detecting reduced transparency:",error);return null}}static getLocalStorageSupport(){try{window.localStorage.setItem("test","1");window.localStorage.removeItem("test");return!0}catch(error){console.error("Error checking localStorage support:",error);return!1}}static getCookieSupport(){try{document.cookie="cookietest=1";var cookiesEnabled=-1!==document.cookie.indexOf("cookietest=");cookiesEnabled&&(document.cookie="cookietest=1; expires=Thu, 01-Jan-1970 00:00:01 GMT");return cookiesEnabled}catch(error){console.error("Error checking cookie support:",error);return!1}}static getStorageAndCookieSupport(){return{localStorage:this.getLocalStorageSupport(),cookies:this.getCookieSupport()}}static getStorageSupport(){try{return{sessionStorage:!!window.sessionStorage,localStorage:!!window.localStorage}}catch(error){console.error("Error checking storage support:",error);return{sessionStorage:!1,localStorage:!1}}}static getWebGLFingerprint(){try{var rendererInfo,canvas=document.createElement("canvas"),gl=canvas.getContext("webgl")||canvas.getContext("experimental-webgl");return gl?(rendererInfo=gl.getExtension("WEBGL_debug_renderer_info"),gl.getParameter(rendererInfo.UNMASKED_RENDERER_WEBGL)):"WebGL Not Supported"}catch(error){console.error("Error generating WebGL fingerprint:",error);return"WebGL fingerprint generation failed"}}static getTouchSupport(){try{return"ontouchstart"in window||0<navigator.maxTouchPoints||0<navigator.msMaxTouchPoints}catch(error){console.error("Error detecting touch support:",error);return!1}}static getDeviceMemory(){try{return"deviceMemory"in navigator?navigator.deviceMemory+" GB RAM":"Device memory API not supported"}catch(error){console.error("Error getting device memory:",error);return"Device memory check failed"}}static getAudioFingerprint(){return new Promise((resolve,reject)=>{try{var AudioContext=window.OfflineAudioContext||window.webkitOfflineAudioContext;if(AudioContext){var context=new AudioContext(1,44100,44100),oscillator=context.createOscillator();oscillator.type="triangle";oscillator.frequency.value=1e4;var compressor=context.createDynamicsCompressor();compressor.threshold.value=-50;compressor.knee.value=40;compressor.ratio.value=12;compressor.attack.value=0;compressor.release.value=.25;oscillator.connect(compressor);compressor.connect(context.destination);oscillator.start(0);context.startRendering();context.oncomplete=event=>{event=event.renderedBuffer.getChannelData(0).slice(4500,5e3).reduce((acc,val)=>acc+Math.abs(val),0).toString();resolve(event)}}else resolve(null)}catch(error){console.error("Error generating audio fingerprint:",error);reject("Audio fingerprint generation failed")}})}static getMediaDeviceFingerprint(){return new Promise((resolve,reject)=>{try{navigator.mediaDevices&&navigator.mediaDevices.enumerateDevices?navigator.mediaDevices.enumerateDevices().then(devices=>{devices=devices.map(device=>({deviceId:device.deviceId,kind:device.kind,label:device.label,groupId:device.groupId}));resolve(JSON.stringify(devices))}).catch(error=>{console.error("Error enumerating media devices:",error);reject(new Error("Media device enumeration failed"))}):reject(new Error("enumerateDevices() not supported"))}catch(error){console.error("Error in getMediaDeviceFingerprint:",error);reject(new Error("Media device fingerprint generation failed"))}})}static getScreenFingerprint(){try{return{width:window.screen.width,height:window.screen.height,colorDepth:window.screen.colorDepth,pixelDepth:window.screen.pixelDepth,devicePixelRatio:window.devicePixelRatio}}catch(error){console.error("Error generating screen fingerprint:",error);return null}}static getNavigatorFingerprint(){try{return{userAgent:navigator.userAgent,language:navigator.language||navigator.userLanguage,platform:navigator.platform,hardwareConcurrency:navigator.hardwareConcurrency,maxTouchPoints:navigator.maxTouchPoints}}catch(error){console.error("Error generating navigator fingerprint:",error);return null}}static getFontFingerprint(){try{if("loading"===document.readyState)document.addEventListener("DOMContentLoaded",()=>this.getFontFingerprint());else{if(!document.body)throw new Error("Document body is not available for appending elements.");var fonts=["Arial","Courier","Verdana","Times New Roman","Wingdings"];const availableFonts=[],container=document.createElement("div");if(document.body){container.style.position="absolute";container.style.visibility="hidden";container.style.fontSize="72px";document.body.appendChild(container)}else console.error("Document body is not available for appending elements.");fonts.forEach(targetFont=>{try{container.style.fontFamily=targetFont;var targetWidth=container.clientWidth,defaultWidth=(container.style.fontFamily="monospace",container.clientWidth);targetWidth!==defaultWidth&&availableFonts.push(targetFont)}catch(fontError){console.warn(`Error checking font ${targetFont}:`,fontError)}});document.body.removeChild(container);this.availableFonts=availableFonts}}catch(error){console.error("Error generating font fingerprint:",error)}}static getTimezoneFingerprint(){try{return Intl.DateTimeFormat().resolvedOptions().timeZone}catch(error){console.error("Error getting timezone fingerprint:",error);return null}}static getCpuAndMemoryFingerprint(){try{return{cpuClass:navigator.cpuClass||"unknown",deviceMemory:navigator.deviceMemory||"unknown"}}catch(error){console.error("Error getting CPU and memory fingerprint:",error);return null}}static getArchitectureFingerprint(){try{var f=new Float32Array(1),u8=new Uint8Array(f.buffer);f[0]=1/0;f[0]-=f[0];return u8[3]}catch(error){console.error("Error getting architecture fingerprint:",error);return null}}static getColorGamut(){try{return window.matchMedia("(color-gamut: srgb)").matches?"srgb":window.matchMedia("(color-gamut: p3)").matches?"p3":window.matchMedia("(color-gamut: rec2020)").matches?"rec2020":"unknown"}catch(error){console.error("Error getting color gamut:",error);return"unknown"}}static getContrastPreference(){try{return window.matchMedia("(prefers-contrast: no-preference)").matches?"no-preference":window.matchMedia("(prefers-contrast: high)").matches?"high":window.matchMedia("(prefers-contrast: low)").matches?"low":window.matchMedia("(prefers-contrast: more)").matches?"more":window.matchMedia("(prefers-contrast: less)").matches?"less":"unknown"}catch(error){console.error("Error getting contrast preference:",error);return"unknown"}}static areCookiesEnabled(){try{return navigator.cookieEnabled}catch(error){console.error("Error checking cookie enabled status:",error);return!1}}static getForcedColors(){try{return window.matchMedia("(forced-colors: active)").matches}catch(error){console.error("Error getting forced colors preference:",error);return null}}static getHDR(){try{return window.matchMedia("(dynamic-range: high)").matches}catch(error){console.error("Error checking HDR support:",error);return!1}}static getIndexedDB(){try{return"indexedDB"in window}catch(error){console.error("Error checking IndexedDB support:",error);return!1}}static getInvertedColors(){try{return window.matchMedia("(prefers-color-scheme: dark)").matches}catch(error){console.error("Error checking inverted colors preference:",error);return!1}}static getMathFingerprint(){try{return{tan:Math.tan(Math.PI/4),cos:Math.cos(Math.PI/2),sin:Math.sin(0),sqrt:Math.sqrt(2)}}catch(error){console.error("Error getting math fingerprint:",error);return null}}static getMonochrome(){try{return window.matchMedia("(monochrome)").matches}catch(error){console.error("Error checking monochrome support:",error);return!1}}static getOpenDatabase(){try{return!!(window.indexedDB||window.mozIndexedDB||window.webkitIndexedDB||window.msIndexedDB)}catch(error){console.error("Error checking IndexedDB:",error);return!1}}static getOsCpu(){try{return navigator.oscpu||"unknown"}catch(error){console.error("Error getting OS CPU information:",error);return"unknown"}}static getPdfViewerEnabled(){try{return navigator.pdfViewerEnabled}catch(error){console.error("Error checking PDF viewer enabled status:",error);return!1}}static getReducedMotionPreference(){try{return window.matchMedia("(prefers-reduced-motion: reduce)").matches}catch(error){console.error("Error getting reduced motion preference:",error);return!1}}static getVideoCardInfo(){try{var debugInfo,canvas=document.createElement("canvas"),gl=canvas.getContext("webgl")||canvas.getContext("experimental-webgl");return gl?(debugInfo=gl.getExtension("WEBGL_debug_renderer_info"))?{vendor:gl.getParameter(debugInfo.UNMASKED_VENDOR_WEBGL),renderer:gl.getParameter(debugInfo.UNMASKED_RENDERER_WEBGL)}:{vendor:"Not supported",renderer:"Not supported"}:{vendor:"Not supported",renderer:"Not supported"}}catch(error){console.error("Error getting video card info:",error);return{vendor:"Error",renderer:"Error"}}}static async getExternalIP(){try{return(await(await fetch("https://gateway.startengine.com/get-external-protocol")).json()).ip}catch(error){console.error("Error fetching external IP:",error);return"IP retrieval failed"}}static async getBatteryStatus(){try{var battery;return"getBattery"in navigator?{level:100*(battery=await navigator.getBattery()).level,charging:battery.charging}:null}catch(error){console.error("Error getting battery status:",error);return null}}static getLanguagePreferences(){try{return navigator.languages||[navigator.language||navigator.userLanguage]}catch(error){console.error("Error getting language preferences:",error);return null}}static getScreenResolution(){try{return{width:window.screen.width,height:window.screen.height,availWidth:window.screen.availWidth,availHeight:window.screen.availHeight}}catch(error){console.error("Error getting screen resolution:",error);return null}}static getBrowserInfo(){try{return{userAgent:navigator.userAgent,vendor:navigator.vendor,appVersion:navigator.appVersion}}catch(error){console.error("Error getting browser information:",error);return null}}static getConnectionType(){try{return"connection"in navigator?navigator.connection.effectiveType||"unknown":"unknown"}catch(error){console.error("Error getting connection type:",error);return"unknown"}}static async generate(){try{var fingerprints={canvas:await this.getCanvasFingerprint(),webGL:await this.getWebGLFingerprint(),audio:await this.getAudioFingerprint(),mediaDevice:await this.getMediaDeviceFingerprint(),screen:this.getScreenFingerprint(),navigator:this.getNavigatorFingerprint(),fonts:await this.getFontFingerprint(),timezone:this.getTimezoneFingerprint(),cpuAndMemory:this.getCpuAndMemoryFingerprint(),architecture:this.getArchitectureFingerprint(),colorGamut:this.getColorGamut(),contrast:this.getContrastPreference(),cookiesEnabled:this.areCookiesEnabled(),forcedColors:this.getForcedColors(),hdr:this.getHDR(),indexedDb:this.getIndexedDB(),invertedColors:this.getInvertedColors(),math:this.getMathFingerprint(),monochrome:this.getMonochrome(),openDatabase:this.getOpenDatabase(),osCpu:this.getOsCpu(),pdfViewer:this.getPdfViewerEnabled(),reducedMotion:this.getReducedMotionPreference(),videoCard:this.getVideoCardInfo(),storageSupport:this.getStorageSupport(),screenSupport:this.getTouchSupport(),deviceMemory:this.getDeviceMemory(),reducedTransparency:this.getReducedTransparency(),screenType:this.getScreenType(),battery:await this.getBatteryStatus(),languages:this.getLanguagePreferences(),screenResolution:this.getScreenResolution(),browser:this.getBrowserInfo(),connectionType:this.getConnectionType()},externalIP=await this.getExternalIP(),fingerprintString=(fingerprints.externalIP=externalIP,JSON.stringify(fingerprints)),data=(new TextEncoder).encode(fingerprintString),hashBuffer=await crypto.subtle.digest("SHA-256",data);return Array.from(new Uint8Array(hashBuffer)).map(b=>b.toString(16).padStart(2,"0")).join("")}catch(error){console.error("Error generating fingerprint hash:",error);return null}}}).generate().then(result=>{window.customFingerprint=result}).catch(error=>{console.error("Error during fingerprint generation:",error)});