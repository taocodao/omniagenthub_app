// AdminDescriptionPopulator.tsx
import React, { useState, useEffect, useCallback, useContext } from 'react';
import { toast } from 'react-toastify';
import { LocalizationContext } from '../util/LocalizationContext';
import { LocalizedText, getLocalizedString } from '../util/LocalizedText';

interface RoleData {
    department: string;
    role: string;
}

interface PopulationStats {
    totalRoles: number;
    totalTasks: number;
    totalDescriptions: number;
    processedDescriptions: number;
    failedDescriptions: number;
    currentOperation: string;
    isRunning: boolean;
    startTime: Date | null;
    estimatedCompletion: Date | null;
    isProductionMode: boolean;
}

interface ProgressLog {
    id: number;
    timestamp: Date;
    type: 'role' | 'task' | 'error' | 'success' | 'info' | 'warning';
    message: string;
    details?: string;
}

const DEPARTMENT = "Vibe Marketing";
const NON_PROD_TASK_LIMIT = 10; // NEW: Limit for non-production mode (first role only)

const AdminDescriptionPopulator: React.FC = () => {
    const { language } = useContext(LocalizationContext);

    const [stats, setStats] = useState<PopulationStats>({
        totalRoles: 0,
        totalTasks: 0,
        totalDescriptions: 0,
        processedDescriptions: 0,
        failedDescriptions: 0,
        currentOperation: '',
        isRunning: false,
        startTime: null,
        estimatedCompletion: null,
        isProductionMode: false
    });

    const [availableLanguages, setAvailableLanguages] = useState<string[]>([]);
    const [selectedLanguages, setSelectedLanguages] = useState<string[]>([]);
    const [logs, setLogs] = useState<ProgressLog[]>([]);
    const [roles, setRoles] = useState<RoleData[]>([]);
    const [forceRegenerate, setForceRegenerate] = useState<boolean>(false);
    const [logId, setLogId] = useState<number>(0);
    const [showAdvancedOptions, setShowAdvancedOptions] = useState<boolean>(false);
    const [batchSize, setBatchSize] = useState<number>(5);
    const [delayBetweenRequests, setDelayBetweenRequests] = useState<number>(1000);
    const [isProductionMode, setIsProductionMode] = useState<boolean>(false);

    // Add this type guard function at the top of your component
    const getErrorMessage = (error: unknown): string => {
        if (error instanceof Error) return error.message;
        if (typeof error === 'string') return error;
        return String(error);
    };

    // UPDATED: Fetch available languages using the provided API
    const fetchAvailableLanguages = useCallback(async () => {
        try {
            addLog('info', 'Fetching available languages from system...');

            // Use the provided API endpoint
            const response = await fetch('/api/get-available-languages');
            if (response.ok) {
                const languages = await response.json();
                const languageArray = Array.isArray(languages) ? languages : (languages.languages || languages);
                setAvailableLanguages(languageArray);
                setSelectedLanguages([language]); // Auto-select current language
                addLog('success', `Found ${languageArray.length} available languages`, languageArray.join(', '));
            } else {
                throw new Error('API request failed');
            }
        } catch (error) {
            addLog('warning', 'API failed, using default languages', getErrorMessage(error));
            // Use the provided default languages
            const defaultLanguages = ['English', 'Español', '中文', 'العربية', 'हिन्दी', '日本語', '한국어'];
            setAvailableLanguages(defaultLanguages);
            setSelectedLanguages([language]);
            addLog('info', 'Using default language list', defaultLanguages.join(', '));
        }
    }, [language]);

    // Add log entry
    const addLog = useCallback((type: ProgressLog['type'], message: string, details?: string) => {
        setLogs(prev => [
            {
                id: logId,
                timestamp: new Date(),
                type,
                message,
                details
            },
            ...prev.slice(0, 499) // Keep only last 500 logs
        ]);
        setLogId(prev => prev + 1);
    }, [logId]);

    // Fetch all roles for the department
    const fetchRoles = useCallback(async (): Promise<RoleData[]> => {
        try {
            addLog('info', `Fetching roles from ${DEPARTMENT} department...`);

            const response = await fetch('/api/get-roles', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ department: DEPARTMENT }),
            });

            if (!response.ok) {
                throw new Error('Failed to fetch roles.');
            }

            const data: { roles: string[] } = await response.json();
            const allRoles = Array.isArray(data.roles) ? data.roles : [];

            // Filter out specific roles
            const filteredRoles = allRoles.filter(roleName =>
                roleName !== "User Research Collector" &&
                roleName !== "Favorite Task"
            );

            const roleDataArray: RoleData[] = filteredRoles.map(roleName => ({
                department: DEPARTMENT,
                role: roleName
            }));

            setRoles(roleDataArray);
            addLog('success', `Found ${roleDataArray.length} roles to process`, roleDataArray.map(r => r.role).join(', '));

            return roleDataArray;
        } catch (error) {
            addLog('error', 'Failed to fetch roles', getErrorMessage(error));
            throw error;
        }
    }, []);

    // UPDATED: Fetch tasks with production mode limit (first role only in dev mode)
    const fetchTasks = useCallback(async (department: string, role: string, isProduction: boolean = false, isFirstRole: boolean = false): Promise<string[]> => {
        try {
            const response = await fetch("/api/get-tasks", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ department, role }),
            });

            if (!response.ok) throw new Error("Failed to fetch tasks");

            const tasksData = await response.json();
            let tasks = tasksData.tasks || [];

            // UPDATED: Apply limit only for first role in non-production mode
            if (!isProduction && isFirstRole && tasks.length > NON_PROD_TASK_LIMIT) {
                addLog('warning', `Non-production mode: Limiting tasks from ${tasks.length} to ${NON_PROD_TASK_LIMIT} for FIRST role ${role}`);
                tasks = tasks.slice(0, NON_PROD_TASK_LIMIT);
            } else if (!isProduction && !isFirstRole) {
                addLog('info', `Non-production mode: Skipping all tasks for role ${role} (only processing first role)`);
                tasks = []; // No tasks for subsequent roles in dev mode
            }

            return tasks;
        } catch (error) {
            addLog('error', `Failed to fetch tasks for ${role}`, getErrorMessage(error));
            return [];
        }
    }, []);

    // Check if description already exists
    const checkDescriptionExists = useCallback(async (endpoint: string, params: any): Promise<boolean> => {
        try {
            const response = await fetch(endpoint, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(params),
            });

            if (response.ok) {
                const data = await response.json();
                return data.description &&
                    !data.description.includes("Error fetching") &&
                    !data.description.includes("Please wait") &&
                    !data.description.includes("being processed") &&
                    data.description.trim().length > 0;
            }
            return false;
        } catch (error) {
            return false;
        }
    }, []);

    // Generate role description for a specific language
    const generateRoleDescription = useCallback(async (role: RoleData, targetLanguage: string): Promise<boolean> => {
        try {
            setStats(prev => ({ ...prev, currentOperation: `Generating role description: ${role.role} (${targetLanguage})` }));

            // Check if already exists (unless force regenerate)
            if (!forceRegenerate) {
                const exists = await checkDescriptionExists("/api/get_role_description", {
                    department: role.department,
                    role: role.role,
                    language: targetLanguage
                });

                if (exists) {
                    addLog('info', `Role description already exists: ${role.role} (${targetLanguage})`);
                    return true;
                }
            }

            addLog('info', `Generating role description: ${role.role} (${targetLanguage})`);

            const response = await fetch("/api/get_role_description", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    department: role.department,
                    role: role.role,
                    language: targetLanguage
                }),
            });

            if (response.ok) {
                const data = await response.json();
                if (data.description && !data.description.includes("Error") && !data.description.includes("being processed")) {
                    addLog('success', `✅ Generated role description: ${role.role} (${targetLanguage})`);
                    return true;
                } else {
                    addLog('warning', `⚠️ Incomplete role description: ${role.role} (${targetLanguage})`, data.description || data.message);
                    return false;
                }
            } else {
                addLog('error', `❌ API error for role ${role.role} (${targetLanguage}): ${response.status}`);
                return false;
            }
        } catch (error) {
            addLog('error', `❌ Error generating role description: ${role.role} (${targetLanguage})`, getErrorMessage(error));
            return false;
        }
    }, [forceRegenerate, checkDescriptionExists]);

    // Generate task description for a specific language
    const generateTaskDescription = useCallback(async (role: RoleData, task: string, targetLanguage: string): Promise<boolean> => {
        try {
            setStats(prev => ({ ...prev, currentOperation: `Generating task description: ${task} (${role.role}, ${targetLanguage})` }));

            // Check if already exists (unless force regenerate)
            if (!forceRegenerate) {
                const exists = await checkDescriptionExists("/api/get_task_description", {
                    department: role.department,
                    role: role.role,
                    task: task,
                    language: targetLanguage
                });

                if (exists) {
                    addLog('info', `Task description already exists: ${task} (${targetLanguage})`);
                    return true;
                }
            }

            addLog('info', `Generating task description: ${task} (${role.role}, ${targetLanguage})`);

            const response = await fetch("/api/get_task_description", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    department: role.department,
                    role: role.role,
                    task: task,
                    language: targetLanguage
                }),
            });

            if (response.ok) {
                const data = await response.json();
                if (data.description && !data.description.includes("Error") && !data.description.includes("being processed")) {
                    addLog('success', `✅ Generated task description: ${task} (${targetLanguage})`);
                    return true;
                } else {
                    addLog('warning', `⚠️ Incomplete task description: ${task} (${targetLanguage})`, data.description || data.message);
                    return false;
                }
            } else {
                addLog('error', `❌ API error for task ${task} (${targetLanguage}): ${response.status}`);
                return false;
            }
        } catch (error) {
            addLog('error', `❌ Error generating task description: ${task} (${targetLanguage})`, getErrorMessage(error));
            return false;
        }
    }, [forceRegenerate, checkDescriptionExists]);

    // Calculate estimated completion time
    const calculateEstimatedCompletion = useCallback((totalDescriptions: number, processed: number, startTime: Date): Date | null => {
        if (processed === 0) return null;

        const elapsed = Date.now() - startTime.getTime();
        const avgTimePerDescription = elapsed / processed;
        const remaining = totalDescriptions - processed;
        const estimatedRemainingTime = remaining * avgTimePerDescription;

        return new Date(Date.now() + estimatedRemainingTime);
    }, []);

    // UPDATED: Main population function with corrected dev mode logic
    const populateAllDescriptions = useCallback(async () => {
        if (stats.isRunning) return;

        const startTime = new Date();
        setStats(prev => ({
            ...prev,
            isRunning: true,
            processedDescriptions: 0,
            failedDescriptions: 0,
            startTime,
            currentOperation: 'Initializing...',
            isProductionMode
        }));

        // Log production mode status
        if (isProductionMode) {
            addLog('success', '🚀 Starting PRODUCTION mode - processing ALL roles and ALL tasks...');
        } else {
            addLog('warning', `🧪 Starting NON-PRODUCTION mode - processing FIRST role only with max ${NON_PROD_TASK_LIMIT} tasks...`);
        }

        addLog('info', `Configuration: Production: ${isProductionMode}, Batch size: ${batchSize}, Delay: ${delayBetweenRequests}ms, Force regenerate: ${forceRegenerate}`);

        try {
            // Fetch all roles and calculate total work
            const rolesList = await fetchRoles();

            // UPDATED: Calculate total descriptions with corrected dev mode logic
            let totalTasks = 0;
            const roleTaskMap = new Map<string, string[]>();

            for (let i = 0; i < rolesList.length; i++) {
                const role = rolesList[i];
                const isFirstRole = i === 0;
                const tasks = await fetchTasks(role.department, role.role, isProductionMode, isFirstRole);
                roleTaskMap.set(role.role, tasks);
                totalTasks += tasks.length;

                // UPDATED: Enhanced logging for dev mode
                if (isProductionMode) {
                    addLog('info', `Role ${role.role}: ${tasks.length} tasks (all tasks)`);
                } else {
                    if (isFirstRole) {
                        addLog('info', `Role ${role.role}: ${tasks.length} tasks (first role, limited to ${NON_PROD_TASK_LIMIT})`);
                    } else {
                        addLog('info', `Role ${role.role}: ${tasks.length} tasks (skipped in dev mode)`);
                    }
                }
            }

            const totalRoleDescriptions = rolesList.length * selectedLanguages.length;
            const totalTaskDescriptions = totalTasks * selectedLanguages.length;
            const totalDescriptions = totalRoleDescriptions + totalTaskDescriptions;

            setStats(prev => ({
                ...prev,
                totalRoles: rolesList.length,
                totalTasks: totalTasks,
                totalDescriptions
            }));

            // UPDATED: Enhanced logging for production vs non-production
            addLog('info', `📊 Work calculation (${isProductionMode ? 'PRODUCTION' : 'NON-PRODUCTION'} mode):`);
            addLog('info', `  • ${rolesList.length} roles × ${selectedLanguages.length} languages = ${totalRoleDescriptions} role descriptions`);
            addLog('info', `  • ${totalTasks} tasks × ${selectedLanguages.length} languages = ${totalTaskDescriptions} task descriptions`);
            addLog('info', `  • Grand total: ${totalDescriptions} descriptions to process`);

            if (!isProductionMode) {
                addLog('warning', `⚠️ NON-PRODUCTION MODE: Only processing FIRST role with max ${NON_PROD_TASK_LIMIT} tasks`);
            }

            let processedDescriptions = 0;
            let failedDescriptions = 0;
            const batch: Promise<boolean>[] = [];

            // Process role descriptions in batches
            addLog('info', '📝 Starting role description generation...');
            for (const role of rolesList) {
                for (const targetLanguage of selectedLanguages) {
                    batch.push(generateRoleDescription(role, targetLanguage));

                    if (batch.length >= batchSize) {
                        const results = await Promise.all(batch);
                        processedDescriptions += results.filter(r => r).length;
                        failedDescriptions += results.filter(r => !r).length;

                        setStats(prev => ({
                            ...prev,
                            processedDescriptions,
                            failedDescriptions,
                            estimatedCompletion: calculateEstimatedCompletion(totalDescriptions, processedDescriptions, startTime)
                        }));

                        batch.length = 0; // Clear batch
                        await new Promise(resolve => setTimeout(resolve, delayBetweenRequests));
                    }
                }
            }

            // Process remaining role descriptions
            if (batch.length > 0) {
                const results = await Promise.all(batch);
                processedDescriptions += results.filter(r => r).length;
                failedDescriptions += results.filter(r => !r).length;
                batch.length = 0;
            }

            addLog('success', `✅ Role descriptions completed: ${processedDescriptions - failedDescriptions} successful, ${failedDescriptions} failed`);

            // Process task descriptions in batches
            addLog('info', '📋 Starting task description generation...');
            for (let i = 0; i < rolesList.length; i++) {
                const role = rolesList[i];
                const tasks = roleTaskMap.get(role.role) || [];
                const isFirstRole = i === 0;

                // UPDATED: Enhanced logging for dev mode
                if (isProductionMode) {
                    addLog('info', `Processing ALL ${tasks.length} tasks for role: ${role.role}`);
                } else {
                    if (isFirstRole) {
                        addLog('info', `Processing ${tasks.length} tasks for FIRST role: ${role.role} (max ${NON_PROD_TASK_LIMIT})`);
                    } else {
                        addLog('info', `Skipping role: ${role.role} (dev mode - first role only)`);
                        continue; // Skip subsequent roles in dev mode
                    }
                }

                for (const task of tasks) {
                    for (const targetLanguage of selectedLanguages) {
                        batch.push(generateTaskDescription(role, task, targetLanguage));

                        if (batch.length >= batchSize) {
                            const results = await Promise.all(batch);
                            processedDescriptions += results.filter(r => r).length;
                            failedDescriptions += results.filter(r => !r).length;

                            setStats(prev => ({
                                ...prev,
                                processedDescriptions,
                                failedDescriptions,
                                estimatedCompletion: calculateEstimatedCompletion(totalDescriptions, processedDescriptions, startTime)
                            }));

                            batch.length = 0; // Clear batch
                            await new Promise(resolve => setTimeout(resolve, delayBetweenRequests));
                        }
                    }
                }
            }

            // Process remaining task descriptions
            if (batch.length > 0) {
                const results = await Promise.all(batch);
                processedDescriptions += results.filter(r => r).length;
                failedDescriptions += results.filter(r => !r).length;
            }

            const endTime = new Date();
            const totalTime = endTime.getTime() - startTime.getTime();
            const totalTimeMinutes = Math.round(totalTime / 60000);

            // Enhanced completion logging
            addLog('success', '🎉 Description population completed!');
            addLog('info', `📊 Final Statistics (${isProductionMode ? 'PRODUCTION' : 'NON-PRODUCTION'} mode):`);
            addLog('info', `  • Total processed: ${processedDescriptions + failedDescriptions}`);
            addLog('info', `  • Successful: ${processedDescriptions}`);
            addLog('info', `  • Failed: ${failedDescriptions}`);
            addLog('info', `  • Processing time: ${totalTimeMinutes} minutes`);

            if (!isProductionMode) {
                addLog('warning', `⚠️ NON-PRODUCTION MODE: Limited processing completed (first role only). Use production mode for full processing.`);
            }

            toast.success(await getLocalizedString(`Population completed! Mode: ${isProductionMode ? 'PRODUCTION' : 'NON-PRODUCTION'}. Processed: ${processedDescriptions} descriptions successfully. Failed: ${failedDescriptions}. Time: ${totalTimeMinutes} minutes.`, language));

        } catch (error) {
            addLog('error', '❌ Fatal error during population', getErrorMessage(error));
            toast.error(await getLocalizedString('Population failed with fatal error', language));
        } finally {
            setStats(prev => ({
                ...prev,
                isRunning: false,
                currentOperation: 'Completed',
                estimatedCompletion: null
            }));
        }
    }, [
        stats.isRunning, selectedLanguages, forceRegenerate, batchSize, delayBetweenRequests, isProductionMode,
        fetchRoles, fetchTasks, generateRoleDescription, generateTaskDescription,
        calculateEstimatedCompletion, language
    ]);

    // Initialize on component mount
    useEffect(() => {
        fetchAvailableLanguages();
    }, [fetchAvailableLanguages]);

    // Handle language selection
    const handleLanguageToggle = (targetLanguage: string) => {
        setSelectedLanguages(prev =>
            prev.includes(targetLanguage)
                ? prev.filter(l => l !== targetLanguage)
                : [...prev, targetLanguage]
        );
    };

    // Handle select all languages
    const handleSelectAllLanguages = () => {
        setSelectedLanguages([...availableLanguages]);
    };

    // Handle deselect all languages
    const handleDeselectAllLanguages = () => {
        setSelectedLanguages([]);
    };

    return (
        <div style={{ padding: '2rem', maxWidth: '1400px', margin: '0 auto' }}>
            <h1><LocalizedText name="🔧 Admin: Comprehensive Description Populator" /></h1>
            <p><LocalizedText name={`Generate and populate ALL role and task descriptions for ${DEPARTMENT} department in multiple languages`} /></p>

            {/* Configuration Panel */}
            <div style={{
                backgroundColor: '#f8f9fa',
                padding: '1.5rem',
                borderRadius: '12px',
                marginBottom: '1.5rem',
                border: '1px solid #dee2e6'
            }}>
                <h3><LocalizedText name="⚙️ Configuration" /></h3>

                {/* Production Mode Checkbox */}
                <div style={{
                    marginBottom: '1.5rem',
                    padding: '1rem',
                    backgroundColor: isProductionMode ? '#d4edda' : '#fff3cd',
                    border: `2px solid ${isProductionMode ? '#c3e6cb' : '#ffeaa7'}`,
                    borderRadius: '8px'
                }}>
                    <label style={{ display: 'flex', alignItems: 'center', gap: '0.75rem', cursor: 'pointer' }}>
                        <input
                            type="checkbox"
                            checked={isProductionMode}
                            onChange={(e) => setIsProductionMode(e.target.checked)}
                            disabled={stats.isRunning}
                            style={{
                                width: "20px",
                                height: "20px",
                                cursor: "pointer"
                            }}
                        />
                        <div>
                            <div style={{ fontWeight: 'bold', fontSize: '16px', color: isProductionMode ? '#155724' : '#856404' }}>
                                {isProductionMode ? '🚀 Production Mode' : '🧪 Development Mode'}
                            </div>
                            <div style={{ fontSize: '14px', color: isProductionMode ? '#155724' : '#856404', marginTop: '0.25rem' }}>
                                {isProductionMode
                                    ? <LocalizedText name="Process ALL roles and ALL tasks (full production run)" />
                                    : <LocalizedText name={`Process FIRST role only with max ${NON_PROD_TASK_LIMIT} tasks (development testing)`} />
                                }
                            </div>
                        </div>
                    </label>
                </div>

                {/* Language Selection */}
                <div style={{ marginBottom: '1.5rem' }}>
                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '0.5rem' }}>
                        <label style={{ fontWeight: 'bold' }}>
                            <LocalizedText name="Select Languages to Process:" /> ({selectedLanguages.length}/{availableLanguages.length})
                        </label>
                        <div style={{ display: 'flex', gap: '0.5rem' }}>
                            <button
                                onClick={handleSelectAllLanguages}
                                disabled={stats.isRunning}
                                style={{
                                    padding: '0.25rem 0.5rem',
                                    fontSize: '12px',
                                    backgroundColor: '#28a745',
                                    color: 'white',
                                    border: 'none',
                                    borderRadius: '4px',
                                    cursor: stats.isRunning ? 'not-allowed' : 'pointer'
                                }}
                            >
                                <LocalizedText name="Select All" />
                            </button>
                            <button
                                onClick={handleDeselectAllLanguages}
                                disabled={stats.isRunning}
                                style={{
                                    padding: '0.25rem 0.5rem',
                                    fontSize: '12px',
                                    backgroundColor: '#dc3545',
                                    color: 'white',
                                    border: 'none',
                                    borderRadius: '4px',
                                    cursor: stats.isRunning ? 'not-allowed' : 'pointer'
                                }}
                            >
                                <LocalizedText name="Deselect All" />
                            </button>
                        </div>
                    </div>
                    <div style={{
                        display: 'grid',
                        gridTemplateColumns: 'repeat(auto-fill, minmax(120px, 1fr))',
                        gap: '0.5rem',
                        maxHeight: '150px',
                        overflowY: 'auto',
                        padding: '0.5rem',
                        border: '1px solid #ddd',
                        borderRadius: '4px',
                        backgroundColor: 'white'
                    }}>
                        {availableLanguages.map(availableLanguage => (
                            <label key={availableLanguage} style={{
                                display: 'flex',
                                alignItems: 'center',
                                gap: '0.25rem',
                                fontSize: '14px',
                                cursor: 'pointer'
                            }}>
                                <input
                                    type="checkbox"
                                    checked={selectedLanguages.includes(availableLanguage)}
                                    onChange={() => handleLanguageToggle(availableLanguage)}
                                    disabled={stats.isRunning}
                                />
                                <LocalizedText name={availableLanguage} />
                            </label>
                        ))}
                    </div>
                </div>

                {/* Advanced Options */}
                <div style={{ marginBottom: '1rem' }}>
                    <button
                        onClick={() => setShowAdvancedOptions(!showAdvancedOptions)}
                        style={{
                            backgroundColor: 'transparent',
                            border: '1px solid #6c757d',
                            padding: '0.5rem 1rem',
                            borderRadius: '4px',
                            cursor: 'pointer',
                            marginBottom: '1rem'
                        }}
                    >
                        <LocalizedText name={showAdvancedOptions ? "Hide Advanced Options" : "Show Advanced Options"} />
                    </button>

                    {showAdvancedOptions && (
                        <div style={{
                            backgroundColor: 'white',
                            padding: '1rem',
                            borderRadius: '8px',
                            border: '1px solid #ddd',
                            display: 'grid',
                            gridTemplateColumns: 'repeat(auto-fit, minmax(250px, 1fr))',
                            gap: '1rem'
                        }}>
                            <div>
                                <label style={{ display: 'block', marginBottom: '0.5rem', fontWeight: 'bold' }}>
                                    <LocalizedText name="Batch Size (concurrent requests):" />
                                </label>
                                <input
                                    type="number"
                                    min="1"
                                    max="20"
                                    value={batchSize}
                                    onChange={(e) => setBatchSize(parseInt(e.target.value))}
                                    disabled={stats.isRunning}
                                    style={{
                                        width: '100%',
                                        padding: '0.5rem',
                                        border: '1px solid #ddd',
                                        borderRadius: '4px'
                                    }}
                                />
                                <small style={{ color: '#666', fontSize: '12px' }}>
                                    <LocalizedText name="Higher = faster but more API load" />
                                </small>
                            </div>

                            <div>
                                <label style={{ display: 'block', marginBottom: '0.5rem', fontWeight: 'bold' }}>
                                    <LocalizedText name="Delay Between Batches (ms):" />
                                </label>
                                <input
                                    type="number"
                                    min="100"
                                    max="5000"
                                    step="100"
                                    value={delayBetweenRequests}
                                    onChange={(e) => setDelayBetweenRequests(parseInt(e.target.value))}
                                    disabled={stats.isRunning}
                                    style={{
                                        width: '100%',
                                        padding: '0.5rem',
                                        border: '1px solid #ddd',
                                        borderRadius: '4px'
                                    }}
                                />
                                <small style={{ color: '#666', fontSize: '12px' }}>
                                    <LocalizedText name="Higher = slower but safer for APIs" />
                                </small>
                            </div>
                        </div>
                    )}
                </div>

                {/* Force Regenerate Option */}
                <div style={{ marginBottom: '1.5rem' }}>
                    <label style={{ display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                        <input
                            type="checkbox"
                            checked={forceRegenerate}
                            onChange={(e) => setForceRegenerate(e.target.checked)}
                            disabled={stats.isRunning}
                        />
                        <strong><LocalizedText name="Force Regenerate All Descriptions" /></strong>
                    </label>
                    <small style={{ color: '#666', marginLeft: '1.5rem' }}>
                        <LocalizedText name="Check this to regenerate existing descriptions. Warning: This will significantly increase processing time!" />
                    </small>
                </div>

                {/* Action Buttons */}
                <div style={{ display: 'flex', gap: '1rem', flexWrap: 'wrap' }}>
                    <button
                        onClick={populateAllDescriptions}
                        disabled={stats.isRunning || selectedLanguages.length === 0}
                        style={{
                            padding: '1rem 2rem',
                            backgroundColor: stats.isRunning ? '#6c757d' : (isProductionMode ? '#dc3545' : '#28a745'),
                            color: 'white',
                            border: 'none',
                            borderRadius: '8px',
                            cursor: stats.isRunning || selectedLanguages.length === 0 ? 'not-allowed' : 'pointer',
                            fontSize: '16px',
                            fontWeight: 'bold',
                            flex: '1',
                            minWidth: '200px'
                        }}
                    >
                        {stats.isRunning ? (
                            <LocalizedText name="🔄 Processing..." />
                        ) : (
                            isProductionMode ? (
                                <LocalizedText name="🚀 Start PRODUCTION Population" />
                            ) : (
                                <LocalizedText name="🧪 Start DEVELOPMENT Population" />
                            )
                        )}
                    </button>

                    <button
                        onClick={() => setLogs([])}
                        disabled={stats.isRunning}
                        style={{
                            padding: '1rem 1.5rem',
                            backgroundColor: '#dc3545',
                            color: 'white',
                            border: 'none',
                            borderRadius: '8px',
                            cursor: stats.isRunning ? 'not-allowed' : 'pointer'
                        }}
                    >
                        <LocalizedText name="🗑️ Clear Logs" />
                    </button>
                </div>

                {selectedLanguages.length === 0 && (
                    <div style={{ marginTop: '1rem', padding: '0.75rem', backgroundColor: '#fff3cd', border: '1px solid #ffeaa7', borderRadius: '4px' }}>
                        <strong style={{ color: '#856404' }}>
                            <LocalizedText name="⚠️ Please select at least one language to proceed." />
                        </strong>
                    </div>
                )}
            </div>

            {/* Progress Panel */}
            <div style={{
                backgroundColor: '#e7f3ff',
                padding: '1.5rem',
                borderRadius: '12px',
                marginBottom: '1.5rem',
                border: '1px solid #b3d9ff'
            }}>
                <h3><LocalizedText name="📊 Progress Dashboard" /></h3>

                {/* Production Mode Status */}
                {stats.isRunning && (
                    <div style={{
                        marginBottom: '1rem',
                        padding: '0.75rem',
                        backgroundColor: stats.isProductionMode ? '#d4edda' : '#fff3cd',
                        border: `1px solid ${stats.isProductionMode ? '#c3e6cb' : '#ffeaa7'}`,
                        borderRadius: '6px',
                        textAlign: 'center',
                        fontWeight: 'bold',
                        color: stats.isProductionMode ? '#155724' : '#856404'
                    }}>
                        {stats.isProductionMode
                            ? <LocalizedText name="🚀 PRODUCTION MODE: Processing ALL tasks" />
                            : <LocalizedText name={`🧪 DEVELOPMENT MODE: Processing FIRST role only (max ${NON_PROD_TASK_LIMIT} tasks)`} />
                        }
                    </div>
                )}

                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))', gap: '1rem', marginBottom: '1rem' }}>
                    <div style={{ textAlign: 'center', padding: '1rem', backgroundColor: 'white', borderRadius: '8px' }}>
                        <div style={{ fontSize: '24px', fontWeight: 'bold', color: '#28a745' }}>
                            {stats.processedDescriptions}
                        </div>
                        <div><LocalizedText name="Successful" /></div>
                    </div>
                    <div style={{ textAlign: 'center', padding: '1rem', backgroundColor: 'white', borderRadius: '8px' }}>
                        <div style={{ fontSize: '24px', fontWeight: 'bold', color: '#dc3545' }}>
                            {stats.failedDescriptions}
                        </div>
                        <div><LocalizedText name="Failed" /></div>
                    </div>
                    <div style={{ textAlign: 'center', padding: '1rem', backgroundColor: 'white', borderRadius: '8px' }}>
                        <div style={{ fontSize: '24px', fontWeight: 'bold', color: '#007bff' }}>
                            {stats.totalDescriptions}
                        </div>
                        <div><LocalizedText name="Total Target" /></div>
                    </div>
                    <div style={{ textAlign: 'center', padding: '1rem', backgroundColor: 'white', borderRadius: '8px' }}>
                        <div style={{ fontSize: '24px', fontWeight: 'bold', color: '#6c757d' }}>
                            {stats.totalDescriptions > 0 ? Math.round((stats.processedDescriptions + stats.failedDescriptions) / stats.totalDescriptions * 100) : 0}%
                        </div>
                        <div><LocalizedText name="Complete" /></div>
                    </div>
                </div>

                {stats.isRunning && (
                    <div style={{ marginTop: '1rem' }}>
                        <div style={{ marginBottom: '0.5rem' }}>
                            <strong><LocalizedText name="Current Operation:" /></strong> {stats.currentOperation}
                        </div>
                        {stats.estimatedCompletion && (
                            <div style={{ marginBottom: '0.5rem' }}>
                                <strong><LocalizedText name="Estimated Completion:" /></strong> {stats.estimatedCompletion.toLocaleTimeString()}
                            </div>
                        )}
                        {stats.startTime && (
                            <div style={{ marginBottom: '0.5rem' }}>
                                <strong><LocalizedText name="Running Time:" /></strong> {Math.round((Date.now() - stats.startTime.getTime()) / 60000)} minutes
                            </div>
                        )}
                    </div>
                )}

                {/* Progress Bar */}
                {stats.totalDescriptions > 0 && (
                    <div style={{ marginTop: '1rem' }}>
                        <div style={{ marginBottom: '0.5rem' }}>
                            <LocalizedText name="Overall Progress:" /> {stats.processedDescriptions + stats.failedDescriptions}/{stats.totalDescriptions}
                        </div>
                        <div style={{
                            width: '100%',
                            backgroundColor: '#f0f0f0',
                            borderRadius: '10px',
                            overflow: 'hidden',
                            height: '20px'
                        }}>
                            <div style={{
                                width: `${((stats.processedDescriptions + stats.failedDescriptions) / stats.totalDescriptions) * 100}%`,
                                backgroundColor: stats.failedDescriptions > 0 ? '#ffc107' : '#28a745',
                                height: '100%',
                                transition: 'width 0.3s ease',
                                display: 'flex',
                                alignItems: 'center',
                                justifyContent: 'center',
                                color: 'white',
                                fontSize: '12px',
                                fontWeight: 'bold'
                            }}>
                                {stats.totalDescriptions > 0 ? Math.round(((stats.processedDescriptions + stats.failedDescriptions) / stats.totalDescriptions) * 100) : 0}%
                            </div>
                        </div>
                    </div>
                )}
            </div>

            {/* Logs Panel */}
            <div style={{
                backgroundColor: '#f8f9fa',
                padding: '1.5rem',
                borderRadius: '12px',
                border: '1px solid #dee2e6'
            }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '1rem' }}>
                    <h3><LocalizedText name="📝 Activity Log" /></h3>
                    <div style={{ fontSize: '14px', color: '#6c757d' }}>
                        {logs.length} entries (last 500 shown)
                    </div>
                </div>

                <div style={{
                    maxHeight: '500px',
                    overflowY: 'auto',
                    backgroundColor: 'white',
                    padding: '1rem',
                    borderRadius: '8px',
                    border: '1px solid #dee2e6',
                    fontFamily: 'Monaco, Consolas, "Lucida Console", monospace',
                    fontSize: '13px'
                }}>
                    {logs.length === 0 ? (
                        <div style={{ color: '#6c757d', fontStyle: 'italic', textAlign: 'center', padding: '2rem' }}>
                            <LocalizedText name="No activity logs yet. Start the population process to see real-time progress." />
                        </div>
                    ) : (
                        logs.map(log => (
                            <div
                                key={log.id}
                                style={{
                                    marginBottom: '0.75rem',
                                    padding: '0.5rem',
                                    borderLeft: `4px solid ${log.type === 'error' ? '#dc3545' :
                                        log.type === 'success' ? '#28a745' :
                                            log.type === 'warning' ? '#ffc107' :
                                                log.type === 'info' ? '#17a2b8' : '#6c757d'
                                        }`,
                                    backgroundColor: log.type === 'error' ? '#f8f9fa' : 'transparent',
                                    borderRadius: '0 4px 4px 0'
                                }}
                            >
                                <div style={{
                                    display: 'flex',
                                    justifyContent: 'space-between',
                                    alignItems: 'flex-start',
                                    marginBottom: log.details ? '0.25rem' : '0'
                                }}>
                                    <span style={{
                                        color: log.type === 'error' ? '#dc3545' : '#333',
                                        fontWeight: log.type === 'error' ? 'bold' : 'normal',
                                        flex: 1
                                    }}>
                                        {log.message}
                                    </span>
                                    <span style={{
                                        fontSize: '11px',
                                        color: '#6c757d',
                                        marginLeft: '1rem',
                                        flexShrink: 0
                                    }}>
                                        {log.timestamp.toLocaleTimeString()}
                                    </span>
                                </div>
                                {log.details && (
                                    <div style={{
                                        fontSize: '11px',
                                        color: '#6c757d',
                                        wordBreak: 'break-word',
                                        fontStyle: 'italic',
                                        paddingLeft: '0.5rem',
                                        borderLeft: '2px solid #e9ecef',
                                        marginLeft: '0.5rem'
                                    }}>
                                        {log.details}
                                    </div>
                                )}
                            </div>
                        ))
                    )}
                </div>
            </div>
        </div>
    );
};

export default AdminDescriptionPopulator;
