import { useActiveAccount } from "thirdweb/react";
import styles from "../styles/ChatHome1.module.css";
import Navbar from "../components/Navbar";
import { useState, useEffect, useRef, useCallback, useContext, ChangeEvent } from "react";
import SignIn from "../components/SignIn";
import RatingComponent from '../components/RatingComponent';
import Head from 'next/head';
import { useSharedContext } from "../context/SharedContext";
import { useRouter } from 'next/router';
import ChatBase from '../components/ChatBase';
import { LocalizedText, getLocalizedString } from '../util/LocalizedText';
import { LocalizationContext } from '../util/LocalizationContext';
import { usePayment } from '../hook/Payment_Process';
import { UPLOAD_FILE_FEE, PLATFORM_NAME } from '../constants/constants'; // Import constants
import { toast } from 'react-toastify';
import TaskItem from '../components/TaskItem';
import RoleItem from '../components/RoleItem';
import axios from 'axios'

interface RoleData {
    department: string;
    role: string;
}

interface LocalizedMessages {
    cleanupSuccess: string;
    cleanupFailed: string;
    cleanupError: string;
    translateFailed: string;
    uploadSuccess: string;
    uploadFailed: string;
}

const ChatHome: React.FC = () => {
    const { language, setLanguage } = useContext(LocalizationContext);
    const account = useActiveAccount();
    const address = account?.address;
    const [selectedRole, setSelectedRole] = useState<RoleData | null>(null);
    const [roles, setRoles] = useState<RoleData[]>([]);
    const [tasks, setTasks] = useState<string[]>([]);
    const [selectedTask, setSelectedTask] = useState<string | null>(null);
    const [isRatingModalOpen, setIsRatingModalOpen] = useState(false);
    // Inside your ChatHome component

    const {
        freeChatsLeft,
        setFreeChatsLeft,
        freeUploadsLeft,
        setFreeUploadsLeft,
        freeCustomGPTLeft,
        setFreeCustomGPTLeft
    } = useSharedContext();

    const [isRoleModalOpen, setIsRoleModalOpen] = useState(false);
    const [isTaskModalOpen, setIsTaskModalOpen] = useState(false);
    const [modalContent, setModalContent] = useState("");
    const [isModalVisible, setIsModalVisible] = useState(false);
    const [selectedRating, setSelectedRating] = useState<number | null>(null);
    const router = useRouter();
    const roleButtonRef = useRef<HTMLDivElement>(null);
    const taskButtonRef = useRef<HTMLDivElement>(null);
    const [selectedFile, setSelectedFile] = useState<File | null>(null);
    const fileInputRef = useRef<HTMLInputElement>(null);
    const [isRoleDropdownOpen, setIsRoleDropdownOpen] = useState(false);
    const [isTaskDropdownOpen, setIsTaskDropdownOpen] = useState(false);
    const [shouldCloseModal, setShouldCloseModal] = useState(false);
    const [isModalOpen, setIsModalOpen] = useState(false);
    const [textInput, setTextInput] = useState('');
    const [availableLanguages, setAvailableLanguages] = useState<string[]>([]);
    const [selectedLanguage, setSelectedLanguage] = useState<string>("English");
    const [languages, setLanguages] = useState<string[]>([]);
    const [taskDescription, setTaskDescription] = useState<string | null>(null);
    const [hoveredTask, setHoveredTask] = useState<string | null>(null);
    const { process_payment, isPaymentProcessing } = usePayment();
    // Add these state variables at the top of your component
    const [isTaskModalVisible, setIsTaskModalVisible] = useState(false);
    const [modalPosition, setModalPosition] = useState({ top: 0, left: 0 });
    const [isTooltipVisible, setIsTooltipVisible] = useState(false);
    const modalRef = useRef<HTMLDivElement>(null);
    const [activeButton, setActiveButton] = useState<string | null>(null);
    const [isRoleModalVisible, setIsRoleModalVisible] = useState(false);
    const [roleModalPosition, setRoleModalPosition] = useState({ top: 0, left: 0 });
    const [roleDescription, setRoleDescription] = useState<string | null>(null);
    const [activeRoleButton, setActiveRoleButton] = useState<string | null>(null); // Track the active role button
    // Add this at the top of your component
    const hasAddedFavoriteFromURL = useRef(false);
    const [selectedDepartment, setSelectedDepartment] = useState<string | null>(null);
    const [isFavoriteTasksLoaded, setIsFavoriteTasksLoaded] = useState<boolean>(false);
    // New state variable to control execution
    const [isChatRunning, setIsChatRunning] = useState(false);
    // **Added state variable for favorite tasks**
    const [favoriteTasks, setFavoriteTasks] = useState<string[]>([]);
    // **Added state variable for Run button disabled status**
    const [isRunButtonDisabled, setIsRunButtonDisabled] = useState(false);
    const [isRunButtonHovered, setIsRunButtonHovered] = useState(false);

    const handleDescriptionMouseEnter = () => {
        setIsTooltipVisible(true);
    };

    const handleDescriptionMouseLeave = () => {
        setIsTooltipVisible(false);
    };

    // Function to fetch and set user perks
    const fetchUserPerks = useCallback(async () => {
        if (!address) return;

        try {
            const response = await fetch(`/api/get-user-perks?userAddress=${encodeURIComponent(address)}`);
            if (response.ok) {
                const data = await response.json();
                setFreeChatsLeft(data.freeTrades);
                setFreeUploadsLeft(data.freeUploads);
                setFreeCustomGPTLeft(data.freeCustomGPT);
            } else {
                const errorData = await response.json();
                toast.error(errorData.message || 'Failed to retrieve perks.');
            }
        } catch (error) {
            console.error('Error fetching user perks:', error);
            toast.error('An unexpected error occurred while fetching perks.');
        }
    }, [address, setFreeChatsLeft, setFreeUploadsLeft, setFreeCustomGPTLeft]);

    // Fetch user perks when the component mounts or when the address changes
    useEffect(() => {
        if (address) {
            fetchUserPerks();
        } else {
            // Reset balances when address is not available
            setFreeChatsLeft(null);
            setFreeUploadsLeft(null);
            setFreeCustomGPTLeft(null);
        }
    }, [address, fetchUserPerks, setFreeChatsLeft, setFreeUploadsLeft, setFreeCustomGPTLeft]);

    const addFavorite = useCallback(async (task: string) => {
        if (!address || !selectedRole) return;

        if (favoriteTasks.includes(task)) return; // Task is already a favorite

        try {
            const response = await fetch('/api/add-task-favorite', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    userAddress: address,
                    department: selectedRole.department,
                    role: selectedRole.role,
                    task: task,
                }),
            });

            if (!response.ok) throw new Error('Failed to add favorite task');

            // Update the local state
            setFavoriteTasks(prev => [...prev, task]);

            // Display localized toast notification
            toast.info(
                <LocalizedText name={`Task ${task} Favorited`} />,
                {
                    style: {
                        backgroundColor: '#4CAF50', // Green for favorited
                        color: '#fff',
                    },
                }
            );

        } catch (error) {
            console.error('Error adding favorite task:', error);
            // Optionally, display an error toast
            toast.error(
                <LocalizedText name="Failed To Update Favorite" />
            );
        }
    }, [address, selectedRole, favoriteTasks]);


    const fetchFavoriteTasks = async () => {
        if (!address || !selectedRole) return;

        try {
            const response = await fetch('/api/get-task-favorites', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    userAddress: address,
                    department: selectedRole.department,
                    role: selectedRole.role,
                }),
            });

            if (!response.ok) throw new Error('Failed to fetch favorite tasks');

            const data = await response.json();
            setFavoriteTasks(data.favoriteTasks || []);
        } catch (error) {
            console.error('Error fetching favorite tasks:', error);
        } finally {
            setIsFavoriteTasksLoaded(true); // Set to true after fetch attempt
        }
    };

    // **Fetch favorite tasks when selectedRole or address changes**
    useEffect(() => {
        fetchFavoriteTasks();
    }, [selectedRole, address]);

    // Inside ChatHome.tsx

    const toggleFavorite = useCallback(async (task: string) => {
        if (!address || !selectedRole) return;

        const isFavorited = favoriteTasks.includes(task);
        const endpoint = isFavorited ? '/api/remove-task-favorite' : '/api/add-task-favorite';

        try {
            const response = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    userAddress: address,
                    department: selectedRole.department,
                    role: selectedRole.role,
                    task: task,
                }),
            });

            if (!response.ok) throw new Error('Failed to update favorite task');

            // Update the local state
            if (isFavorited) {
                setFavoriteTasks(prev => prev.filter(t => t !== task));
            } else {
                setFavoriteTasks(prev => [...prev, task]);
            }

            // Display localized toast notification
            toast.info(
                !isFavorited ? (
                    <LocalizedText name={`Task ${task} Favorited`} />
                ) : (
                    <LocalizedText name={`Task ${task} Unfavorited`} />
                ),
                {
                    style: {
                        backgroundColor: !isFavorited ? '#4CAF50' : '#F44336', // Green for favorited, Red for unfavorited
                        color: '#fff', // Ensure text is readable
                    },
                }

            );

        } catch (error) {
            console.error('Error updating favorite task:', error);
            // Optionally, display an error toast
            toast.error(
                <LocalizedText name="Failed To Update Favorite" />
            );
        }
    }, [address, selectedRole, favoriteTasks]);




    const handleTaskChange = (task: string) => {
        setSelectedTask(task);
        setIsTaskDropdownOpen(false);
        setIsTaskModalVisible(false); // Close the Task Description Modal if open
        setIsRoleModalVisible(false); // Close the Role Description Modal if open
        setIsChatRunning(false); // Reset execution state when task changes
        setIsRunButtonDisabled(false); // **Enable Run button when a new task is selected**
    };

    const handleDescriptionClick = async (
        event: React.MouseEvent<HTMLButtonElement>,
        task: string
    ) => {
        event.stopPropagation(); // Prevent triggering task selection

        // Close the Role Description modal if it's open
        setIsRoleModalVisible(false);
        // Set the active button
        setTaskDescription(null);
        setActiveButton(task);
        // Capture the target element and calculate modal position synchronously
        const targetElement = event.currentTarget;
        if (!targetElement) {
            console.error('event.currentTarget is null');
            return;
        }
        const rect = targetElement.getBoundingClientRect();
        setModalPosition({
            top: rect.top + window.scrollY,
            left: rect.right + 10 + window.scrollX,
        });

        // Show the modal before asynchronous code
        setIsTaskModalVisible(true);

        if (!selectedRole) {
            console.error('selectedRole is null');
            return;
        }

        // Check if the task description is already fetched
        if (taskDescription && activeButton === task) {
            // Do not re-fetch if the description is already available and the same task is clicked again
            return;
        }

        // Fetch the task description only if it's not already available or if it's a new task
        try {
            const response = await fetch('/api/get_task_description', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    department: selectedRole.department,
                    role: selectedRole.role,
                    task: task,
                    language: selectedLanguage,
                }),
            });
            if (!response.ok) throw new Error('Failed to fetch task description');
            const data = await response.json();
            setTaskDescription(data.description);
        } catch (error) {
            console.error('Error fetching task description:', error);
            setTaskDescription('');
        }
    };

    const handleRoleDescriptionClick = async (
        event: React.MouseEvent<HTMLButtonElement>,
        roleData: { department: string; role: string }
    ) => {
        event.stopPropagation(); // Prevent triggering role selection when clicking on the description button
        // Clear the previous description before fetching the new one
        setRoleDescription(null);
        const { department, role } = roleData; // Destructure department and role

        // Create a unique key for activeRoleButton using department and role
        const uniqueKey = `${department}:${role}`;
        setActiveRoleButton(uniqueKey); // Set the clicked role button as active using the unique key

        const targetElement = event.currentTarget; // Get the current button element
        if (!targetElement) {
            console.error('event.currentTarget is null');
            return;
        }

        // Get the button's position to correctly place the modal
        const rect = targetElement.getBoundingClientRect();
        setRoleModalPosition({
            top: rect.top - 100 + window.scrollY, // Adjust for scroll position
            left: rect.left - 465 + window.scrollX, // Modal appears to the left
        });

        setIsRoleModalVisible(true); // Show the modal

        try {
            // Fetch the role description using department and role
            const response = await fetch('/api/get_role_description', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    department: department, // Use the department from roleData
                    role: role, // Use the role from roleData
                    language: selectedLanguage, // Language selected for fetching localized content
                }),
            });
            if (!response.ok) throw new Error('Failed to fetch role description');

            const data = await response.json();
            setRoleDescription(data.description); // Set the fetched role description
        } catch (error) {
            console.error('Error fetching role description:', error);
            setRoleDescription(''); // Show an error message if fetching fails
        }
    };

    const toggleTaskDropdown = () => {
        if (isTaskDropdownOpen) {
            handleCloseDropdown(); // Close both dropdown and modal if dropdown is open
        } else {
            setIsTaskDropdownOpen(true);
        }
        setIsRoleDropdownOpen(false); // Ensure the role dropdown is also closed
    };

    const toggleRoleDropdown = () => {
        setIsRoleDropdownOpen(!isRoleDropdownOpen);
        setIsTaskDropdownOpen(false);
    };

    const handleCloseModal = () => {
        setIsTaskDropdownOpen(false);
        setIsRoleDropdownOpen(false);
        setShouldCloseModal(false);
    };

    const handleClickOutside = useCallback((event: MouseEvent) => {
        if (
            taskButtonRef.current &&
            !taskButtonRef.current.contains(event.target as Node) &&
            modalRef.current &&
            !modalRef.current.contains(event.target as Node)
        ) {
            handleCloseDropdown(); // Close both dropdown and modal on outside click
        }
    }, [taskButtonRef, modalRef]);

    const handleCloseDropdown = () => {
        setIsTaskDropdownOpen(false); // Close the dropdown
        //setIsRoleDropdownOpen(false);
        setIsTaskModalVisible(false); // Close the modal
        setActiveButton(null); // Reset the active button to clear highlight
        setActiveRoleButton(null);
        setIsRoleModalVisible(false); // Close the role modal as well
    };

    const initializeContent = async () => {
        const fetchLanguages = async () => {
            try {
                const response = await fetch('/api/get_all_languages');
                if (response.ok) {
                    const langs: string[] = await response.json();
                    setLanguages(Array.from(new Set(langs))); // Ensure unique languages
                }
            } catch (error) {
                console.error("Error fetching languages:", error);
            }
        };

        const fetchUserLanguage = async () => {
            if (address) {
                try {
                    const response = await fetch(`/api/get_user_language?userAddress=${address}`);
                    if (response.ok) {
                        const data = await response.json();
                        if (data.language) {
                            setSelectedLanguage(data.language);
                            setLanguage(data.language); // Set language in LocalizationContext
                        } else {
                            setSelectedLanguage("English");
                            setLanguage("English"); // Set default language in LocalizationContext
                        }
                    }
                } catch (error) {
                    console.error("Failed to fetch user language:", error);
                    setSelectedLanguage("English");
                }
            }
        };

        await fetchLanguages();
        await fetchUserLanguage();
    };

    /*useEffect(() => {
        document.addEventListener("mousedown", handleClickOutside);
        return () => {
            document.removeEventListener("mousedown", handleClickOutside);
        };
    }, [handleClickOutside]);*/

    useEffect(() => {
        initializeContent();
    }, [address]);

    useEffect(() => {
        document.addEventListener("mousedown", handleClickOutside);
        return () => {
            document.removeEventListener("mousedown", handleClickOutside);
        };
    }, [handleClickOutside]);

    useEffect(() => {
        if (address) {
            fetchRoles();
        }
        fetchAvailableLanguages();
    }, [address]);

    useEffect(() => {
        const fetchTaskDescription = async (task: string, retries = 3) => {
            try {
                const response = await fetch('/api/get_task_description', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        department: selectedRole?.department,
                        role: selectedRole?.role,
                        task: task,
                        language: selectedLanguage,
                    }),
                });
                if (!response.ok) throw new Error('Failed to fetch task description');
                const data = await response.json();
                setTaskDescription(data.description);
            } catch (error) {
                console.error('Error fetching task description:', error);
                if (retries > 0) {
                    // Retry fetching if retries are available
                    setTimeout(() => fetchTaskDescription(task, retries - 1), 1000);
                } else {
                    setTaskDescription('Error fetching .');
                }
            }
        };

        if (isTaskModalVisible && activeButton && !taskDescription) {
            fetchTaskDescription(activeButton);
        }
    }, [isTaskModalVisible, activeButton, selectedRole, selectedLanguage, taskDescription]);

    // Modified useEffect to handle selectedTask from URL
    useEffect(() => {
        const initializeData = async () => {
            if (router.query.selectedRole && router.query.selectedCategory) {
                const selectedRoleData: RoleData = {
                    role: router.query.selectedRole as string,
                    department: router.query.selectedCategory as string,
                };
                setSelectedRole(selectedRoleData);
                await fetchTasks(selectedRoleData.department, selectedRoleData.role);
                if (router.query.selectedTask) {
                    setSelectedTask(router.query.selectedTask as string);
                    //add role into the favorite 
                    // **Call add-role-mapping API**
                    try {
                        const response = await fetch('/api/add-role-mapping', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ userAddress: address, department: selectedRoleData.department, role: selectedRoleData.role }),
                        });

                        if (!response.ok) {
                            throw new Error('Failed to add role mapping');
                        }
                        // **Handle Language Parameter**
                        if (router.query.language && typeof router.query.language === 'string') {
                            const languageFromURL = router.query.language;
                            setSelectedLanguage(languageFromURL);
                            setLanguage(languageFromURL); // Update LocalizationContext
                            //await fetchLocalizedContent(languageFromURL); // Refresh localized content
                        }

                    } catch (error) {
                        console.error(`Error adding role mapping:`, error);
                        // **Revert selection if API call fails**

                    }
                    setIsChatRunning(false); // Ensure chat doesn't run automatically

                } else {
                    setSelectedTask(null);
                }
            }
            // **Handle Language Parameter Independent of Role/Category**
            if (router.query.language && typeof router.query.language === 'string') {
                const languageFromURL = router.query.language;
                setSelectedLanguage(languageFromURL);
                setLanguage(languageFromURL); // Update LocalizationContext
                //await fetchLocalizedContent(languageFromURL); // Refresh localized content
            }

        };
        initializeData();
    }, [router.query]);

    const fetchRoles = async () => {
        try {
            const response = await fetch('/api/get-role-by-address', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ address }),
            });
            if (!response.ok) throw new Error('Failed to fetch roles');
            const rolesData = await response.json();
            setRoles(rolesData);
        } catch (error) {
            console.error('Error fetching roles:', error);
        }
    };

    const fetchTasks = async (department: string, role: string): Promise<void> => {
        try {
            const response = await fetch('/api/get-tasks', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ department, role }),
            });
            if (!response.ok) throw new Error('Failed to fetch tasks');
            const tasksData = await response.json();
            setTasks(tasksData.tasks);
        } catch (error) {
            console.error('Error fetching tasks:', error);
        }
    };

    const fetchAvailableLanguages = async () => {
        try {
            const response = await fetch('/api/get_all_languages');
            if (!response.ok) throw new Error('Failed to fetch languages');
            const languages = await response.json();
            setAvailableLanguages(languages);
        } catch (error) {
            console.error('Error fetching languages:', error);
        }
    };

    const handleRoleChange = (role: RoleData) => {
        setSelectedRole(role);
        setSelectedTask(null);
        fetchTasks(role.department, role.role);
        setIsRoleDropdownOpen(false);
        setIsChatRunning(false); // Reset execution state when role changes
    };

    // New useEffect to fetch role description when role and department are populated
    useEffect(() => {
        if (selectedRole && selectedRole.role && selectedRole.department) {
            fetchRoleDescription(selectedRole.department, selectedRole.role);
        }
    }, [selectedRole]); // Trigger only when selectedRole changes

    // Function to fetch role description using department + role as the unique key
    const fetchRoleDescription = async (department: string, role: string) => {
        try {
            const response = await fetch(`/api/role-description?department=${department}&role=${role}`);
            if (response.ok) {
                const data = await response.json();
                setRoleDescription(data.description); // Set the role description
            } else {
                setRoleDescription('The persona description is currently unavailable. Please try again later');
            }
        } catch (error) {
            console.error('Error fetching role description:', error);
            setRoleDescription('Error fetching persona description');
        }
    };

    const handleOpenModal = () => setIsModalOpen(true);
    const handleCloseFileModal = () => setIsModalOpen(false);


    const handleUpload = async () => {
        // **Set loading state to true at the start**
        setIsLoading(true);

        try {
            // **Validation: Check if the wallet is connected**
            if (!address) {
                const message = 'Please connect your wallet.';
                toast.info(await getLocalizedString(message, language));
                return; // **Early return; finally block will execute**
            }

            // **Validation: Check if the text input is empty**
            if (!textInput.trim()) {
                const message = 'Please input the content.';
                toast.info(await getLocalizedString(message, language));
                return; // **Early return; finally block will execute**
            }

            const uploadFee = UPLOAD_FILE_FEE; // Use the constant directly

            // **Initiate payment process**
            const paymentSuccessful = await process_payment(address, uploadFee, PLATFORM_NAME);

            // **Handle Payment Failure**
            if (!paymentSuccessful) {
                const message = 'Insufficient balance or payment failed. Please try again.';
                toast.error(await getLocalizedString(message, language));
                return; // **Early return; finally block will execute**
            }

            const formData = new FormData();
            let contentToUpload = textInput;

            // **Handle Language Translation if Needed**
            if (selectedLanguage.toLowerCase() !== 'english') {
                try {
                    const response = await fetch('/api/translate', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            name: 'Uploaded Text',
                            description: contentToUpload,
                            fromLanguage: selectedLanguage,
                            toLanguage: 'English'
                        }),
                    });

                    if (!response.ok) {
                        throw new Error('Translation failed');
                    }

                    const result = await response.json();
                    formData.append('text', result.translatedText);
                } catch (error) {
                    console.error('Error translating text:', error);
                    // **Fallback to original text if translation fails**
                    formData.append('text', textInput);
                }
            } else {
                formData.append('text', textInput);
            }

            // **Attempt to Upload the Text**
            try {
                const response = await fetch('/api/uploadFile', {
                    method: 'POST',
                    headers: {
                        'User-Address': String(address),
                    },
                    body: formData,
                });

                if (response.ok) {
                    const message = 'Text uploaded successfully';
                    toast.success(await getLocalizedString(message, language));
                    // **Clear the text input after successful upload**
                    setTextInput('');
                    // **Close the upload modal upon success**
                    handleCloseFileModal();
                } else {
                    throw new Error('Failed to upload text');
                }
            } catch (error) {
                console.error('Error uploading text:', error);
                const message = 'Error uploading text: ' + error;
                toast.error(await getLocalizedString(message, language));
                // **Note:** The upload modal remains open to allow the user to retry
            }
        } catch (error) {
            console.error('Unexpected error during upload:', error);
            toast.error(await getLocalizedString('An unexpected error occurred during upload.', language));
        } finally {
            // **Set loading state to false after the process completes, regardless of success or failure**
            setIsLoading(false);
        }
    };

    const handleCleanup = async () => {
        if (!address) return;

        try {
            const response = await fetch('/api/cleanup_embedding', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ namespace: address }),
            });

            if (response.ok) {
                //console.log('Embedding segment cleaned up successfully');
                const message = 'Embedding segment cleaned up successfully'
                toast.info(await getLocalizedString(message, language));
            } else {
                console.error('Failed to clean up embedding segment');
                const message = 'Failed to clean up embedding segment'
                toast.info(await getLocalizedString(message, language));
            }
        } catch (error) {
            console.error('Error cleaning up embedding segment:', error);
            const message = 'Error cleaning up embedding segment:' + error;
            toast.info(await getLocalizedString(message, language));
        }
    };

    // Sync the modal's selected language with the context's language when the modal opens
    useEffect(() => {
        setSelectedLanguage(language); // Sync dropdown with context language
    }, [language]); // Trigger this when language changes in context

    const handleLanguageChange = async (event: ChangeEvent<HTMLSelectElement>) => {
        const newLanguage = event.target.value;
        setSelectedLanguage(newLanguage);
    }

    const [isLoading, setIsLoading] = useState(false);

    const [localizedPlaceholder, setLocalizedPlaceholder] = useState("Type or paste your text here...");

    useEffect(() => {
        const updatePlaceholder = async () => {
            const placeholderText = await getLocalizedString("Type or paste your text here...", selectedLanguage);
            setLocalizedPlaceholder(placeholderText);
        };
        updatePlaceholder();
    }, [selectedLanguage]);

    const [localizedMessages, setLocalizedMessages] = useState<LocalizedMessages>({
        cleanupSuccess: 'Embedding segment cleaned up successfully',
        cleanupFailed: 'Embedding segment not found or already clean up',
        cleanupError: 'Error occurred while cleaning up embedding segment',
        translateFailed: 'Failed to translate text. Uploading original text.',
        uploadSuccess: 'Text uploaded successfully',
        uploadFailed: 'Failed to upload text. Please try again.'
    });

    useEffect(() => {
        const updateLocalizedMessages = async () => {
            const updatedMessages: Partial<LocalizedMessages> = {};
            for (const [key, message] of Object.entries(localizedMessages)) {
                updatedMessages[key as keyof LocalizedMessages] = await getLocalizedString(message, selectedLanguage);
            }
            setLocalizedMessages(prevMessages => ({
                ...prevMessages,
                ...updatedMessages
            }));
        };
        updateLocalizedMessages();
    }, [selectedLanguage]); // Remove localizedMessages from here

    // Add the following useEffect within your ChatHome component, preferably after the existing useEffects

    useEffect(() => {
        const addFavoriteFromURL = async () => {
            if (
                selectedTask &&
                selectedRole &&
                isFavoriteTasksLoaded && // Check if favorites are loaded
                !hasAddedFavoriteFromURL.current && // Prevent multiple additions
                !favoriteTasks.includes(selectedTask) // Ensure task isn't already a favorite
            ) {
                await addFavorite(selectedTask);
                hasAddedFavoriteFromURL.current = true; // Prevent future cal
            }
        };
        addFavoriteFromURL();
    }, [selectedTask, selectedRole, addFavorite, isFavoriteTasksLoaded]);

    // State for the website URL input
    const [siteUrl, setSiteUrl] = useState('');


