    const handleLoadData = async () => {
        // Set loading state
        setIsLoading(true);

        try {
            // 1. Ensure wallet is connected
            if (!address) {
                const message = 'Please connect your wallet.';
                toast.info(await getLocalizedString(message, language));
                return; // Early exit
            }

            // 2. Check for empty URL
            if (!siteUrl.trim()) {
                const message = 'Please enter a valid website URL.';
                toast.info(await getLocalizedString(message, language));
                return; // Early exit
            }

            // 3. Calculate 2× fee for scraping
            const scrapeFee = 2 * UPLOAD_FILE_FEE;

            // 4. Process payment
            const paymentSuccessful = await process_payment(address, scrapeFee, PLATFORM_NAME);
            if (!paymentSuccessful) {
                const message = 'Insufficient balance or payment failed. Please try again.';
                toast.error(await getLocalizedString(message, language));
                return; // Early exit
            }

            // 5. Attempt scraping via your /api/scrape_web endpoint
            try {
                const response = await fetch('/api/scrape_web', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        // Provide the user’s address as “accountID” for the server
                        accountID: address,
                    },
                    body: JSON.stringify({ url: siteUrl }),
                });

                if (!response.ok) {
                    throw new Error('Failed to scrape website');
                }

                // If success, parse the response
                const data = await response.json();
                // Example success message
                toast.success(
                    await getLocalizedString(`Scrape successful: ${data.message}`, language)
                );

                // Optional: Clear siteUrl or close modal if you like
                // setScrapeUrl('');
                // handleCloseFileModal();

            } catch (error) {
                console.error('Error scraping website:', error);
                const message = 'Error scraping website: ' + error;
                toast.error(await getLocalizedString(message, language));
                // Keep the modal open so user can retry
            }
        } catch (error) {
            console.error('Unexpected error during scraping:', error);
            toast.error(
                await getLocalizedString('An unexpected error occurred during scraping.', language)
            );
        } finally {
            // Reset loading state
            setIsLoading(false);
        }
    };

    return (
        <>
