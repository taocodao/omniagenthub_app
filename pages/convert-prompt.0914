import { useState, useEffect } from 'react';
import Head from 'next/head';
import styles from '../styles/Home3.module.css';
import HashUtil from '../util/hashToFixedDigits'; // Ensure the correct path to HashUtil
import { put } from '@vercel/blob';


const ConvertPrompt = () => {
    const [inputPrompt, setInputPrompt] = useState('');
    const [outputMessage, setOutputMessage] = useState('');
    const [department, setDepartment] = useState('');
    const [role, setRole] = useState('');
    const [task, setTask] = useState('');
    const [inputTask, setInputTask] = useState('');
    const [departments, setDepartments] = useState<string[]>([]);
    const [roles, setRoles] = useState<string[]>([]);
    const [tasks, setTasks] = useState<string[]>([]);
    // const [apiKey, setApiKey] = useState(process.env.NEXT_PUBLIC_OPENAI_API_KEY || '');
    const [apiKey, setApiKey] = useState('');
    const [user, setUser] = useState('eric');
    const [price, setPrice] = useState('0.02');
    const [image, setImage] = useState<File | null>(null);
    const [imagePreview, setImagePreview] = useState<string | null>(null);
    const [newDepartment, setNewDepartment] = useState('');
    const [newRole, setNewRole] = useState('');
    const [translateName, setTranslateName] = useState('');
    const [translateContent, setTranslateContent] = useState('');
    const [translatedNames, setTranslatedNames] = useState<string[]>([]);
    const [selectedTranslatedName, setSelectedTranslatedName] = useState('');
    const [isConverting, setIsConverting] = useState(false);
    const [isUploading, setIsUploading] = useState(false);
    const [uploadedImageUrl, setUploadedImageUrl] = useState('');


    useEffect(() => {
        fetchTranslatedNames();
    }, []);

    const fetchTranslatedNames = async () => {
        try {
            const response = await fetch('/api/get-translated-names');
            if (response.ok) {
                const names = await response.json();
                setTranslatedNames(names);
            }
        } catch (error) {
            console.error('Error fetching translated names:', error);
        }
    };



    useEffect(() => {
        const fetchData = async () => {
            try {
                const departmentResponse = await fetch('/api/get-departments');
                const departmentData = await departmentResponse.json();
                setDepartments(departmentData);
                setDepartment(departmentData[departmentData.length - 1]);

                await fetchRoles(departmentData[departmentData.length - 1]);
            } catch (error) {
                console.error('Error fetching data:', error);
            }
        };

        fetchData();
    }, []);

    const translateAndStoreContent = async (name: string, content: string) => {
        try {

            const response = await fetch('/api/set_content_in_language', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ name, content }),
            });

            if (!response.ok) {
                throw new Error(`Failed to translate and store content for name: ${name}`);
            }

            const result = await response.json();
            console.log(`Content translated and stored for all languages`, result);
            alert(`Content translated and stored for all languages for name ` + name);
        } catch (error) {
            console.error('Error translating and storing content:', error);
        }
    };


    const fetchRoles = async (department: string) => {
        try {
            const response = await fetch('/api/get-roles', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ department }),
            });

            if (!response.ok) {
                throw new Error('Failed to fetch roles');
            }

            const data = await response.json();
            setRoles(Array.isArray(data.roles) ? data.roles : []);
            setRole(data.roles.length > 0 ? data.roles[data.roles.length - 1] : '');
            if (data.roles.length > 0) {
                await fetchTasks(department, data.roles[data.roles.length - 1]);
            }
        } catch (error) {
            console.error('Error fetching roles:', error);
            setRoles([]); // Set roles to an empty array on error
        }
    };

    const handleTranslate = async () => {
        if (translateName && translateContent) {
            try {
                const labeledName = `label:${translateName}`;
                await translateAndStoreContent(labeledName, translateContent);
                setTranslateName('');
                setTranslateContent('');
                fetchTranslatedNames(); // Refresh the list of translated names
            } catch (error) {
                console.error('Error translating content:', error);
            }
        }
    };

    const fetchTasks = async (department: string, role: string) => {
        try {
            const response = await fetch('/api/get-tasks', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ department, role }),
            });

            if (!response.ok) {
                throw new Error('Failed to fetch tasks');
            }

            const data = await response.json();
            setTasks(Array.isArray(data.tasks) ? data.tasks : []);
            setTask(data.tasks.length > 0 ? data.tasks[data.tasks.length - 1] : '');
        } catch (error) {
            console.error('Error fetching tasks:', error);
            setTasks([]); // Set tasks to an empty array on error
        }
    };

    const handleConvert = async () => {
        if (!inputPrompt) {
            alert('Please enter a prompt.');
            return;
        }

        if (!department || !role || !task) {
            alert('Please select a department, role, and task.');
            return;
        }

        try {
            const response = await fetch('/api/convert-prompt', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ department, role, task, prompt: inputPrompt }),
            });

            if (!response.ok) {
                throw new Error('Failed to convert prompt');
            }

            const data = await response.json();
            const instruction = data.instruction;


            // Ensure proper rendering of the instruction
            if (typeof instruction === 'object') {
                setOutputMessage(JSON.stringify(instruction, null, 2));  // Properly format object as a string
            } else {
                setOutputMessage(instruction);  // If it's already a string, display it directly
            }

            setInputPrompt('');
            setTask('');  // Clear task field after conversion
            setInputTask('');
        } catch (error) {
            console.error('Error converting prompt:', error);
            setOutputMessage('An error occurred while converting the prompt.');
        }
    };

    const handleAddPrompt = async () => {
        try {
            //await handleConvert();
            console.log("add the new prompt for task ", inputTask);
            const response = await fetch('/api/convert-prompt', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ department, role, task: inputTask, prompt: inputPrompt }),
            });

            if (!response.ok) {
                console.log("error in add prompt message", response)
                throw new Error('Network response was not ok');
            }

            const data = await response.json();
            const instruction = data.instruction;


            // Ensure proper rendering of the instruction
            if (typeof instruction === 'object') {
                setOutputMessage(JSON.stringify(instruction, null, 2));  // Properly format object as a string
            } else {
                setOutputMessage(instruction);  // If it's already a string, display it directly
            }

            setInputPrompt(''); // Clear the input box after conversion

            // Add the new task to the dropdown list without refreshing the page
            if (!tasks.includes(inputTask)) {
                //await translateAndStoreContent(inputTask, inputTask);
                setTasks((prevTasks) => [...prevTasks, inputTask]);
            }
            setInputTask("");
            setTask('');
        } catch (error) {
            console.error('Error adding prompt:', error);
            setOutputMessage('Error adding prompt.');
        }
    };

    const handleAddDepartment = async () => {
        if (newDepartment && !departments.includes(newDepartment)) {
            try {
                /* await fetch('/api/add-department', {
                     method: 'POST',
                     headers: { 'Content-Type': 'application/json' },
                     body: JSON.stringify({ department: newDepartment }),
                 });*/
                // Translate and store the new department
                //await translateAndStoreContent(newDepartment, newDepartment);
                setDepartments((prev) => [...prev, newDepartment]);
                setDepartment(newDepartment);
                setRoles([]);
                setTasks([]);
                setNewDepartment('');
                resetFields();
            } catch (error) {
                console.error('Error adding department:', error);
            }
        }
    };

    const handleAddRole = async () => {
        if (newRole && !roles.includes(newRole)) {
            try {
                /*  setRoles((prev) => [...prev, newRole]);
                  setRole(newRole);
                  setTasks([]);
                  setNewRole('');
                  resetFields();*/
                if (newRole && !roles.includes(newRole)) {
                    setRoles((prev) => [...prev, newRole]);  // Add the new role to the existing list
                    setRole(newRole);  // Set the newly added role as the selected one
                    setNewRole('');  // Clear the newRole input field after adding
                } else if (roles.includes(newRole)) {
                    alert('Role already exists');
                }
            } catch (error) {
                console.error('Error adding role:', error);
            }
        }
    };

    const handleAddRoleMappings = async () => {
        // Ensure department, role, and user inputs are not empty before proceeding
        if (!department || !role || !user) {
            alert('Department, Role, and User are required fields.');
            return;
        }

        try {
            let imageUrl = uploadedImageUrl;

            // If an image is selected but not yet uploaded, upload it first
            if (image && !imageUrl) {
                setIsUploading(true);
                const blob = await put(image.name, image, {
                    access: 'public',
                    token: process.env.NEXT_PUBLIC_BLOB_READ_WRITE_TOKEN,
                });
                imageUrl = blob.url;
                setUploadedImageUrl(imageUrl);
                setIsUploading(false);
            }

            // Prepare form data with the uploaded image URL
            const formData = new FormData();
            formData.append('department', department);
            formData.append('role', role);
            formData.append('apiKey', apiKey || ''); // Use an empty string if apiKey is null or undefined
            formData.append('user', user);
            formData.append('price', price);
            if (imageUrl) {
                formData.append('image', imageUrl);
            }

            const response = await fetch('/api/add-role-mappings', {
                method: 'POST',
                body: formData,
            });

            if (!response.ok) {
                throw new Error('Failed to add role mappings');
            }

            await fetchRoles(department);

            // Reset fields after successful addition
            resetFields();
            alert('Role mappings added successfully');
        } catch (error) {
            console.error('Error adding role mappings:', error);
            alert('Error adding role mappings');
        }
    };



    const handleRefreshDepartments = async () => {
        try {
            const response = await fetch('/api/get-departments');
            if (!response.ok) {
                throw new Error('Failed to fetch departments');
            }
            const data = await response.json();
            setDepartments(data);
            if (data.length > 0) {
                setDepartment(data[0]);
                await fetchRoles(data[0]);
            }
        } catch (error) {
            console.error('Error refreshing departments:', error);
        }
    };

    const handleRefreshRoles = async () => {
        if (department) {
            await fetchRoles(department);
        }
    };

    const handleRetrieve = async () => {
        try {
            const response = await fetch('/api/get-role-mappings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ department, role }),
            });

            if (!response.ok) {
                throw new Error('Failed to retrieve role mappings');
            }

            const data = await response.json();
            setApiKey(data.apiKey || '');
            setUser(data.user || '');
            setPrice(data.price || '');
            /* if (data.image) {
                 setImagePreview(`/api/get-image?imagePath=${data.image}`);
             } else {
                 setImagePreview(null);
             }*/
            if (data.image) { setUploadedImageUrl(data.image) };
        } catch (error) {
            console.error('Error retrieving role mappings:', error);
            alert('Error retrieving role mappings');
        }
    };

    const handleUpdate = async () => {
        const formData = new FormData();
        formData.append('department', department);
        formData.append('role', role);
        formData.append('apiKey', apiKey);
        formData.append('user', user);
        formData.append('price', price);
        if (uploadedImageUrl) formData.append('image', uploadedImageUrl);

        try {
            const response = await fetch('/api/update-role-mappings', {
                method: 'POST',
                body: formData,
            });

            if (!response.ok) {
                throw new Error('Failed to update role mappings');
            }

            await fetchRoles(department);
            setUploadedImageUrl("");

            alert('Role mappings updated successfully');
        } catch (error) {
            console.error('Error updating role mappings:', error);
            alert('Error updating role mappings');
        }
    };

    const handleDepartmentChange = async (value: string) => {
        setDepartment(value);
        if (value) {
            await fetchRoles(value);
        }
        resetFields();
    };

    const handleRoleChange = async (value: string) => {
        setRole(value);
        if (department && value) {
            await fetchTasks(department, value);
        }
        resetFields();
    };

    const resetFields = () => {
        //setApiKey(process.env.NEXT_PUBLIC_OPENAI_API_KEY || '');
        setApiKey('');
        setUser('eric');
        setPrice('0.01');
        setImage(null);
        setImagePreview(null);
    };

    const parsePrompt = (prompt: string) => {
        const roleMatch = prompt.match(/"role":"([^"]+)"/);
        const departmentMatch = prompt.match(/"department":"([^"]+)"/);
        const taskMatch = prompt.match(/"task":"([^"]+)"/);

        return {
            role: roleMatch ? roleMatch[1] : '',
            department: departmentMatch ? departmentMatch[1] : '',
            task: taskMatch ? taskMatch[1] : '',
        };
    };

    /* const handleImageUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
         if (e.target.files && e.target.files.length > 0) {
             setImage(e.target.files[0]);
             const reader = new FileReader();
             reader.onload = () => setImagePreview(reader.result as string);
             reader.readAsDataURL(e.target.files[0]);
         }
     };*/
    const handleImageUpload = async (event: React.ChangeEvent<HTMLInputElement>) => {
        const file = event.target.files?.[0];
        if (!file) return;

        try {
            setIsUploading(true);

            // Upload to Vercel Blob
            const blob = await put(file.name, file, {
                access: 'public',
                token: process.env.NEXT_PUBLIC_BLOB_READ_WRITE_TOKEN,
            });

            setUploadedImageUrl(blob.url);
            setIsUploading(false);
        } catch (error) {
            console.error('Error uploading image:', error);
            setIsUploading(false);
            alert('Failed to upload image. Please try again.');
        }
    };


    const handleInputPromptChange = (e: React.ChangeEvent<HTMLTextAreaElement>) => {
        const prompt = e.target.value;
        setInputPrompt(prompt);
        const parsedPrompt = parsePrompt(prompt);
        //setInputTask(parsedPrompt.task);
    };

    const handleRetrieveInstruction = async () => {
        try {
            const assistantId = HashUtil.hashTo(`${role}${task}`);
            const response = await fetch('/api/get-instruction', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ assistantId }),
            });

            if (!response.ok) {
                throw new Error('Failed to retrieve instruction');
            }

            const data = await response.json();
            setOutputMessage(data.instruction || '');
        } catch (error) {
            console.error('Error retrieving instruction:', error);
            alert('Error retrieving instruction');
        }
    };


    const handleUpdateInstruction = async () => {
        try {
            const assistantId = HashUtil.hashTo(`${role}${task}`);
            const response = await fetch('/api/update-instruction', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ assistantId, instruction: outputMessage }),
            });

            if (!response.ok) {
                throw new Error('Failed to update instruction');
            }

            alert('Instruction updated successfully');
        } catch (error) {
            console.error('Error updating instruction:', error);
            alert('Error updating instruction');
        }
    };

    const handleRetrieveTranslation = async () => {
        if (selectedTranslatedName) {
            try {
                const response = await fetch('/api/get_content_in_language', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        name: selectedTranslatedName,
                        language: 'English'
                    }),
                });

                if (response.ok) {
                    const data = await response.json();
                    if (data.content) {
                        setTranslateName(selectedTranslatedName.replace('label:', ''));
                        setTranslateContent(data.content);
                    } else {
                        throw new Error('No content found for the selected name ' + selectedTranslatedName);
                    }
                } else {
                    throw new Error('Failed to retrieve translation');
                }
            } catch (error) {
                console.error('Error retrieving translation:', error);
                alert('Error retrieving translation: ' + error);
            }
        }
    };



    return (
        <div className={styles.container}>
            <Head>
                <title>Convert Prompt</title>
                <meta name="description" content="Convert Prompt to structured format" />
                <link rel="icon" href="/favicon.ico" />
            </Head>

            <main className={styles.main}>
                <h1 className={styles.title} style={{ textAlign: 'center' }}>Convert Prompt</h1>

                <div className={styles.grid}>
                    {/* Section 1 */}
                    <div className={styles.section1}>
                        <div className={`${styles.card} ${styles.row}`}>
                            <div className={styles.inputGroup}>
                                <h3>Department</h3>
                                <select
                                    value={department}
                                    onChange={(e) => handleDepartmentChange(e.target.value)}
                                    style={{ padding: '8px', marginBottom: '10px' }}
                                >
                                    {departments.map((dep, index) => (
                                        <option key={index} value={dep}>{dep}</option>
                                    ))}
                                </select>
                                <input
                                    type="text"
                                    value={newDepartment}
                                    onChange={(e) => setNewDepartment(e.target.value)}
                                    placeholder="New Department"
                                    style={{ padding: '8px', marginBottom: '10px' }}
                                />
                                <button onClick={handleAddDepartment} style={{ marginTop: '10px' }}>Add</button>
                            </div>
                            <div className={styles.inputGroup}>
                                <h3>Role</h3>
                                <select
                                    value={role}
                                    onChange={(e) => setRole(e.target.value)}
                                    style={{ padding: '8px', marginBottom: '10px' }}
                                >
                                    { /* {Array.isArray(roles) ? roles.map((rl, index) => (
                                        <option key={index} value={rl}>{rl}</option>
                                    )) : null}*/}
                                    {roles.map((rl, index) => (
                                        <option key={index} value={rl}>{rl}</option>
                                    ))}
                                </select>
                                <input
                                    type="text"
                                    value={newRole}
                                    onChange={(e) => setNewRole(e.target.value)}
                                    placeholder="New Role"
                                    style={{ padding: '8px', marginBottom: '10px' }}
                                />
                                <button onClick={handleAddRole} style={{ marginTop: '10px' }}>Add</button>
                            </div>
                            <div className={styles.inputGroup}>
                                <h3>API Key</h3>
                                <input
                                    type="text"
                                    value={apiKey}
                                    onChange={(e) => setApiKey(e.target.value)}
                                    style={{ padding: '8px', marginBottom: '10px' }}
                                />
                            </div>
                        </div>

                        {/* Additional Inputs for Section 1 */}
                        <div className={`${styles.card} ${styles.row}`}>
                            <div className={styles.inputGroup}>
                                <h3>User</h3>
                                <input
                                    type="text"
                                    value={user}
                                    onChange={(e) => setUser(e.target.value)}
                                    style={{ padding: '8px', marginBottom: '10px' }}
                                />
                            </div>
                            <div className={styles.inputGroup}>
                                <h3>Price</h3>
                                <input
                                    type="text"
                                    value={price}
                                    onChange={(e) => setPrice(e.target.value)}
                                    style={{ padding: '8px', marginBottom: '10px' }}
                                />
                            </div>
                            <div className={styles.inputGroup}>
                                <h3>Image</h3>
                                {/*imagePreview && <img src={imagePreview} alt="Selected" style={{ width: '100px', marginBottom: '10px' }} />*/}
                                {uploadedImageUrl && (
                                    <div className="mt-4">
                                        <img src={uploadedImageUrl} alt="Uploaded" style={{ width: '100px', marginBottom: '10px' }} className="max-w-full h-auto" />
                                    </div>
                                )}

                                <input
                                    type="file"
                                    onChange={handleImageUpload}
                                    style={{ padding: '8px', marginBottom: '10px' }}
                                />
                            </div>
                        </div>

                        {/* Buttons for Section 1 */}
                        <div className={`${styles.card} ${styles.row}`} style={{ justifyContent: 'center' }}>
                            <button onClick={handleAddRoleMappings} style={{ margin: '10px' }}>Add Role</button>
                            <button onClick={handleRetrieve} style={{ margin: '10px' }}>Retrieve</button>
                            <button onClick={handleUpdate} style={{ margin: '10px' }}>Update</button>
                        </div>
                    </div>

                    {/* Section 2 */}
                    <div className={`${styles.card} ${styles.row}`}>
                        <div className={styles.inputGroup}>
                            <h3>Department</h3>
                            <select
                                value={department}
                                onChange={(e) => handleDepartmentChange(e.target.value)}
                                style={{ padding: '8px', marginBottom: '10px' }}
                            >
                                {departments.map((dep, index) => (
                                    <option key={index} value={dep}>{dep}</option>
                                ))}
                            </select>
                            <button onClick={handleRefreshDepartments} style={{ marginTop: '10px' }}>Refresh</button>
                        </div>
                        <div className={styles.inputGroup}>
                            <h3>Role</h3>
                            <select
                                value={role}
                                onChange={(e) => handleRoleChange(e.target.value)}
                                style={{ padding: '8px', marginBottom: '10px' }}
                            >
                                {Array.isArray(roles) ? roles.map((rl, index) => (
                                    <option key={index} value={rl}>{rl}</option>
                                )) : null}
                            </select>
                            <button onClick={handleRefreshRoles} style={{ marginTop: '10px' }}>Refresh</button>
                        </div>
                        <div className={styles.inputGroup}>
                            <h3>Task</h3>
                            <select
                                value={task}
                                onChange={(e) => setTask(e.target.value)}
                                style={{ padding: '8px', marginBottom: '10px' }}
                            >
                                {tasks.map((tk, index) => (
                                    <option key={index} value={tk}>{tk}</option>
                                ))}
                            </select>
                            <input
                                type="text"
                                value={inputTask}
                                onChange={(e) => setInputTask(e.target.value)}
                                style={{ padding: '8px', marginBottom: '10px' }}
                            />
                        </div>
                    </div>

                    <div className={styles.card}>
                        <h3>Input Prompt</h3>
                        <textarea
                            value={inputPrompt}
                            onChange={handleInputPromptChange}
                            rows={10}
                            cols={50}
                            style={{ width: '90%', padding: '8px', marginBottom: '10px' }}
                        />
                        <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '10px' }}>
                            <button onClick={handleConvert} style={{ marginRight: '10px' }}>Convert</button>
                            <button onClick={handleAddPrompt} style={{ marginRight: '10px' }}>Add</button>
                        </div>
                    </div>

                    <div className={styles.card} style={{ width: '100%' }}>
                        <h3>Output Message</h3>
                        <textarea
                            value={outputMessage}
                            onChange={(e) => setOutputMessage(e.target.value)}
                            rows={10}
                            cols={50}
                            style={{ width: '90%', padding: '8px', marginTop: '10px' }}
                        />
                        <div style={{ display: 'flex', justifyContent: 'space-between', marginTop: '10px' }}>
                            <button onClick={handleRetrieveInstruction} style={{ marginRight: '10px' }}>Retrieve</button>
                            <button onClick={handleUpdateInstruction} style={{ marginRight: '10px' }}>Update</button>
                        </div>
                    </div>

                    <div className={styles.card} style={{ width: '100%' }}>
                        <h3>Translate</h3>
                        <input
                            type="text"
                            value={translateName}
                            onChange={(e) => setTranslateName(e.target.value)}
                            placeholder="Enter name"
                            style={{ width: '90%', padding: '8px', marginTop: '10px' }}
                        />
                        <textarea
                            value={translateContent}
                            onChange={(e) => setTranslateContent(e.target.value)}
                            rows={10}
                            cols={50}
                            placeholder="Enter content to translate"
                            style={{ width: '90%', padding: '8px', marginTop: '10px' }}
                        />
                        <div style={{ display: 'flex', justifyContent: 'space-between', marginTop: '10px' }}>
                            <button onClick={handleTranslate} style={{ marginRight: '10px' }}>Translate</button>
                            <button onClick={handleRetrieveTranslation} style={{ marginRight: '10px' }}>Retrieve</button>
                        </div>
                        <select
                            value={selectedTranslatedName}
                            onChange={(e) => setSelectedTranslatedName(e.target.value)}
                            style={{ width: '90%', padding: '8px', marginTop: '10px' }}
                        >
                            <option value="">Select a translated name</option>
                            {translatedNames.map((name) => (
                                <option key={name} value={name}>{name}</option>
                            ))}
                        </select>
                    </div>



                </div>



            </main>
        </div>
    );
}

export default ConvertPrompt;
