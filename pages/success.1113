// pages/success.tsx

import { useEffect, useState } from 'react';
import { useRouter } from 'next/router';
import { toast } from 'react-toastify';
import { useActiveAccount } from 'thirdweb/react';
import SignIn from '../components/SignIn';
import styles from '../styles/Success.module.css';
import Link from 'next/link'; // Import Link from next/link

const SuccessPage = () => {
    const router = useRouter();
    const { session_id } = router.query;
    const [loading, setLoading] = useState(true);
    const [message, setMessage] = useState<string>('Verifying your payment...');

    const account = useActiveAccount();
    const userAddress = account?.address;

    useEffect(() => {
        const fetchSessionAndUpdateChats = async () => {
            if (!session_id || Array.isArray(session_id)) {
                setMessage('Invalid session ID.');
                setLoading(false);
                return;
            }

            if (!userAddress) {
                // User address is not available; perhaps wallet is not connected
                setMessage('Wallet not connected. Please connect your wallet.');
                setLoading(false);
                return;
            }

            try {
                // Fetch the Checkout Session details from your server
                const response = await fetch(`/api/retrieve-checkout-session?session_id=${session_id}`);
                const data = await response.json();

                if (data.session && data.session.payment_status === 'paid') {
                    // Extract metadata
                    const { productId, userId } = data.session.metadata as { productId: string; userId: string };

                    // Verify that the userId matches the connected wallet address
                    if (userId.toLowerCase() !== userAddress.toLowerCase()) {
                        setMessage('User mismatch. Please ensure you are using the correct wallet.');
                        toast.error('User mismatch. Please ensure you are using the correct wallet.');
                        setLoading(false);
                        return;
                    }

                    // Determine the number of free chats based on the productId
                    let freeTrades = 0;
                    console.log('The product Id is', productId);

                    switch (productId) {
                        case '1': // Entry Level AI Starter Pack
                            freeTrades = 5000;
                            break;
                        case '2': // Professional AI Productivity Pack
                            freeTrades = 20000;
                            break;
                        case '3': // Enterprise AI Collaboration Suite
                            freeTrades = 100000;
                            break;
                        default:
                            console.warn(`Unknown productId: ${productId}`);
                            break;
                    }

                    if (freeTrades > 0) { // Ensure only positive freeTrades
                        // Prepare the request body
                        const requestBody = {
                            userKey: userAddress,
                            freeTrades: freeTrades,
                        };

                        // Determine if we need to include the updater token via proxy
                        // Since we're using the proxy, we don't need to add headers here
                        const configEnv = process.env.NEXT_PUBLIC_CONFIG_ENV || 'prod';
                        const headers: HeadersInit = {
                            'Content-Type': 'application/json',
                        };

                        // Call the proxy-add-free-chats API to update the user's free chats balance
                        const updateResponse = await fetch('/api/proxy-add-free-chats', { // Changed to proxy endpoint
                            method: 'POST',
                            headers: headers,
                            body: JSON.stringify(requestBody),
                        });

                        const updateData = await updateResponse.json();

                        if (updateResponse.ok) {
                            setMessage('Payment successful! Your free chats have been added.');
                            toast.success(updateData.message || 'Your free chats have been added successfully!');
                        } else {
                            setMessage('Payment successful, but failed to update your free chats.');
                            toast.error(updateData.message || 'Failed to update your free chats. Please contact support.');
                        }
                    } else {
                        setMessage('Payment successful! However, the purchased product does not grant free chats.');
                        toast.info('Payment successful! No free chats were added for this purchase.');
                    }
                } else {
                    // Payment failed or is incomplete
                    setMessage('Payment not completed. Please try again.');
                    toast.error('Payment not completed. Please try again.');
                }
            } catch (error: any) {
                console.error('Error verifying payment:', error);
                setMessage('An error occurred while verifying your payment.');
                toast.error('An error occurred while verifying your payment.');
            } finally {
                setLoading(false);
            }
        };

        fetchSessionAndUpdateChats();
    }, [session_id, userAddress]);

    return (
        <main className={styles.main}>
            <div className={styles.container}>
                {!userAddress ? (
                    <SignIn />
                ) : (
                    <div style={{ padding: '2rem', textAlign: 'center' }}>
                        <h1>Payment Status</h1>
                        <p>{message}</p>
                        {loading && <p>Please wait...</p>}
                        {!loading && (
                            <>
                                <p>
                                    You can close this window or return to the{' '}
                                    <Link href="/ChatHome" style={{ color: 'blue', textDecoration: 'underline' }}>
                                        Chat Home
                                    </Link>
                                    .
                                </p>
                            </>
                        )}
                    </div>
                )}
            </div>
        </main>
    );
};

export default SuccessPage;
