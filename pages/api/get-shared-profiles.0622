// pages/api/get-shared-profiles.ts
import type { NextApiRequest, NextApiResponse } from "next";
import { createClient } from "@vercel/kv";

const kv = createClient({
    url: process.env.KV_REST_API_URL!,
    token: process.env.KV_REST_API_TOKEN!,
});

export default async function handler(
    req: NextApiRequest,
    res: NextApiResponse
) {
    if (req.method !== "GET") {
        return res.status(405).json({ error: "Method not allowed" });
    }

    const { userAddress } = req.query;

    if (!userAddress || typeof userAddress !== "string") {
        return res.status(400).json({ error: "Missing or invalid userAddress parameter" });
    }

    try {
        // Use SCAN instead of KEYS to handle large datasets
        const sharedProfiles = [];
        let cursor: string | number = "0";  // ✅ FIXED: Allow both string and number
        const pattern = "sharedProfiles:*";

        do {
            // SCAN with pattern matching
            const scanResult = await kv.scan(cursor, { match: pattern, count: 100 });
            cursor = scanResult[0];  // ✅ FIXED: This is now properly typed
            const keys = scanResult[1];

            // Process each key found
            for (const key of keys) {
                try {
                    const profileId = key.replace("sharedProfiles:", "");
                    const sharedUsers = await kv.get(key) as string[];

                    if (sharedUsers && Array.isArray(sharedUsers) && sharedUsers.includes(userAddress)) {
                        // This profile is shared with the user, fetch the profile details
                        try {
                            const profileResponse = await fetch(`${process.env.NEXT_PUBLIC_BASE_URL || 'http://localhost:3000'}/api/get-user-profile-detail?profileId=${profileId}&userAddress=${userAddress}`);
                            if (profileResponse.ok) {
                                const profileResult = await profileResponse.json();
                                if (profileResult.success && profileResult.profile) {
                                    sharedProfiles.push({
                                        ...profileResult.profile,
                                        isOwned: false,
                                        ownerAddress: profileResult.profile.userAddress || 'Unknown'
                                    });
                                }
                            }
                        } catch (profileError) {
                            console.error(`Error fetching profile ${profileId}:`, profileError);
                        }
                    }
                } catch (keyError) {
                    console.error(`Error processing key ${key}:`, keyError);
                }
            }
        } while (cursor !== "0"); // ✅ FIXED: Check for both string and number

        res.status(200).json({
            success: true,
            profiles: sharedProfiles
        });
    } catch (error) {
        console.error("Error fetching shared profiles:", error);
        res.status(500).json({
            success: false,
            error: "Error fetching shared profiles"
        });
    }
}
