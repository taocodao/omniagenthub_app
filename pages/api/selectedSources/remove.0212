import type { NextApiRequest, NextApiResponse } from "next";
import { createClient } from "@vercel/kv";

const kv = createClient({
    url: process.env.KV_REST_API_URL!,
    token: process.env.KV_REST_API_TOKEN!,
});

// Helper: Convert userName to userAddress via "userMapping:{userName}"
async function getUserAddressFromUserName(userName: string): Promise<string> {
    const key = `userMapping:${userName.toLowerCase()}`;
    const data = await kv.get(key);
    if (!data) {
        throw new Error("User address not found for the given username");
    }
    return data as string;
}

export default async function handler(
    req: NextApiRequest,
    res: NextApiResponse
) {
    if (req.method !== "POST") {
        return res.status(405).json({ error: "Method not allowed" });
    }

    const { userName, sourceKey } = req.body as {
        userName?: string;
        sourceKey: string;
    };
    if ((!userName) || !sourceKey) {
        return res
            .status(400)
            .json({ error: "Missing userName or sourceKey parameter" });
    }

    let finalUserAddress: string;
    try {
        finalUserAddress = await getUserAddressFromUserName(userName);
    } catch (error) {
        return res
            .status(400)
            .json({ error: "Invalid userName, cannot convert to address" });
    }

    try {
        const key = `selectedSources:${finalUserAddress.toLowerCase()}`;
        let current: string[] = [];
        const data = await kv.get(key);
        if (data) current = data as string[];
        const updated = current.filter((s) => s !== sourceKey);
        await kv.set(key, updated);
        return res
            .status(200)
            .json({ selectedSources: updated, message: "Source removed successfully" });
    } catch (error) {
        console.error("Error removing selected source:", error);
        return res.status(500).json({ error: "Error removing selected source" });
    }
}
