import type { NextApiRequest, NextApiResponse } from "next";
import { createClient } from "@vercel/kv";

const kv = createClient({
    url: process.env.KV_REST_API_URL!,
    token: process.env.KV_REST_API_TOKEN!,
});

export default async function handler(
    req: NextApiRequest,
    res: NextApiResponse
) {
    // Allow only GET requests.
    if (req.method !== "GET") {
        return res.status(405).json({ error: "Method not allowed" });
    }

    try {
        // Retrieve the global index for company names.
        const globalKey = "companyNames";
        const companyNamesData = await kv.get(globalKey);
        // If the global key exists, we assume it is an array of strings.
        const companyNames: string[] = companyNamesData ? (companyNamesData as string[]) : [];
        console.log("[getCompanyNames] Retrieved company names:", companyNames);
        return res.status(200).json({ companyNames });
    } catch (error) {
        console.error("Error fetching company names:", error);
        return res.status(500).json({ error: "Error fetching company names" });
    }
}
