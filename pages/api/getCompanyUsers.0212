import type { NextApiRequest, NextApiResponse } from "next";
import { createClient } from "@vercel/kv";

const kv = createClient({
    url: process.env.KV_REST_API_URL!,
    token: process.env.KV_REST_API_TOKEN!,
});

export default async function handler(
    req: NextApiRequest,
    res: NextApiResponse
) {
    // Allow only GET requests.
    if (req.method !== "GET") {
        return res.status(405).json({ error: "Method not allowed" });
    }

    // Extract the userAddress query parameter.
    const { userAddress } = req.query;
    if (!userAddress || typeof userAddress !== "string") {
        return res
            .status(400)
            .json({ error: "Missing or invalid userAddress parameter" });
    }

    try {
        // Retrieve the company name for the given userAddress.
        const companyKey = `companyName:${userAddress.toLowerCase()}`;
        const companyName = await kv.get(companyKey);

        if (!companyName || typeof companyName !== "string") {
            return res
                .status(404)
                .json({ error: "Company name not found for user" });
        }

        // Retrieve all keys with the prefix "companyName:".
        const keys: string[] = await kv.keys("companyName:");
        console.log("[getCompanyUsers] Retrieved keys:", keys);

        // For each key check if its value equals the company name.
        const matchingUserAddresses = await Promise.all(
            keys.map(async (key) => {
                const value = await kv.get(key);
                if (value === companyName) {
                    // Assuming key format is "companyName:{userAddress}"
                    const parts = key.split(":");
                    if (parts.length === 2) {
                        const addr = parts[1];
                        // Exclude the requesting user's own address.
                        if (addr.toLowerCase() !== userAddress.toLowerCase()) {
                            return addr;
                        }
                    }
                }
                return null;
            })
        );

        // Filter out any null values.
        const filteredAddresses = matchingUserAddresses.filter(
            (addr): addr is string => addr !== null
        );

        // For each matching user address, retrieve the corresponding userName concurrently.
        const companyUsers = await Promise.all(
            filteredAddresses.map(async (addr) => {
                const userName = await kv.get(`userName:${addr.toLowerCase()}`);
                return userName ? { userAddress: addr, userName } : null;
            })
        );

        // Remove any null entries.
        const validCompanyUsers = companyUsers.filter(
            (user): user is { userAddress: string; userName: string } => user !== null
        );

        console.log("[getCompanyUsers] Company users:", validCompanyUsers);
        return res.status(200).json({ users: validCompanyUsers });
    } catch (error) {
        console.error("Error fetching company users:", error);
        return res
            .status(500)
            .json({ error: "Error fetching company users" });
    }
}
