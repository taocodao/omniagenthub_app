// pages/api/add-free-chats.ts

import type { NextApiRequest, NextApiResponse } from 'next';
import { createClient } from '@vercel/kv';
import HashUtil from '../../util/hashToFixedDigits';

// Initialize Vercel KV client
const kv = createClient({
    url: process.env.KV_REST_API_URL!,
    token: process.env.KV_REST_API_TOKEN!,
});

// Define the structure of the request body
interface AddFreeChatsRequest {
    userKey: string;
    freeTrades: number;
}

export default async function handler(req: NextApiRequest, res: NextApiResponse) {
    // Allow only POST requests
    if (req.method !== 'POST') {
        res.setHeader('Allow', 'POST');
        return res.status(405).json({ message: 'Method Not Allowed' });
    }

    // Environment variable to determine if we're in development or production
    const configEnv = process.env.NEXT_PUBLIC_CONFIG_ENV || 'prod';

    // Function to determine if the request is from localhost
    const isLocalhostRequest = (): boolean => {
        const forwarded = req.headers['x-forwarded-for'];
        const ip = typeof forwarded === 'string' ? forwarded.split(',')[0] : '';
        const remoteAddress = req.socket.remoteAddress || '';

        // Check for localhost IP addresses
        return (
            ip === '127.0.0.1' ||
            ip === '::1' ||
            remoteAddress === '127.0.0.1' ||
            remoteAddress === '::1' ||
            req.headers.host?.includes('localhost') === true
        );
    };

    // Determine if the request is from localhost
    const isLocalhost = isLocalhostRequest();

    // In production, always require the token. In development, bypass token check for localhost.
    if (configEnv !== 'dev' || !isLocalhost) {
        const token = req.headers['x-updater-token'];

        if (typeof token !== 'string' || token !== process.env.UPDATER_SECRET_TOKEN) {
            return res.status(401).json({ message: 'Unauthorized: Invalid or missing token.' });
        }
    }

    // Extract data from the request body
    const { userKey, freeTrades } = req.body as AddFreeChatsRequest;

    console.log('Request body:', req.body);
    console.log('Adding free trades for userKey:', userKey);
    console.log('Number of freeTrades to add:', freeTrades);

    // Validate required fields
    if (!userKey || typeof freeTrades !== 'number') {
        return res.status(400).json({ message: 'User key and number of free trades are required.' });
    }

    // Validate that freeTrades is a positive number
    if (freeTrades <= 0) {
        return res.status(400).json({ message: 'Number of free trades must be a positive number.' });
    }

    try {
        // Hash the userKey to create a consistent key format for KV store
        const hashedUserKey = HashUtil.hashTo(userKey);

        // Retrieve current freeTrades from KV store
        let currentFreeTrades = await kv.get<number>(`${hashedUserKey}:freeTrades`);
        currentFreeTrades = currentFreeTrades ? Number(currentFreeTrades) : 0;

        console.log('Current freeTrades:', currentFreeTrades);

        // Calculate new freeTrades balance
        const newFreeTrades = currentFreeTrades + freeTrades;

        // Prevent negative freeTrades balance
        if (newFreeTrades < 0) {
            return res.status(400).json({
                message: 'Insufficient free chats.',
                remainingChats: currentFreeTrades,
            });
        }

        // Update the freeTrades balance in KV store
        await kv.set(`${hashedUserKey}:freeTrades`, newFreeTrades);
        console.log('Free trades updated successfully to', newFreeTrades);

        // Respond with success message and updated balance
        return res.status(200).json({
            message: 'Free trades updated successfully.',
            remainingChats: newFreeTrades,
        });
    } catch (error) {
        console.error('Error updating free trades:', error);
        return res.status(500).json({ message: 'Internal server error.' });
    }
}
