// pages/api/runAssistant.ts

// Remove Next.js specific imports
// import { NextApiRequest, NextApiResponse } from 'next';
import { runAssistant } from '../../components/RunAssistantRSC';

// Edge Runtime configuration
export const config = {
    runtime: 'edge',
};

export const maxDuration = 300; // This function can run for a maximum of 300 seconds

export const dynamic = 'force-dynamic';

const KV_REST_API_URL = process.env.KV_REST_API_URL!;
const KV_REST_API_TOKEN = process.env.KV_REST_API_TOKEN!;
const OPENAI_API_KEY = process.env.OPENAI_API_KEY!;

// It's better to handle missing environment variables gracefully
if (!KV_REST_API_URL || !KV_REST_API_TOKEN || !OPENAI_API_KEY) {
    throw new Error('Missing required environment variables');
}

export default async (req: Request): Promise<Response> => {
    try {
        // Ensure the request method is POST
        if (req.method !== 'POST') {
            return new Response(JSON.stringify({ error: 'Method not allowed' }), {
                status: 405,
                headers: { 'Content-Type': 'application/json' },
            });
        }

        // Parse the JSON body
        const { assistantId, threadId, userMessage, userAddress } = await req.json();

        // Validate required fields
        if (!assistantId || !userMessage || !userAddress) {
            return new Response(JSON.stringify({ error: 'Missing required fields' }), {
                status: 400,
                headers: { 'Content-Type': 'application/json' },
            });
        }

        // Run the assistant
        const response = await runAssistant(assistantId, threadId, userMessage, userAddress);

        // Return the successful response
        return new Response(JSON.stringify({ response }), {
            status: 200,
            headers: { 'Content-Type': 'application/json' },
        });
    } catch (error: any) {
        console.error('Error running assistant:', error);

        // Determine error type for more granular responses
        // if (error instanceof SomeKnownError) { // Replace with actual error types
        return new Response(JSON.stringify({ error: error.message }), {
            status: error.statusCode || 500,
            headers: { 'Content-Type': 'application/json' },
        });
        //}

        // Generic server error
        return new Response(JSON.stringify({ error: 'Error running assistant' }), {
            status: 500,
            headers: { 'Content-Type': 'application/json' },
        });
    }
};
