import { NextApiRequest, NextApiResponse } from 'next';
import { RunAssistantRSC } from '../../components/RunAssistantRSC';

export default async (req: NextApiRequest, res: NextApiResponse) => {
    if (req.method === 'POST') {
        const { assistantId, threadId, userMessage } = req.body;

        try {
            const response = await RunAssistantRSC({ assistantId, threadId, userMessage });

            res.setHeader('Content-Type', 'text/html'); // Ensure content type is set to HTML
            //res.setHeader('Content-Type', 'text');
            res.setHeader('Transfer-Encoding', 'chunked');

            const reader = response.body?.getReader();
            const decoder = new TextDecoder();

            if (reader) {
                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;
                    res.write(decoder.decode(value));
                }
                res.end();
            } else {
                throw new Error('Unable to read response stream');
            }
        } catch (error) {
            console.error('Error running assistant:', error);
            res.status(500).json({ error: 'Error running assistant' });
        }
    } else {
        res.setHeader('Allow', ['POST']);
        res.status(405).end(`Method ${req.method} Not Allowed`);
    }
};
