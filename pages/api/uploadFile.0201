//api/uploadFile.ts
import { NextApiRequest, NextApiResponse } from 'next';
import formidable, { File } from 'formidable';
import fs from 'fs/promises';
import path from 'path';
import { createClient } from '@vercel/kv';
import { put, PutBlobResult, list, del } from '@vercel/blob';
import { OpenAI } from 'openai';
import { Pinecone } from '@pinecone-database/pinecone';

export const config = {
    api: {
        bodyParser: false,
    },
};

const kv = createClient({
    url: process.env.KV_REST_API_URL!,
    token: process.env.KV_REST_API_TOKEN!,
});

const openai = new OpenAI({ apiKey: process.env.OPENAI_API_KEY });
const pc = new Pinecone({ apiKey: process.env.PINECONE_API_KEY! });

const uploadDirectory = path.join(process.cwd(), 'uploads');
const CHUNK_SIZE = 1000;
const MAX_RETRIES = 3;
const INITIAL_RETRY_DELAY = 1000; // 1 second
const INDEX_NAME = 'user-documents';
const DIMENSION = 1536; // For OpenAI's text-embedding-ada-002 model

async function ensureUploadDirectory() {
    try {
        await fs.access(uploadDirectory);
    } catch (error) {
        await fs.mkdir(uploadDirectory);
    }
}

async function embedTextWithRetry(text: string, retries = MAX_RETRIES): Promise<number[]> {
    try {
        const response = await openai.embeddings.create({
            model: "text-embedding-ada-002",
            input: text,
        });
        return response.data[0].embedding;
    } catch (error: any) {
        if (error.status === 429 && retries > 0) {
            const delay = INITIAL_RETRY_DELAY * (MAX_RETRIES - retries + 1);
            console.log(`Rate limit reached. Retrying in ${delay}ms...`);
            await new Promise(resolve => setTimeout(resolve, delay));
            return embedTextWithRetry(text, retries - 1);
        }
        throw error;
    }
}

function splitTextIntoChunks(text: string, chunkSize: number = CHUNK_SIZE): string[] {
    const words = text.split(/\s+/);
    const chunks = [];
    let currentChunk = [];

    for (const word of words) {
        if (currentChunk.join(' ').length + word.length > chunkSize) {
            chunks.push(currentChunk.join(' '));
            currentChunk = [];
        }
        currentChunk.push(word);
    }

    if (currentChunk.length > 0) {
        chunks.push(currentChunk.join(' '));
    }

    return chunks;
}

async function getOrCreateIndex() {
    try {
        return await pc.Index(INDEX_NAME);
    } catch (error) {
        // If the index doesn't exist, create it
        await pc.createIndex({
            name: INDEX_NAME,
            dimension: DIMENSION,
            metric: 'cosine',
            spec: {
                serverless: {
                    cloud: 'aws',
                    region: 'us-east-1'
                }
            }
        });
        // Wait for the index to be created
        await new Promise(resolve => setTimeout(resolve, 60000));
        return pc.Index(INDEX_NAME);
    }
}

async function retryOperation<T>(operation: () => Promise<T>, maxRetries = 3): Promise<T> {
    let lastError;
    for (let i = 0; i < maxRetries; i++) {
        try {
            return await operation();
        } catch (error) {
            lastError = error;
            await new Promise(resolve => setTimeout(resolve, 1000 * Math.pow(2, i)));
        }
    }
    throw lastError;
}

async function createAndStoreEmbeddings(userId: string, fileName: string, fileContent: string) {
    const index = await getOrCreateIndex();
    const chunks = splitTextIntoChunks(fileContent);
    const batchSize = 100;

    for (let i = 0; i < chunks.length; i += batchSize) {
        const batch = chunks.slice(i, i + batchSize);
        const asyncResults = await Promise.all(batch.map(async (chunk, index) => {
            const embedding = await embedTextWithRetry(chunk);
            return {
                id: `${fileName}-${i + index}`,
                values: embedding,
                metadata: {
                    userId,
                    fileName,
                    chunkIndex: i + index,
                    content: chunk
                }
            };
        }));

        await retryOperation(() => index.namespace(userId).upsert(asyncResults));
    }
}

