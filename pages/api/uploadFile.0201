export default async function handler(req: NextApiRequest, res: NextApiResponse) {
    if (req.method !== 'POST') {
        return res.status(405).json({ message: 'Method not allowed' });
    }

    const userId = req.headers['user-address'] as string;
    if (!userId) {
        return res.status(400).json({ message: 'User address is required' });
    }

    const form = formidable({ multiples: false });

    try {
        const { fields } = await new Promise<{ fields: formidable.Fields; files: formidable.Files }>(
            (resolve, reject) => {
                form.parse(req, (err, fields, files) => {
                    if (err) reject(err);
                    else resolve({ fields, files });
                });
            }
        );

        // Handle fields.text as a single string or the first element of an array of strings
        const text = Array.isArray(fields.text) ? fields.text[0] : fields.text;

        if (!text) {
            return res.status(400).json({ message: 'No text provided' });
        }

        await createAndStoreEmbeddings(userId, 'textInput', text);

        return res.status(200).json({
            message: 'Text uploaded and embeddings created successfully',
            embeddingsCreated: true,
        });
    } catch (error) {
        console.error('Error in text upload:', error);
        return res.status(500).json({ message: 'Error uploading text', error: (error as Error).message });
    }
}

