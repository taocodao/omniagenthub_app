import type { NextApiRequest, NextApiResponse } from "next";
import { createClient } from "@vercel/kv";

const kv = createClient({
    url: process.env.KV_REST_API_URL!,
    token: process.env.KV_REST_API_TOKEN!,
});

export default async function handler(
    req: NextApiRequest,
    res: NextApiResponse
) {
    if (req.method !== "GET") {
        return res.status(405).json({ error: "Method not allowed" });
    }

    const { userAddress } = req.query;
    if (!userAddress || typeof userAddress !== "string") {
        return res
            .status(400)
            .json({ error: "Missing or invalid userAddress parameter" });
    }

    try {
        //const companyName = await kv.get(`companyName:${userAddress.toLowerCase()}`);
        const companyName = await kv.get(`companyName:${userAddress}`);
        return res.status(200).json({ companyName });
    } catch (error) {
        console.error("Error fetching company name:", error);
        return res.status(500).json({ error: "Error retrieving company name" });
    }
}
