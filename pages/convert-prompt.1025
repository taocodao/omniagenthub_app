// pages/convert-prompt.tsx

import React, { useState, useEffect, useCallback } from 'react';
import Head from 'next/head';
import styles from '../styles/Home3.module.css';
import HashUtil from '../util/hashToFixedDigits'; // Ensure the correct path to HashUtil
import { put } from '@vercel/blob';
import { toast } from 'react-toastify';
import { useRouter } from 'next/router';
import SignIn from '../components/SignIn'; // Adjust the path as needed
import { useActiveAccount } from 'thirdweb/react';

const ConvertPrompt: React.FC = () => {
    // Initialize Active Account
    const address = useActiveAccount()?.address;

    // State Variables
    const [inputPrompt, setInputPrompt] = useState<string>('');
    const [outputMessage, setOutputMessage] = useState<string>('');
    const [department, setDepartment] = useState<string>('My Customized GPT'); // Set default to 'My Customized GPT'
    const [role, setRole] = useState<string>('');
    const [task, setTask] = useState<string>('');
    const [inputTask, setInputTask] = useState<string>('');
    const [departments, setDepartments] = useState<string[]>(['My Customized GPT']); // Initialize with 'My Customized GPT'
    const [roles, setRoles] = useState<string[]>([]);
    const [tasks, setTasks] = useState<string[]>([]);
    const [apiKey, setApiKey] = useState<string>('');
    const [user, setUser] = useState<string>('eric');
    const [price, setPrice] = useState<string>('0.01');
    const [userAddress, setUserAddress] = useState<string>(''); // New state for userAddress
    const [image, setImage] = useState<File | null>(null);
    const [uploadedImageUrl, setUploadedImageUrl] = useState<string>('');
    const [newDepartment, setNewDepartment] = useState<string>('');
    const [newRole, setNewRole] = useState<string>('');
    const [translateName, setTranslateName] = useState<string>('');
    const [translateContent, setTranslateContent] = useState<string>('');
    const [translatedNames, setTranslatedNames] = useState<string[]>([]);
    const [selectedTranslatedName, setSelectedTranslatedName] = useState<string>('');
    const [isConverting, setIsConverting] = useState<boolean>(false);
    const [isUploading, setIsUploading] = useState<boolean>(false);
    const [uploadedImageUrlTemp, setUploadedImageUrlTemp] = useState<string>(''); // Temporary image URL for preview
    const [inputTasks, setInputTasks] = useState<string[]>([]); // Task alternatives for the inputTask dropdown
    // Add these state variables
    const [isModalOpen, setIsModalOpen] = useState<boolean>(false);
    const [manualTaskInput, setManualTaskInput] = useState<string>('');
    const router = useRouter();

    // Handle Modal Submit
    const handleModalSubmit = async () => {
        if (!manualTaskInput.trim()) {
            toast.warning('Please enter a task.');
            return;
        }

        setIsModalOpen(false);

        // Proceed with the user-inputted task
        await processTask(manualTaskInput.trim());

        // Clear the manual task input
        setManualTaskInput('');
    };

    // Fetch Roles based on Department
    const fetchRoles = useCallback(async (dept: string) => {
        try {
            const response = await fetch('/api/get-roles', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ department: dept }),
            });

            if (!response.ok) {
                throw new Error('Failed to fetch roles.');
            }

            const data: { roles: string[] } = await response.json();
            setRoles(Array.isArray(data.roles) ? data.roles : []);
            if (data.roles.length > 0) {
                const initialRole = data.roles[data.roles.length - 1];
                setRole(initialRole);
                await fetchTasks(dept, initialRole);
            } else {
                setRole('');
                setTasks([]);
            }
        } catch (error) {
            console.error('Error fetching roles:', error);
            toast.error('Error fetching roles.');
            setRoles([]);
        }
    }, []);

    // Fetch Translated Names on Mount
    useEffect(() => {
        fetchTranslatedNames();
    }, []);

    const fetchTranslatedNames = useCallback(async () => {
        try {
            const response = await fetch('/api/get-translated-names');
            if (response.ok) {
                const names: string[] = await response.json();
                setTranslatedNames(names);
            } else {
                throw new Error('Failed to fetch translated names.');
            }
        } catch (error) {
            console.error('Error fetching translated names:', error);
            toast.error('Error fetching translated names.');
        }
    }, []);

    // Fetch Departments and Initial Roles
    useEffect(() => {
        const fetchData = async () => {
            try {
                const departmentResponse = await fetch('/api/get-departments');
                if (!departmentResponse.ok) {
                    throw new Error('Failed to fetch departments.');
                }
                const departmentData: string[] = await departmentResponse.json();
                // Ensure 'My Customized GPT' is always present
                const updatedDepartments = Array.from(new Set(['My Customized GPT', ...departmentData]));
                setDepartments(updatedDepartments);
                if (updatedDepartments.length > 0) {
                    const initialDepartment = updatedDepartments.find(dep => dep === 'My Customized GPT') || updatedDepartments[0];
                    setDepartment(initialDepartment);
                    await fetchRoles(initialDepartment);
                }
            } catch (error) {
                console.error('Error fetching departments:', error);
                toast.error('Error fetching departments.');
            }
        };

        fetchData();
    }, [fetchRoles]);

    // Handle Update Translation
    const handleUpdateTranslation = useCallback(async () => {
        if (selectedTranslatedName && translateContent) {
            try {
                // Optional: Confirm the update action with the user
                const confirmUpdate = window.confirm(`Are you sure you want to update the translation for "${selectedTranslatedName}"?`);
                if (!confirmUpdate) return;

                // Send the updated translation to the backend API
                const response = await fetch('/api/update-translation', { // Ensure this endpoint exists
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        name: selectedTranslatedName, // Assuming the backend identifies translations by name
                        content: translateContent,
                        language: "English",
                    }),
                });

                if (!response.ok) {
                    throw new Error('Failed to update translation.');
                }

                // Optionally, handle the response data
                const data = await response.json();
                console.log('Translation updated:', data);

                toast.success('Translation updated successfully.');
            } catch (error) {
                console.error('Error updating translation:', error);
                toast.error('Error updating translation.');
            }
        } else {
            toast.warning('Please select a translated name and provide content to update.');
        }
    }, [selectedTranslatedName, translateContent]);

    // Fetch Tasks based on Department and Role
    const fetchTasks = useCallback(async (dept: string, rl: string) => {
        try {
            const response = await fetch('/api/get-tasks', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ department: dept, role: rl }),
            });

            if (!response.ok) {
                throw new Error('Failed to fetch tasks.');
            }

            const data: { tasks: string[] } = await response.json();
            setTasks(Array.isArray(data.tasks) ? data.tasks : []);
            if (data.tasks.length > 0) {
                setTask(data.tasks[data.tasks.length - 1]);
            } else {
                setTask('');
            }
        } catch (error) {
            console.error('Error fetching tasks:', error);
            toast.error('Error fetching tasks.');
            setTasks([]);
        }
    }, []);

    // Translate and Store Content
    const translateAndStoreContent = useCallback(async (name: string, content: string) => {
        try {
            const response = await fetch('/api/set_content_in_language', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ name, content }),
            });

            if (!response.ok) {
                throw new Error(`Failed to translate and store content for name: ${name}`);
            }

            const result = await response.json();
            console.log(`Content translated and stored for all languages`, result);
            toast.success(`Content translated and stored for all languages for name ${name}`);
        } catch (error) {
            console.error('Error translating and storing content:', error);
            toast.error(`Error translating and storing content for name ${name}.`);
        }
    }, []);

    // Handle Translate
    const handleTranslate = useCallback(async () => {
        if (translateName && translateContent) {
            const labeledName = `label:${translateName.trim()}`;
            await translateAndStoreContent(labeledName, translateContent);
            setTranslateName('');
            setTranslateContent('');
            fetchTranslatedNames();
        } else {
            toast.warning('Please provide both name and content for translation.');
        }
    }, [translateName, translateContent, translateAndStoreContent, fetchTranslatedNames]);

    // Handle Convert Prompt
    const handleConvert = useCallback(async () => {
        if (!inputPrompt.trim()) {
            toast.warning('Please enter a prompt.');
            return;
        }

        if (!department || !role || !task) {
            toast.warning('Please select a department, role, and task.');
            return;
        }

        setIsConverting(true);

        try {
            const response = await fetch('/api/convert-prompt', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ department, role, task, prompt: inputPrompt.trim() }), // Send department, role, task, and prompt to the backend
            });

            if (!response.ok) {
                throw new Error('Failed to convert prompt.');
            }

            const data: { instruction: string | object } = await response.json();
            const instruction = data.instruction;

            // Update the output message with the converted instruction
            if (typeof instruction === 'object') {
                setOutputMessage(JSON.stringify(instruction, null, 2));
            } else {
                setOutputMessage(instruction);
            }

            // Clear the input fields upon success
            setInputPrompt('');
            //setTask(''); // Clear task if desired
            toast.success('Prompt converted successfully.');
        } catch (error) {
            console.error('Error converting prompt:', error);
            setOutputMessage('An error occurred while converting the prompt.');
            toast.error('Error converting prompt.');
        } finally {
            setIsConverting(false);
        }
    }, [inputPrompt, department, role, task]);

    // Handle Add Prompt
    const handleAddPrompt = useCallback(async () => {
        if (!inputTask.trim()) {
            toast.warning('Please select or enter a task.');
            return;
        }

        if (!inputPrompt.trim()) {
            toast.warning('Please enter a prompt.');
            return;
        }

        if (!department || !role) {
            toast.warning('Please select a department and role.');
            return;
        }

        try {
            const response = await fetch('/api/convert-prompt', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ department, role, task: inputTask.trim(), prompt: inputPrompt.trim() }),
            });

            if (!response.ok) {
                throw new Error('Failed to add prompt.');
            }

            const data: { instruction: string | object } = await response.json();
            const instruction = data.instruction;

            if (typeof instruction === 'object') {
                setOutputMessage(JSON.stringify(instruction, null, 2));
            } else {
                setOutputMessage(instruction);
            }

            setInputPrompt('');
            setInputTask('');
            setInputTasks([]); // Clear the inputTasks after adding

            // Optionally, add the new task to the existing tasks if it's not already there
            if (!tasks.includes(inputTask.trim())) {
                setTasks((prevTasks) => [...prevTasks, inputTask.trim()]);
            }

            toast.success('Prompt added successfully.');
        } catch (error) {
            console.error('Error adding prompt:', error);
            setOutputMessage('Error adding prompt.');
            toast.error('Error adding prompt.');
        }
    }, [inputTask, inputPrompt, department, role, tasks]);

    // Handle Add Department
    const handleAddDepartment = useCallback(async () => {
        const trimmedDepartment = newDepartment.trim();
        if (trimmedDepartment && !departments.includes(trimmedDepartment)) {
            try {
                // Optionally, make an API call to add the department to the backend
                // await fetch('/api/add-department', { ... });

                // Translate and store the new department
                // await translateAndStoreContent(trimmedDepartment, trimmedDepartment);

                setDepartments((prev) => [...prev, trimmedDepartment]);
                setDepartment(trimmedDepartment);
                await fetchRoles(trimmedDepartment);
                setNewDepartment('');
                resetFields();
                toast.success('Department added successfully.');
            } catch (error) {
                console.error('Error adding department:', error);
                toast.error('Error adding department.');
            }
        } else if (departments.includes(trimmedDepartment)) {
            toast.warning('Department already exists.');
        } else {
            toast.warning('Please enter a valid department name.');
        }
    }, [newDepartment, departments, fetchRoles, translateAndStoreContent]);

    // Handle Add Role
    const handleAddRole = async () => {
        let finalRole = newRole.trim();
        let finalUserAddress = userAddress.trim(); // Get the trimmed userAddress

        if (!finalRole) {
            toast.warning('Please enter a role name.');
            return;
        }

        // Check if the selected department is 'My Customized GPT'
        if (department === 'My Customized GPT') {
            finalRole = `My ${finalRole}`; // Prefix 'My ' to the role name

            if (!finalUserAddress) {
                toast.warning('Please enter a User Address for the customized GPT.');
                return;
            }
        }

        if (finalRole && !roles.includes(finalRole)) {
            try {
                // Ensure that new role is added without resetting existing tasks
                setRoles((prev) => [...prev, finalRole]);  // Add the new role to the existing list
                setRole(finalRole);  // Set the newly added role as the selected one

                // Fetch tasks for the new role
                const response = await fetch('/api/get-tasks', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ department, role: finalRole }),
                });

                if (!response.ok) {
                    throw new Error('Failed to fetch tasks for the new role');
                }

                const data = await response.json();
                setTasks(Array.isArray(data.tasks) ? data.tasks : []);  // Set the tasks associated with the new role

                setNewRole('');  // Clear the newRole input field after adding
                if (department === 'My Customized GPT') {
                    setUserAddress(''); // Clear the userAddress input field after adding
                }
                toast.success('Role added successfully.');
            } catch (error) {
                console.error('Error adding role:', error);
                toast.error('Error adding role.');
            }
        } else if (roles.includes(finalRole)) {
            toast.warning('Role already exists.');
        }
    };

    // Handle Add Role Mappings
    const handleAddRoleMappings = useCallback(async () => {
        if (!department || !role || !price) {
            toast.warning('Please select a department, role, and provide a price.');
            return;
        }

        // If department is 'My Customized GPT', userAddress becomes mandatory
        if (department === 'My Customized GPT' && !userAddress.trim()) {
            toast.warning('Please enter a User Address for the customized GPT.');
            return;
        }

        try {
            let imageUrl = uploadedImageUrl;

            // Upload image if selected and not yet uploaded
            if (image && !imageUrl) {
                setIsUploading(true);
                try {
                    const blob = await put(image.name, image, {
                        access: 'public',
                        token: process.env.NEXT_PUBLIC_BLOB_READ_WRITE_TOKEN || '',
                    });
                    imageUrl = blob.url;
                    setUploadedImageUrl(imageUrl);
                } catch (uploadError) {
                    console.error('Error uploading image:', uploadError);
                    toast.error('Failed to upload image. Please try again.');
                    return;
                } finally {
                    setIsUploading(false);
                }
            }

            // Prepare form data
            const formData = new FormData();
            formData.append('department', department);
            formData.append('role', role);
            formData.append('apiKey', apiKey || '');
            formData.append('user', user);
            formData.append('price', price);
            if (imageUrl) {
                formData.append('image', imageUrl);
            }

            // If department is 'My Customized GPT', include userAddress
            if (department === 'My Customized GPT') {
                formData.append('userAddress', userAddress.trim());
            }

            const response = await fetch('/api/add-role-mappings', {
                method: 'POST',
                body: formData,
            });

            if (!response.ok) {
                throw new Error('Failed to add role mappings.');
            }

            await fetchRoles(department);

            // Reset fields after successful addition
            resetFields();
            setUploadedImageUrl('');
            setUserAddress(''); // Clear userAddress after adding
            toast.success('Role mappings added successfully.');
        } catch (error) {
            console.error('Error adding role mappings:', error);
            toast.error('Error adding role mappings.');
        }
    }, [
        department,
        role,
        user,
        apiKey,
        price,
        image,
        uploadedImageUrl,
        userAddress,
        fetchRoles,
        translateAndStoreContent,
    ]);

    // Handle Refresh Departments
    const handleRefreshDepartments = useCallback(async () => {
        try {
            const response = await fetch('/api/get-departments');
            if (!response.ok) {
                throw new Error('Failed to fetch departments.');
            }
            const data: string[] = await response.json();
            // Ensure 'My Customized GPT' is always present
            const updatedDepartments = Array.from(new Set(['My Customized GPT', ...data]));
            setDepartments(updatedDepartments);
            if (updatedDepartments.length > 0) {
                setDepartment(updatedDepartments.find(dep => dep === 'My Customized GPT') || updatedDepartments[0]);
                await fetchRoles(updatedDepartments.find(dep => dep === 'My Customized GPT') || updatedDepartments[0]);
            }
            toast.success('Departments refreshed successfully.');
        } catch (error) {
            console.error('Error refreshing departments:', error);
            toast.error('Error refreshing departments.');
        }
    }, [fetchRoles]);

    // Handle Refresh Roles
    const handleRefreshRoles = useCallback(async () => {
        if (department) {
            await fetchRoles(department);
            toast.success('Roles refreshed successfully.');
        } else {
            toast.warning('No department selected.');
        }
    }, [department, fetchRoles]);

    // Handle Retrieve Role Mappings
    const handleRetrieve = useCallback(async () => {
        if (!department || !role) {
            toast.warning('Please select a department and role.');
            return;
        }

        try {
            const response = await fetch('/api/get-role-mappings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ department, role }),
            });

            if (!response.ok) {
                throw new Error('Failed to retrieve role mappings.');
            }

            const data: {
                apiKey?: string;
                user?: string;
                price?: string;
                image?: string;
                userAddress?: string; // Include userAddress
            } = await response.json();

            setApiKey(data.apiKey || '');
            setUser(data.user || 'eric');
            setPrice(data.price || '0.01');
            setUserAddress(data.userAddress || ''); // Set userAddress if available
            if (data.image) {
                setUploadedImageUrl(data.image);
            } else {
                setUploadedImageUrl('');
            }

            toast.success('Role mappings retrieved successfully.');
        } catch (error) {
            console.error('Error retrieving role mappings:', error);
            toast.error('Error retrieving role mappings.');
        }
    }, [department, role]);

    // Handle Update Role Mappings
    const handleUpdate = useCallback(async () => {
        if (!department || !role) {
            toast.warning('Please select a department and role.');
            return;
        }

        // If department is 'My Customized GPT', userAddress is required
        if (department === 'My Customized GPT' && !userAddress.trim()) {
            toast.warning('Please enter a User Address for the customized GPT.');
            return;
        }

        const formData = new FormData();
        formData.append('department', department);
        formData.append('role', role);
        formData.append('apiKey', apiKey);
        formData.append('user', user);
        formData.append('price', price);
        if (uploadedImageUrl) {
            formData.append('image', uploadedImageUrl);
        }

        // Include userAddress if department is 'My Customized GPT'
        if (department === 'My Customized GPT') {
            formData.append('userAddress', userAddress.trim());
        }

        try {
            const response = await fetch('/api/update-role-mappings', {
                method: 'POST',
                body: formData,
            });

            if (!response.ok) {
                throw new Error('Failed to update role mappings.');
            }

            await fetchRoles(department);
            setUploadedImageUrl('');
            if (department === 'My Customized GPT') {
                setUserAddress(''); // Clear userAddress after updating
            }

            toast.success('Role mappings updated successfully.');
        } catch (error) {
            console.error('Error updating role mappings:', error);
            toast.error('Error updating role mappings.');
        }
    }, [department, role, apiKey, user, price, uploadedImageUrl, userAddress, fetchRoles]);

    // Handle Department Change
    const handleDepartmentChange = useCallback(
        async (value: string) => {
            setDepartment(value);
            if (value) {
                await fetchRoles(value);
            }
            resetFields();
        },
        [fetchRoles]
    );

    // Handle Role Change
    const handleRoleChange = useCallback(
        async (value: string) => {
            setRole(value);
            if (department && value) {
                await fetchTasks(department, value);
            }
            resetFields();
        },
        [department, fetchTasks]
    );

    // Handle Image Upload
    const handleImageUpload = useCallback(async (event: React.ChangeEvent<HTMLInputElement>) => {
        const file = event.target.files?.[0];
        if (!file) return;

        try {
            setIsUploading(true);

            // Upload to Vercel Blob
            const blob = await put(file.name, file, {
                access: 'public',
                token: process.env.NEXT_PUBLIC_BLOB_READ_WRITE_TOKEN || '',
            });

            setUploadedImageUrl(blob.url);
            setUploadedImageUrlTemp(blob.url); // For preview
            toast.success('Image uploaded successfully.');
        } catch (error) {
            console.error('Error uploading image:', error);
            toast.error('Failed to upload image. Please try again.');
        } finally {
            setIsUploading(false);
        }
    }, []);

    const processTask = useCallback(async (taskToProcess: string) => {

        //const cleanedTask = taskToProcess.replace(/[^\w\s]/gi, '');
        // Trim leading and trailing whitespace, remove extra spaces, and remove a period at the end if present
        const cleanedTask = taskToProcess
            .trim()
            .replace(/\s+/g, ' ')        // Replace multiple spaces with a single space
            .replace(/\.$/, '');         // Remove period at the end if present

        // Set the cleaned task as the selected task
        setInputTask(cleanedTask);

        try {
            // Call the backend to get six alternative phrases for the task
            const response = await fetch('/api/get-task-alternatives', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ task: cleanedTask }),
            });

            if (!response.ok) {
                throw new Error('Failed to get task alternatives.');
            }

            const data: { alternatives: string[] } = await response.json();
            const cleanedAlternatives = data.alternatives;

            // Populate inputTasks with the cleaned task and its alternatives
            setInputTasks([cleanedTask, ...cleanedAlternatives]);
        } catch (error) {
            console.error('Error fetching task alternatives:', error);
            toast.error('Error fetching task alternatives.');
        }
    }, []);

    // Handle Input Prompt Change
    const handleInputPromptChange = useCallback(async (e: React.ChangeEvent<HTMLTextAreaElement>) => {
        const prompt = e.target.value;
        setInputPrompt(prompt);

        // Parse the prompt to get the task
        const parsedPrompt = parsePrompt(prompt);
        let originalTask = parsedPrompt.task;

        if (!originalTask) {
            // Open modal to allow user to input the task manually
            setIsModalOpen(true);
            return;
        }

        // Proceed with the original task
        await processTask(originalTask);
    }, [processTask]);

    // Handle Retrieve Instruction
    const handleRetrieveInstruction = useCallback(async () => {
        if (!role || !task) {
            toast.warning('Please select a role and task.');
            return;
        }

        try {
            const assistantId = HashUtil.hashTo(`${role}${task}`);
            const response = await fetch('/api/get-instruction', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ assistantId }),
            });

            if (!response.ok) {
                throw new Error('Failed to retrieve instruction.');
            }

            const data: { instruction?: string } = await response.json();
            setOutputMessage(data.instruction || '');
            toast.success('Instruction retrieved successfully.');
        } catch (error) {
            console.error('Error retrieving instruction:', error);
            toast.error('Error retrieving instruction.');
        }
    }, [role, task]);

    // Handle Update Instruction
    const handleUpdateInstruction = useCallback(async () => {
        if (!role || !task) {
            toast.warning('Please select a role and task.');
            return;
        }

        if (!inputPrompt.trim()) {
            toast.warning('Please enter a prompt.');
            return;
        }

        setIsConverting(true);

        try {
            // Convert the prompt
            const response = await fetch('/api/convert-prompt', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ department, role, task, prompt: inputPrompt.trim() }), // Convert with the current prompt, role, and task
            });

            if (!response.ok) {
                throw new Error('Failed to update instruction.');
            }

            const data: { instruction: string | object } = await response.json();
            const instruction = data.instruction;

            // Update output message with the converted instruction
            if (typeof instruction === 'object') {
                setOutputMessage(JSON.stringify(instruction, null, 2));
            } else {
                setOutputMessage(instruction);
            }

            // Send updated instruction back to the backend
            const assistantId = HashUtil.hashTo(`${role}${task}`);
            const updateResponse = await fetch('/api/update-instruction', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ assistantId, instruction: outputMessage }), // Save the updated instruction
            });

            if (!updateResponse.ok) {
                throw new Error('Failed to update instruction.');
            }

            // Clear the input fields after update
            setInputPrompt('');
            //setTask('');
            toast.success('Instruction updated successfully.');
        } catch (error) {
            console.error('Error updating instruction:', error);
            setOutputMessage('An error occurred while updating the instruction.');
            toast.error('Error updating instruction.');
        } finally {
            setIsConverting(false);
        }
    }, [inputPrompt, department, role, task, outputMessage]);

    // Handle Retrieve Translation
    const handleRetrieveTranslation = useCallback(async () => {
        if (selectedTranslatedName) {
            try {
                const response = await fetch('/api/get_content_in_language', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        name: selectedTranslatedName,
                        language: 'English',
                    }),
                });

                if (response.ok) {
                    const data: { content?: string } = await response.json();
                    if (data.content) {
                        setTranslateName(selectedTranslatedName.replace('label:', ''));
                        setTranslateContent(data.content);
                        toast.success('Translation retrieved successfully.');
                    } else {
                        throw new Error(`No content found for the selected name ${selectedTranslatedName}`);
                    }
                } else {
                    throw new Error('Failed to retrieve translation.');
                }
            } catch (error) {
                console.error('Error retrieving translation:', error);
                toast.error(`Error retrieving translation: ${error}`);
            }
        } else {
            toast.warning('Please select a translated name.');
        }
    }, [selectedTranslatedName]);

    // Reset Fields
    const resetFields = useCallback(() => {
        setApiKey('');
        setUser('eric');
        setPrice('0.01');
        setImage(null);
        setUploadedImageUrlTemp('');
        if (department === 'My Customized GPT') {
            setUserAddress(''); // Reset userAddress if applicable
        }
        // setImagePreview(null); // If image preview is used
    }, [department]);

    // Parse Prompt (Utility Function)
    /* const parsePrompt = useCallback((prompt: string) => {
         const roleMatch = prompt.match(/"role":"([^"]+)"/);
         const departmentMatch = prompt.match(/"department":"([^"]+)"/);
         const taskMatch = prompt.match(/"task":"([^"]+)"/);
 
         return {
             role: roleMatch ? roleMatch[1] : '',
             department: departmentMatch ? departmentMatch[1] : '',
             task: taskMatch ? taskMatch[1] : '',
         };
     }, []);*/
    const parsePrompt = useCallback((prompt: string) => {
        try {
            const parsed = JSON.parse(prompt);
            return {
                role: parsed.role || '',
                department: parsed.department || '',
                task: parsed.task || '',
            };
        } catch (error) {
            console.error('Error parsing prompt JSON:', error);
            toast.error('Invalid JSON format. Please ensure your prompt is correctly formatted.');
            return {
                role: '',
                department: '',
                task: '',
            };
        }
    }, []);


    // New function to handle updating the role's department
    const handleUpdateRoleDepartment = async () => {
        if (!department || !role || !newDepartment.trim()) {
            toast.warning('Please select a role and provide the new department name.');
            return;
        }

        const confirmUpdate = window.confirm(`Are you sure you want to move the role "${role}" from "${department}" to "${newDepartment}"?`);

        if (!confirmUpdate) return;

        try {
            const response = await fetch('/api/update-role-department', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    currentDepartment: department,
                    role,
                    newDepartment: newDepartment.trim(),
                }),
            });

            if (!response.ok) {
                throw new Error('Failed to update role department.');
            }

            // Refresh departments, roles, and tasks
            await handleRefreshDepartments();
            setDepartment(newDepartment.trim());
            await fetchRoles(newDepartment.trim());

            toast.success('Role department updated successfully.');
            setNewDepartment(''); // Clear the new department input
        } catch (error) {
            console.error('Error updating role department:', error);
            toast.error('Error updating role department.');
        }
    };

    return (
        <div className={styles.container}>
            <Head>
                <title>Convert Prompt</title>
                <meta name="description" content="Convert Prompt to structured format" />
                <link rel="icon" href="/favicon.ico" />
            </Head>

            {!address ? (
                <SignIn />
            ) : (
                <>
                    <h1 className={styles.title} style={{ textAlign: 'center' }}>
                        Convert Prompt
                    </h1>

                    <div className={styles.grid}>
                        {/* Section 1: Department, Role, API Key, User, Price, User Address, Image */}
                        <div className={styles.section1}>
                            <div className={`${styles.card} ${styles.row}`}>
                                {/* Department Management */}
                                <div className={styles.inputGroup}>
                                    <label htmlFor="department-select"><h3>Department</h3></label>
                                    <select
                                        id="department-select"
                                        value={department}
                                        onChange={(e) => handleDepartmentChange(e.target.value)}
                                        style={{ padding: '8px', marginBottom: '10px' }}
                                    >
                                        {departments.map((dep, index) => (
                                            <option key={index} value={dep}>
                                                {dep}
                                            </option>
                                        ))}
                                    </select>
                                    <input
                                        type="text"
                                        value={newDepartment}
                                        onChange={(e) => setNewDepartment(e.target.value)}
                                        placeholder="New Department"
                                        style={{ padding: '8px', marginBottom: '10px' }}
                                    />
                                    <button onClick={handleAddDepartment} style={{ marginTop: '10px' }}>
                                        Add
                                    </button>
                                    {/* **Update Department Button** */}
                                    <button onClick={handleUpdateRoleDepartment} style={{ marginTop: '10px' }}>
                                        Update Department
                                    </button>
                                </div>

                                {/* Role Management */}
                                <div className={styles.inputGroup}>
                                    <label htmlFor="role-select"><h3>Role</h3></label>
                                    <select
                                        id="role-select"
                                        value={role}
                                        onChange={(e) => handleRoleChange(e.target.value)}
                                        style={{ padding: '8px', marginBottom: '10px' }}
                                    >
                                        {roles.map((rl, index) => (
                                            <option key={index} value={rl}>
                                                {rl}
                                            </option>
                                        ))}
                                    </select>
                                    <input
                                        type="text"
                                        value={newRole}
                                        onChange={(e) => setNewRole(e.target.value)}
                                        placeholder="New Role"
                                        style={{ padding: '8px', marginBottom: '10px' }}
                                    />
                                    <button onClick={handleAddRole} style={{ marginTop: '10px' }}>
                                        Add
                                    </button>
                                </div>

                                {/* API Key */}
                                <div className={styles.inputGroup}>
                                    <label htmlFor="apiKey-input"><h3>API Key</h3></label>
                                    <input
                                        id="apiKey-input"
                                        type="text"
                                        value={apiKey}
                                        onChange={(e) => setApiKey(e.target.value)}
                                        style={{ padding: '8px', marginBottom: '10px' }}
                                        placeholder="Enter API Key"
                                    />
                                </div>

                                {/* **User Address (New Field) */}
                                {department === 'My Customized GPT' && (
                                    <div className={styles.inputGroup}>
                                        <label htmlFor="userAddress-input"><h3>User Address</h3></label>
                                        <input
                                            id="userAddress-input"
                                            type="text"
                                            value={userAddress}
                                            onChange={(e) => setUserAddress(e.target.value)}
                                            style={{ padding: '8px', marginBottom: '10px' }}
                                            placeholder="User address for the customized GPT"
                                            required
                                        />
                                    </div>
                                )}
                            </div>

                            {/* Additional Inputs for Section 1 */}
                            <div className={`${styles.card} ${styles.row}`}>
                                {/* User */}
                                <div className={styles.inputGroup}>
                                    <label htmlFor="user-input"><h3>User</h3></label>
                                    <input
                                        id="user-input"
                                        type="text"
                                        value={user}
                                        onChange={(e) => setUser(e.target.value)}
                                        style={{ padding: '8px', marginBottom: '10px' }}
                                        placeholder="Enter User"
                                    />
                                </div>

                                {/* Price */}
                                <div className={styles.inputGroup}>
                                    <label htmlFor="price-input"><h3>Price</h3></label>
                                    <input
                                        id="price-input"
                                        type="text"
                                        value={price}
                                        onChange={(e) => setPrice(e.target.value)}
                                        style={{ padding: '8px', marginBottom: '10px' }}
                                        placeholder="Enter Price"
                                    />
                                </div>

                                {/* Image Upload */}
                                <div className={styles.inputGroup}>
                                    <label htmlFor="image-upload"><h3>Image</h3></label>
                                    {uploadedImageUrl && (
                                        <div className="mt-4">
                                            <img
                                                src={uploadedImageUrl}
                                                alt="Uploaded"
                                                style={{ width: '100px', marginBottom: '10px' }}
                                                className="max-w-full h-auto"
                                            />
                                        </div>
                                    )}
                                    <input
                                        id="image-upload"
                                        type="file"
                                        accept="image/*"
                                        onChange={handleImageUpload}
                                        style={{ padding: '8px', marginBottom: '10px' }}
                                    />
                                    {isUploading && <p>Uploading image...</p>}
                                </div>
                            </div>

                            {/* Buttons for Section 1 */}
                            <div className={`${styles.card} ${styles.row}`} style={{ justifyContent: 'center' }}>
                                <button onClick={handleAddRoleMappings} style={{ margin: '10px' }}>
                                    Add Role
                                </button>
                                <button onClick={handleRetrieve} style={{ margin: '10px' }}>
                                    Retrieve
                                </button>
                                <button onClick={handleUpdate} style={{ margin: '10px' }}>
                                    Update
                                </button>

                                <button
                                    onClick={async () => {
                                        if (role) {
                                            try {
                                                const response = await fetch('/api/delete-role', {
                                                    method: 'POST',
                                                    headers: { 'Content-Type': 'application/json' },
                                                    body: JSON.stringify({ department, role }),
                                                });
                                                if (!response.ok) {
                                                    throw new Error('Failed to delete role.');
                                                }
                                                setRoles((prevRoles) => prevRoles.filter((r) => r !== role)); // Remove role locally
                                                setRole(''); // Clear the selected role
                                                toast.success('Role deleted successfully.');
                                            } catch (error) {
                                                console.error('Error deleting role:', error);
                                                toast.error('Error deleting role.');
                                            }
                                        } else {
                                            toast.warning('No role selected.');
                                        }
                                    }}
                                    style={{ margin: '10px', backgroundColor: 'red', color: 'white' }}
                                >
                                    Delete Role
                                </button>

                            </div>
                        </div>

                        {/* Section 2: Department, Role, Task Selection with Refresh Buttons */}
                        <div className={`${styles.card} ${styles.row}`}>
                            {/* Department Selection */}
                            <div className={styles.inputGroup}>
                                <label htmlFor="department-select-2"><h3>Department</h3></label>
                                <select
                                    id="department-select-2"
                                    value={department}
                                    onChange={(e) => handleDepartmentChange(e.target.value)}
                                    style={{ padding: '8px', marginBottom: '10px' }}
                                >
                                    {departments.map((dep, index) => (
                                        <option key={index} value={dep}>
                                            {dep}
                                        </option>
                                    ))}
                                </select>
                                <button onClick={handleRefreshDepartments} style={{ marginTop: '10px' }}>
                                    Refresh
                                </button>
                            </div>

                            {/* Role Selection */}
                            <div className={styles.inputGroup}>
                                <label htmlFor="role-select-2"><h3>Role</h3></label>
                                <select
                                    id="role-select-2"
                                    value={role}
                                    onChange={(e) => handleRoleChange(e.target.value)}
                                    style={{ padding: '8px', marginBottom: '10px' }}
                                >
                                    {roles.map((rl, index) => (
                                        <option key={index} value={rl}>
                                            {rl}
                                        </option>
                                    ))}
                                </select>
                                <button onClick={handleRefreshRoles} style={{ marginTop: '10px' }}>
                                    Refresh
                                </button>
                            </div>

                            {/* Task Selection */}
                            <div className={styles.inputGroup}>
                                <label htmlFor="task-select"><h3>Task</h3></label>
                                <select
                                    id="task-select"
                                    value={task}
                                    onChange={(e) => setTask(e.target.value)}
                                    style={{ padding: '8px', marginBottom: '10px' }}
                                >
                                    {tasks.map((tk, index) => (
                                        <option key={index} value={tk}>
                                            {tk}
                                        </option>
                                    ))}
                                </select>

                                <select
                                    id="input-task-select"
                                    value={inputTask}
                                    onChange={(e) => setInputTask(e.target.value)}
                                    style={{ padding: '8px', marginBottom: '10px' }}
                                >
                                    <option value="" disabled>Select a task</option> {/* Placeholder option */}
                                    {inputTasks.map((tk, index) => (
                                        <option key={index} value={tk}>
                                            {tk}
                                        </option>
                                    ))}
                                </select>
                            </div>

                        </div>

                        {/* Section 3: Input Prompt and Output Message */}
                        <div className={styles.card}>
                            {/* Input Prompt */}
                            <h3>Input Prompt</h3>
                            <textarea
                                value={inputPrompt}
                                onChange={handleInputPromptChange}
                                rows={10}
                                cols={50}
                                style={{ width: '90%', padding: '8px', marginBottom: '10px' }}
                                placeholder="Enter your prompt here..."
                            />
                            <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '10px' }}>
                                <button onClick={handleConvert} style={{ marginRight: '10px' }} disabled={isConverting}>
                                    {isConverting ? 'Converting...' : 'Convert'}
                                </button>
                                <button onClick={handleAddPrompt} style={{ marginRight: '10px' }}>
                                    Add
                                </button>
                            </div>
                        </div>

                        <div className={styles.card} style={{ width: '100%' }}>
                            {/* Output Message */}
                            <h3>Output Message</h3>
                            <textarea
                                value={outputMessage}
                                onChange={(e) => setOutputMessage(e.target.value)}
                                rows={10}
                                cols={50}
                                style={{ width: '90%', padding: '8px', marginTop: '10px' }}
                                placeholder="Output will appear here..."
                            />
                            <div style={{ display: 'flex', justifyContent: 'space-between', marginTop: '10px' }}>
                                <button onClick={handleRetrieveInstruction} style={{ marginRight: '10px' }}>
                                    Retrieve
                                </button>
                                <button onClick={handleUpdateInstruction} style={{ marginRight: '10px' }}>
                                    Update
                                </button>
                                <button
                                    onClick={async () => {
                                        if (task) {
                                            try {
                                                const response = await fetch('/api/delete-task', {
                                                    method: 'POST',
                                                    headers: { 'Content-Type': 'application/json' },
                                                    body: JSON.stringify({ department, role, task }),
                                                });
                                                if (!response.ok) {
                                                    throw new Error('Failed to delete task.');
                                                }
                                                setTasks((prevTasks) => prevTasks.filter((t) => t !== task)); // Remove task locally
                                                setTask(''); // Clear the selected task
                                                toast.success('Task deleted successfully.');
                                            } catch (error) {
                                                console.error('Error deleting task:', error);
                                                toast.error('Error deleting task.');
                                            }
                                        } else {
                                            toast.warning('No task selected.');
                                        }
                                    }}
                                    style={{ marginRight: '10px', backgroundColor: 'red', color: 'white' }}
                                >
                                    Delete Task
                                </button>

                            </div>
                        </div>
                        {/* Section 4: Translation */}
                        <div className={styles.card} style={{ width: '100%' }}>
                            <h3>Translate</h3>
                            <label htmlFor="translate-name"><strong>Name:</strong></label>
                            <input
                                id="translate-name"
                                type="text"
                                value={translateName}
                                onChange={(e) => setTranslateName(e.target.value)}
                                placeholder="Enter name"
                                style={{ width: '90%', padding: '8px', marginTop: '10px' }}
                            />
                            <label htmlFor="translate-content"><strong>Content:</strong></label>
                            <textarea
                                id="translate-content"
                                value={translateContent}
                                onChange={(e) => setTranslateContent(e.target.value)}
                                rows={10}
                                cols={50}
                                placeholder="Enter content to translate"
                                style={{ width: '90%', padding: '8px', marginTop: '10px' }}
                            />
                            <div style={{ display: 'flex', justifyContent: 'space-between', marginTop: '10px' }}>
                                <button onClick={handleTranslate} style={{ marginRight: '10px' }}>
                                    Translate
                                </button>
                                <button onClick={handleRetrieveTranslation} style={{ marginRight: '10px' }}>
                                    Retrieve
                                </button>
                                {/* Add the Update Button here */}
                                <button onClick={handleUpdateTranslation} style={{ marginRight: '10px' }}>
                                    Update
                                </button>
                            </div>
                            <select
                                value={selectedTranslatedName}
                                onChange={(e) => setSelectedTranslatedName(e.target.value)}
                                style={{ width: '90%', padding: '8px', marginTop: '10px' }}
                            >
                                <option value="">Select a translated name</option>
                                {translatedNames.map((name) => (
                                    <option key={name} value={name}>
                                        {name}
                                    </option>
                                ))}
                            </select>
                        </div>

                    </div>
                </>
            )}

            {/* Modal for Entering Task */}
            {isModalOpen && (
                <div className={styles.modalOverlay}>
                    <div className={styles.modalContent}>
                        <h2>Enter Task</h2>
                        <input
                            type="text"
                            value={manualTaskInput}
                            onChange={(e) => setManualTaskInput(e.target.value)}
                            placeholder="Enter task"
                            style={{ padding: '8px', width: '100%', marginBottom: '10px' }}
                        />
                        <button onClick={handleModalSubmit} style={{ marginRight: '10px' }}>
                            Submit
                        </button>
                        <button onClick={() => setIsModalOpen(false)}>Cancel</button>
                    </div>
                </div>
            )}
        </div>
    );

};

export default ConvertPrompt;
