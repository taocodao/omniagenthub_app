import { useState, useEffect, useCallback } from 'react';
import { ethers } from 'ethers';
import { TRANSACTION_FEE_RATE, PLATFORM_NAME, ACTIVE_CHAIN, ACCOUNT_FACTORY_ADDRESS, WEBAI_TOKEN_ADDRESS } from "../constants/constants";
import { polygonAmoy, polygon, Chain } from "thirdweb/chains";
import { client } from "../util/client";
import HashUtil from '../util/hashToFixedDigits';
import { useSharedContext } from '../context/SharedContext';
import { toast } from 'react-toastify';

// Define the minimal ERC-20 ABI
const erc20Abi = [
    "function balanceOf(address owner) view returns (uint256)",
    "function decimals() view returns (uint8)",
    "function symbol() view returns (string)",
    "function transfer(address to, uint256 amount) returns (bool)",
];

export function usePayment() {
    const [isPaymentProcessing, setIsPaymentProcessing] = useState(false);
    const { setBalanceData } = useSharedContext(); // Use shared context

    const chainMap: { [key: string]: Chain } = {
        "polygon-amoy-testnet": polygonAmoy,
        "polygon": polygon,
    };
    const activeChain: Chain = chainMap[ACTIVE_CHAIN];

    // Helper function to get signer
    const getSigner = () => {
        if (typeof window !== 'undefined' && window.ethereum) {
            const provider = new ethers.providers.Web3Provider(window.ethereum);
            return provider.getSigner();
        }
        return null;
    };

    const getAccountAddressByUsername = async (username: string): Promise<string | null> => {
        try {
            const response = await fetch('/api/get_address_by_username', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ username }),
            });

            const data = await response.json();
            if (response.ok) {
                return data.accountAddress;
            } else {
                console.error("Error fetching address:", data.error);
                return null;
            }
        } catch (error) {
            console.error("Error fetching account address:", error);
            return null;
        }
    };

    // Function to send WEBAI tokens
    const sendFunds = async (receiverUsername: string, sendAmount: number): Promise<boolean> => {
        try {
            const receiverWalletAddress = await getAccountAddressByUsername(receiverUsername);

            if (!receiverWalletAddress) {
                console.error("Receiver username does not exist:", receiverUsername);
                toast.error("Receiver username does not exist.");
                return false;
            }
            const toAddress = receiverWalletAddress as `0x${string}`;

            const signer = getSigner();
            if (!signer) {
                console.error("No signer available. Make sure wallet is connected.");
                toast.error("Wallet not connected.");
                return false;
            }

            const erc20Contract = new ethers.Contract(WEBAI_TOKEN_ADDRESS, erc20Abi, signer);
            const decimals = await erc20Contract.decimals();
            const amountInWei = ethers.utils.parseUnits(sendAmount.toString(), decimals);

            const tx = await erc20Contract.transfer(toAddress, amountInWei);
            await tx.wait(); // Wait for transaction confirmation

            toast.success(`Successfully sent ${sendAmount} WEBAI to ${receiverUsername}.`);
            return true;
        } catch (error) {
            console.error("Error sending funds to", receiverUsername, ":", error);
            toast.error(`Failed to send WEBAI to ${receiverUsername}.`);
            return false;
        }
    };

    // Function to send WEBAI tokens as transaction fee to PLATFORM_NAME
    const sendTransactionFee = async (transactionFee: number): Promise<boolean> => {
        try {
            const signer = getSigner();
            if (!signer) {
                console.error("No signer available. Make sure wallet is connected.");
                toast.error("Wallet not connected.");
                return false;
            }

            const erc20Contract = new ethers.Contract(WEBAI_TOKEN_ADDRESS, erc20Abi, signer);
            const decimals = await erc20Contract.decimals();
            const amountInWei = ethers.utils.parseUnits(transactionFee.toString(), decimals);

            const tx = await erc20Contract.transfer(PLATFORM_NAME, amountInWei);
            await tx.wait(); // Wait for transaction confirmation

            toast.success(`Transaction fee of ${transactionFee} WEBAI sent to ${PLATFORM_NAME}.`);
            return true;
        } catch (error) {
            console.error("Error sending transaction fee:", error);
            toast.error("Failed to send transaction fee.");
            return false;
        }
    };

    const payByCrypto = async (userAddress: string, user: string, sendAmount: number): Promise<boolean> => {
        try {
            setIsPaymentProcessing(true);

            // Initialize provider
            if (typeof window === 'undefined' || !window.ethereum) {
                console.error("Ethereum provider not found.");
                toast.error("Ethereum provider not found.");
                setIsPaymentProcessing(false);
                return false;
            }

            const provider = new ethers.providers.Web3Provider(window.ethereum);
            const signer = provider.getSigner();

            /* Check native token (MATIC) balance for gas fees
            const nativeBalance = await provider.getBalance(userAddress);
            const formattedNativeBalance = ethers.utils.formatEther(nativeBalance);

            const requiredGas = 0.01; // Approximate gas fee in MATIC, adjust as needed

            if (parseFloat(formattedNativeBalance) < requiredGas) {
                console.error("Insufficient MATIC balance for gas fees.");
                toast.error("Insufficient MATIC balance for gas fees.");
                setIsPaymentProcessing(false);
                return false;
            }*/

            // Calculate transaction fee in WEBAI
            const transactionFee = sendAmount * TRANSACTION_FEE_RATE;

            // Send WEBAI tokens to user
            const sendSuccess = await sendFunds(user, sendAmount);
            if (!sendSuccess) {
                setIsPaymentProcessing(false);
                return false;
            }

            // Send transaction fee in WEBAI to PLATFORM_NAME
            const feeSuccess = await sendTransactionFee(transactionFee);
            if (!feeSuccess) {
                setIsPaymentProcessing(false);
                return false;
            }

            // Update the WEBAI token balance after sending funds and fees
            const erc20Contract = new ethers.Contract(WEBAI_TOKEN_ADDRESS, erc20Abi, provider);
            const updatedBalance = await erc20Contract.balanceOf(userAddress);
            const decimals = await erc20Contract.decimals();
            const formattedUpdatedBalance = ethers.utils.formatUnits(updatedBalance, decimals);
            setBalanceData(parseFloat(formattedUpdatedBalance).toFixed(3));

            setIsPaymentProcessing(false);
            return true;
        } catch (error) {
            console.error("Error during payment:", error);
            toast.error("An unexpected error occurred during payment.");
            setIsPaymentProcessing(false);
            return false;
        }
    };

    const process_payment = async (userAddress: string, price: number, user: string): Promise<boolean> => {
        try {
            // Hash the user address
            const userKey = HashUtil.hashTo(userAddress || '');

            // Call backend API to use free chats
            const response = await fetch('/api/useFreeChats', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ userKey: userKey, price }),
            });

            const data = await response.json();

            if (data.success) {
                // Free chats used successfully
                window.dispatchEvent(new CustomEvent('refreshFreeChats'));
                toast.success("Free chats used successfully.");
                return true;
            } else if (data.remainingPrice) {
                // Insufficient free chats, proceed with WEBAI payment
                const paymentResult = await payByCrypto(userAddress, user, data.remainingPrice);
                return paymentResult;
            } else {
                console.error('No free chats and no remaining price. Payment not processed.');
                toast.error("Payment could not be processed.");
                return false;
            }
        } catch (error) {
            console.error('Error during process_payment:', error);
            toast.error("An error occurred during payment processing.");
            return false;
        }
    };

    return { process_payment, isPaymentProcessing };
}
